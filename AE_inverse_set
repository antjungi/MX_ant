    print(f"    used max_bodies     : {max_bodies}")
    print(f"    used max_body_len   : {max_body_len}")

    dataset = BodySetDataset(
        npy_files=all_npy,
        sparam_db=sparam_db,
        freqs=freqs_sel,
        sparam_db_full=sparam_db_full,
        freqs_full=freqs_full,
        freq_idx=freq_idx,
        interp_matrix=interp_matrix,
        type_ids=type_ids,
        type_names=type_names,
        max_bodies=max_bodies,
        max_body_len=max_body_len,
    )

    return dataset, type_ids, type_names


def make_stratified_split(cfg, dataset, type_ids, type_names):
    rng = random.Random(cfg.seed)

    train_idx = []
    val_idx = []
    val_idx_per_type = {}

    for ti in range(len(type_names)):
        idx_t = [i for i in range(len(dataset)) if int(type_ids[i]) == ti]
        rng.shuffle(idx_t)

        n_val = max(1, int(len(idx_t) * cfg.val_ratio))
        val_idx_per_type[ti] = idx_t[:n_val]
        val_idx.extend(idx_t[:n_val])
        train_idx.extend(idx_t[n_val:])

    rng.shuffle(train_idx)
    rng.shuffle(val_idx)

    msg = ", ".join(
        f"{type_names[ti]}:{int((type_ids == ti).sum()) - len(val_idx_per_type[ti])}/{len(val_idx_per_type[ti])}"
        for ti in range(len(type_names))
    )

    print(f"  train={len(train_idx)} val={len(val_idx)}")
    print(f"  per-type train/val: {msg}")

    return train_idx, val_idx, val_idx_per_type


