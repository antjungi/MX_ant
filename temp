def load_multitype_return3_data(cfg, script_dir, verbose=True):
    n_types = len(cfg.npy_dirs)

    if n_types != len(cfg.sparam_globs):
        raise ValueError(
            f"npy_dirs({n_types})와 sparam_globs({len(cfg.sparam_globs)}) 개수가 다름"
        )

    type_names = (
        tuple(cfg.type_names)
        if len(cfg.type_names) == n_types
        else tuple(f"type{i + 1}" for i in range(n_types))
    )

    n_samples_per_type = (
        tuple(cfg.n_samples_per_type)
        if len(cfg.n_samples_per_type) == n_types
        else tuple([0] * n_types)
    )

    print(f"  Types ({n_types}): {list(type_names)}")
    print(f"  n_samples per type: {list(n_samples_per_type)} (0=all)")

    all_npy_files = []
    all_sparam_chunks = []
    all_type_ids = []

    sparam_names_ref = None

    for ti in range(n_types):
        npy_dir = cfg.npy_dirs[ti]
        sp_glob = cfg.sparam_globs[ti]
        tname = type_names[ti]
        n_pick = int(n_samples_per_type[ti])

        npy_dir_abs = npy_dir if os.path.isabs(npy_dir) else os.path.join(script_dir, npy_dir)
        sp_glob_abs = sp_glob if os.path.isabs(sp_glob) else os.path.join(script_dir, sp_glob)

        print(f"  · [{tname}] dir={npy_dir_abs}")
        print(f"    sparam_glob={sp_glob_abs}")

        npy_list = sorted(glob.glob(os.path.join(npy_dir_abs, "*_tokens.npy")))

        if not npy_list:
            raise FileNotFoundError(f"[{tname}] npy 없음: {npy_dir_abs}")

        sp_files = sorted(glob.glob(sp_glob_abs))

        if not sp_files:
            raise FileNotFoundError(f"[{tname}] S-param 없음: {sp_glob_abs}")

        sp_arr, sp_names = load_sparam_data(
            sp_files,
            cfg.n_freq,
            expected_cols=sparam_names_ref,
            verbose=verbose,
        )

        if sparam_names_ref is None:
            sparam_names_ref = sp_names

        n_match = min(len(npy_list), sp_arr.shape[0])

        if len(npy_list) != sp_arr.shape[0]:
            print(
                f"    ⚠ token/S-param 개수 다름: token={len(npy_list)}, "
                f"sparam={sp_arr.shape[0]} → 앞 {n_match}개만 사용"
            )

        npy_list = npy_list[:n_match]
        sp_arr = sp_arr[:n_match]

        if n_pick > 0 and n_pick < n_match:
            mode = (cfg.sample_mode or "random").lower()

            if mode == "sequential":
                pick_idx = list(range(n_pick))
            else:
                rng_pick = random.Random(cfg.seed + ti)
                pick_idx = sorted(rng_pick.sample(range(n_match), n_pick))

            npy_list = [npy_list[i] for i in pick_idx]
            sp_arr = sp_arr[pick_idx]

            print(f"    [{tname}] {mode} 선택 → {n_pick}개")
        else:
            print(f"    [{tname}] 전체 {n_match}개 사용")

        all_npy_files.extend(npy_list)
        all_sparam_chunks.append(sp_arr)
        all_type_ids.extend([ti] * len(npy_list))

    sparam_all = np.concatenate(all_sparam_chunks, axis=0)
    npy_files = all_npy_files
    type_ids_arr = np.array(all_type_ids, dtype=np.int64)

    # ★ FIX 1/2: 여기서 반드시 S11/S22/S33만 남긴다.
    sparam_all, sparam_names = filter_return3_sparams(
        sparam_all,
        sparam_names_ref,
        return_pairs=RETURN_PORT_PAIRS,
        verbose=True,
    )

    n_use = len(npy_files)
    n_sparam = sparam_all.shape[2]

    print(f"  ✓ Total combined: {n_use} samples, Return-3 S-param shape {sparam_all.shape}")
    print(f"  ✓ n_sparam for MLP = {n_sparam}")

    sparam_mean = sparam_all.mean(axis=(0, 1))
    sparam_std = sparam_all.std(axis=(0, 1))

    max_len = min(
        max(np.load(f).shape[0] for f in npy_files) + 4,
        cfg.max_len_cap,
    )

    dataset = JointDataset(
        npy_files,
        max_len,
        sparam_all,
        sparam_mean,
        sparam_std,
        type_ids=type_ids_arr,
        type_names=type_names,
    )

    return (
        dataset,
        npy_files,
        type_ids_arr,
        type_names,
        sparam_all,
        sparam_names,
        sparam_mean,
        sparam_std,
        n_sparam,
        max_len,
    )


