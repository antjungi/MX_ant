def train(cfg):
    print("\n  [CODE VERSION] Return-3 fixed — S11/S22/S33 only + aux logging fixed\n")

    apply_preset(cfg)
    set_seed(cfg.seed)

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    script_dir = os.path.dirname(os.path.abspath(__file__))

    VERB = (cfg.log_verbosity or "simple").lower()
    if VERB not in ("simple", "verbose"):
        VERB = "simple"

    section("DeepCAD AE + Return-3 S-param training")

    print(f"  Python : {_sys.version.split()[0]}")
    print(f"  Torch  : {torch.__version__}")
    print(f"  Device : {device}" + (f" ({torch.cuda.get_device_name(0)})" if device.type == "cuda" else ""))
    print(f"  Seed   : {cfg.seed} | Preset: {cfg.preset} | Log: {VERB}")
    print(f"  MPL    : backend={_MPL_BACKEND}")

    print(
        f"  Model  : d_model={cfg.d_model}, d_param={cfg.d_param}, latent={cfg.latent}, "
        f"n_enc={cfg.n_enc}, n_dec={cfg.n_dec}, n_pool={cfg.n_pool}, Fourier={cfg.n_freq_bands}"
    )

    section("LOAD DATA")

    (
        dataset,
        npy_files,
        type_ids_arr,
        type_names,
        sparam_all,
        sparam_names,
        sparam_mean,
        sparam_std,
        n_sparam,
        max_len,
    ) = load_multitype_return3_data(cfg, script_dir, verbose=(VERB == "verbose"))

    if VERB == "verbose":
        diagnose_data(npy_files, dataset, sparam_all, sparam_names, cfg)

    n_types = len(type_names)
    n_use = len(dataset)

    rng = random.Random(cfg.seed)

    train_idx = []
    val_idx = []
    val_idx_per_type = {}

    for ti in range(n_types):
        idx_t = [i for i in range(n_use) if int(type_ids_arr[i]) == ti]

        rng.shuffle(idx_t)

        n_val_t = max(1, int(len(idx_t) * cfg.val_ratio))

        val_idx_per_type[ti] = idx_t[:n_val_t]
        val_idx.extend(idx_t[:n_val_t])
        train_idx.extend(idx_t[n_val_t:])

    rng.shuffle(train_idx)
    rng.shuffle(val_idx)

    train_set = AugmentedSubset(dataset, train_idx, augment=False)
    val_set = AugmentedSubset(dataset, val_idx, augment=False)

    train_loader = DataLoader(
        train_set,
        batch_size=cfg.batch_size,
        shuffle=True,
        num_workers=0,
    )

    val_loader = DataLoader(
        val_set,
        batch_size=cfg.batch_size,
        shuffle=False,
        num_workers=0,
    )

    section("SPLIT")
    per = ", ".join(
        f"{type_names[ti]}:{int((type_ids_arr == ti).sum()) - len(val_idx_per_type[ti])}/{len(val_idx_per_type[ti])}"
        for ti in range(n_types)
    )

    print(f"  train={len(train_set)} val={len(val_set)}")
    print(f"  per-type train/val: {per}")

    section("BUILD MODEL")

    ae = DeepCADBaselineAE(
        max_len=max_len,
        d_model=cfg.d_model,
        d_param=cfg.d_param,
        nhead=cfg.nhead,
        n_enc=cfg.n_enc,
        n_dec=cfg.n_dec,
        d_ff=cfg.d_ff,
        latent=cfg.latent,
        mem_tokens=cfg.mem_tokens,
        dropout=cfg.dropout,
        n_pool=cfg.n_pool,
        n_freq_bands=cfg.n_freq_bands,
        aux_numeric=cfg.aux_numeric,
        aux_hidden_mult=cfg.aux_hidden_mult,
    ).to(device)

    # ★ n_sparam은 filter 이후 6이어야 함
    if n_sparam != 6:
        print(f"  ⚠ n_sparam={n_sparam}, expected=6. 컬럼 파싱을 확인하세요.")

    mlp = SparamMLP(
        latent_dim=cfg.latent,
        n_freq=cfg.n_freq,
        n_sparam=n_sparam,
        hidden_mult=cfg.mlp_hidden_mult,
        dropout=cfg.mlp_dropout,
        n_types=n_types,
        type_emb_dim=cfg.type_emb_dim,
    ).to(device)

    diagnose_model(ae, mlp, cfg)

    section("JOINT TRAINING — AE + Return-3 S-param")

    print(f"  epochs={cfg.epochs}, bs={cfg.batch_size}, warmup={cfg.warmup}, wd={cfg.weight_decay}")
    print(f"  lr_ae={cfg.lr_ae:.2e}, lr_mlp={cfg.lr_mlp:.2e}")
    print("  S-param target = S11/S22/S33 only")
    print(
        f"  loss = cmd({cfg.w_cmd}) + prm({cfg.w_prm}) + "
        f"aux({cfg.w_aux_numeric}) + return3({cfg.w_sparam}) + "
        f"var({cfg.w_var}) + cov({cfg.w_cov})"
    )

    opt = torch.optim.AdamW(
        [
            {"params": list(ae.parameters()), "lr": cfg.lr_ae},
            {"params": list(mlp.parameters()), "lr": cfg.lr_mlp},
        ],
        weight_decay=cfg.weight_decay,
        betas=(0.9, 0.98),
    )

    def lr_sched(ep):
        if ep < cfg.warmup:
            return (ep + 1) / max(1, cfg.warmup)
        return 0.5 * (1 + math.cos(math.pi * (ep - cfg.warmup) / max(1, cfg.epochs - cfg.warmup)))

    sch = torch.optim.lr_scheduler.LambdaLR(opt, lr_sched)

    tr_total = []
    va_total = []
    tr_sp = []
    va_sp = []
    tr_aux = []
    va_aux = []
    tr_var = []
    va_var = []
    tr_cov = []
    va_cov = []
    tr_zstd = []

    best = float("inf")
    best_ae_state = None
    best_mlp_state = None

    print(
        f"\n  {'ep':>4s} | "
