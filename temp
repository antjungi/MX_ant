    print("\n[Optimization Settings]")
    print(f"  retries              : {getattr(args, 'max_target_retries', '')}")
    print(f"  n_starts             : {getattr(args, 'n_starts', '')}")
    print(f"  n_iters              : {getattr(args, 'n_iters', '')}")
    print(f"  lr                   : {getattr(args, 'lr', '')}")
    print(f"  cosine_lr            : {getattr(args, 'cosine_lr', '')}")
    print(f"  lr_min_ratio         : {getattr(args, 'lr_min_ratio', '')}")
    print(f"  in_band_weight       : {getattr(args, 'in_band_weight', '')}")
    print(f"  out_band_weight      : {getattr(args, 'out_band_weight', '')}")
    print(f"  z_prior_weight       : {getattr(args, 'z_prior_weight', '')}")
    print(f"  z_prior_weight_end   : {getattr(args, 'z_prior_weight_end', '')}")
    print(f"  early_stop_patience  : {getattr(args, 'early_stop_patience', '')}")
    print(f"  restart_patience     : {getattr(args, 'restart_patience', '')}")
    print(f"  restart_frac         : {getattr(args, 'restart_frac', '')}")
    print(f"  restart_noise        : {getattr(args, 'restart_noise', '')}")
    print(f"  max_restarts         : {getattr(args, 'max_restarts', '')}")
    print(f"  coverage_req_ports   : {getattr(args, 'coverage_required_ports', '')}")
    print(f"  port_diversity_weight: {getattr(args, 'coverage_port_diversity_weight', '')}")


def _vector_xyz(v):
    if hasattr(v, "x") and hasattr(v, "y") and hasattr(v, "z"):
        return [float(v.x), float(v.y), float(v.z)]
    return [float(v[0]), float(v[1]), float(v[2])]


def _set_equal_3d_axes(ax, pts):
    mins = np.min(pts, axis=0)
    maxs = np.max(pts, axis=0)
    center = (mins + maxs) * 0.5
    radius = max(float(np.max(maxs - mins)) * 0.55, 1.0)

    ax.set_xlim(center[0] - radius, center[0] + radius)
    ax.set_ylim(center[1] - radius, center[1] + radius)
    ax.set_zlim(center[2] - radius, center[2] + radius)


def visualize_step_file(step_path, save_path=None):
    try:
        import cadquery as cq

        wp = cq.importers.importStep(step_path)
        shape = wp.val() if hasattr(wp, "val") else wp
    except Exception as exc:
        print(f"  step preview skipped: {type(exc).__name__}: {exc}")
        return False

    try:
        solids = list(shape.Solids())
    except Exception:
        solids = []

    if not solids:
        solids = [shape]

    body_faces = []
    all_pts = []

    for solid in solids:
        try:
            vertices, triangles = solid.tessellate(0.5)
        except Exception:
            continue

        pts = np.asarray([_vector_xyz(v) for v in vertices], dtype=np.float32)

        faces = [
            pts[list(tri)]
            for tri in triangles
            if len(tri) == 3 and max(tri) < len(pts)
        ]

        if pts.size and faces:
            body_faces.append(faces)
            all_pts.append(pts)

    if not all_pts or not body_faces:
        print("  step preview skipped: empty tessellation")
        return False

    pts_all = np.concatenate(all_pts, axis=0)

    fig = stp.plt.figure(figsize=(13, 6), facecolor="white")
    fig.suptitle(
        f"STEP preview - {os.path.basename(step_path)}",
        fontsize=11,
        color="#222",
    )

    views = [
        ("ISO", 25, -55),
        ("TOP", 89.9, -90),
    ]

    colors = (
        "#30427A",
        "#8F5B3F",
        "#3F6B54",
        "#6D5A7D",
        "#5A5A5A",
        "#8C8339",
        "#30427A",
        "#8F5B3F",
        "#88AFC2",
        "#A7A7A7",
    )

    for i, (title, elev, azim) in enumerate(views, start=1):
        ax = fig.add_subplot(1, 2, i, projection="3d")

        for body_idx, faces in enumerate(body_faces):
            mesh = Poly3DCollection(
                faces,
                facecolor=colors[body_idx % len(colors)],
                edgecolor="#2C3438",
                linewidths=0.08,
                alpha=0.88,
            )
            ax.add_collection3d(mesh)

        _set_equal_3d_axes(ax, pts_all)

        ax.view_init(elev=elev, azim=azim)
        ax.set_title(
            f"{title} ({len(body_faces)} solids)",
            fontsize=10,
            fontweight="normal",
        )
        ax.set_xlabel("X [mm]")
        ax.set_ylabel("Y [mm]")
        ax.set_zlabel("Z [mm]")
        ax.grid(True, alpha=0.15)

    stp.plt.tight_layout(rect=[0, 0, 1, 0.94])

    if save_path:
        try:
            fig.savefig(save_path, dpi=150, bbox_inches="tight")
        except Exception as exc:
            print(f"  step preview save skipped: {type(exc).__name__}: {exc}")

    return True


def show_result_windows():
    if not SHOW_RESULT_WINDOWS:
        stp.plt.close("all")
        return

    n_figs = len(stp.plt.get_fignums())

    if n_figs <= 0:
        return

    print("\n[Show]")
    print(f"  figures   : {n_figs}")

    try:
        signal.signal(signal.SIGINT, signal.SIG_DFL)
    except Exception:
        pass

    try:
        stp.plt.show()
    except KeyboardInterrupt:
        print("\n[Ctrl+C] closing figures and exiting")
    except Exception as exc:
        print(f"  plt.show skipped: {type(exc).__name__}: {exc}")
    finally:
        try:
            stp.plt.close("all")
        except Exception:
            pass


def main():
    t0 = time.time()

    warnings.filterwarnings("ignore", category=FutureWarning)

    script_dir = os.path.dirname(os.path.abspath(__file__))
    os.chdir(script_dir)

    configure_plot_backend()
    stp.set_log_verbosity("compact")

    args = build_demo_args()
    args.ckpt = tools.resolve_ckpt_path(args.ckpt, script_dir)

    run_tag = datetime.now().strftime("%Y%m%d_%H%M%S")
    out_dir = os.path.join(script_dir, RESULT_ROOT, f"design_{run_tag}")
    os.makedirs(out_dir, exist_ok=True)

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

    print_target(args)
    print_optimization_settings(args)

    print("\n[Load]")

    with contextlib.redirect_stdout(io.StringIO()):
        _cfg, dataset, ae, mlp = tools.load_dataset_and_model(
            args,
            script_dir,
            device,
        )

    print(f"  checkpoint : {args.ckpt}")
    print(f"  samples    : {len(dataset)}")
    print(f"  device     : {device}")

    print("\n[Optimize]")

    validation_ctx = tools.build_validation_context(ae, dataset, device)

    row = inverse.run_one_coverage(
        args=args,
        dataset=dataset,
        ae=ae,
        mlp=mlp,
        device=device,
        target_id=1,
        target=args.coverage_freqs_ghz,
        out_dir=out_dir,
        validation_ctx=validation_ctx,
    )

    summary_csv = os.path.join(out_dir, "inverse_design_summary.csv")
    inverse.append_v2_summary(summary_csv, row)

    step_path = os.path.join(out_dir, "inverse_target_001.step")
    step_preview_path = os.path.join(out_dir, "inverse_target_001_step_preview.png")

    step_preview_ok = False

    if SHOW_STEP_PREVIEW and os.path.exists(step_path):
        step_preview_ok = visualize_step_file(step_path, step_preview_path)

    print("\n[Result]")
    print(f"  overall   : {row.get('overall_status', '')}")
    print(f"  structure : {row.get('structure_status', '')}")
    print(f"  spec      : {row.get('spec_status', '')}")
    print(f"  ports     : {row.get('coverage_ports', '')}")
    print(f"  distinct  : {row.get('coverage_distinct_ports', '')}/{args.coverage_required_ports}")
    print(f"  worst dB  : {row.get('coverage_worst_db', '')}")

    if os.path.exists(step_path):
        print(f"  step      : {step_path}")

    if step_preview_ok:
        print(f"  step view : {step_preview_path}")

    print(f"  summary   : {summary_csv}")
    print(f"  output    : {out_dir}")

    elapsed = time.time() - t0
    print("\n[Elapsed]")
    print(f"  before figure display : {format_elapsed(elapsed)}")
    print(f"  seconds               : {elapsed:.1f}")

    show_result_windows()


if __name__ == "__main__":
    main()
