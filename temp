def render_3d_real(ax, sketches: list) -> list:
    all_pts=[]
    for idx,sk in enumerate(sketches):
        color=PAL[idx%len(PAL)]
        normal=np.array(sk["normal"]); extent=sk["extent"]
        for loop_pts in sk["loops_3d"]:
            if len(loop_pts)<2: continue
            bot=[np.array(p) for p in loop_pts]
            top=[p + normal*extent for p in bot]
            all_pts.extend([p.tolist() for p in bot])
            all_pts.extend([p.tolist() for p in top])

            def outline(pts, lw=1.6, la=0.95):
                xs=[p[0] for p in pts]; ys=[p[1] for p in pts]; zs=[p[2] for p in pts]
                ax.plot(xs+[xs[0]], ys+[ys[0]], zs+[zs[0]],
                        color=color, lw=lw, alpha=la,
                        solid_capstyle="round", solid_joinstyle="round")
            outline(bot, lw=1.8, la=0.95)
            outline(top, lw=1.2, la=0.75)

            # 수직 연결선 (세로 edge) — 좀 더 진하게, 더 촘촘히
            step=max(1, len(bot)//12)
            for i in range(0,len(bot),step):
                b,t=bot[i],top[i]
                ax.plot([b[0],t[0]],[b[1],t[1]],[b[2],t[2]],
                        color=color, lw=0.8, alpha=0.50)
            if len(bot)>=3:
                bl=[b.tolist() for b in bot]; tl=[t.tolist() for t in top]
                # 바닥/윗면 — 내부가 보이도록 alpha 상향
                for face,a in [(bl,0.35),(tl,0.40)]:
                    pf=Poly3DCollection([face], alpha=a)
                    pf.set_facecolor(color); pf.set_edgecolor("none")
                    ax.add_collection3d(pf)
                # 옆면 — 샘플링 촘촘히 + alpha 상향
                ss=max(1, len(bot)//20)
                for i in range(0,len(bot),ss):
                    j=(i+ss)%len(bot)
                    ps=Poly3DCollection(
                        [[bot[i].tolist(),bot[j].tolist(),top[j].tolist(),top[i].tolist()]],
                        alpha=0.22)
                    ps.set_facecolor(color); ps.set_edgecolor("none")
                    ax.add_collection3d(ps)
    return all_pts


def render_3d_normalized(ax, sketches: list) -> list:
    all_pts=[]
    for idx,sk in enumerate(sketches):
        color=PAL[idx%len(PAL)]
        px,py,pz=sk["pos"]; size=sk["scale"]*2.2; e1=sk["e1"]*1.8
        ox=(px-0.5)*2; oy=(py-0.5)*2; oz=pz*2
        for loop_pts in sk["loops_2d"]:
            if len(loop_pts)<2: continue
            bot = [((x-0.5)*size+ox, (y-0.5)*size+oy, oz) for x,y in loop_pts]
            top = [(b[0],b[1],b[2]+e1) for b in bot]
            all_pts.extend(bot); all_pts.extend(top)

            def outline(pts, lw=1.6, la=0.95):
                xs=[p[0] for p in pts]; ys=[p[1] for p in pts]; zs=[p[2] for p in pts]
                ax.plot(xs+[xs[0]], ys+[ys[0]], zs+[zs[0]],
                        color=color, lw=lw, alpha=la,
                        solid_capstyle="round", solid_joinstyle="round")
            outline(bot, lw=1.8, la=0.95)
            outline(top, lw=1.2, la=0.75)
            step=max(1, len(bot)//12)
            for i in range(0,len(bot),step):
                b,t=bot[i],top[i]
                ax.plot([b[0],t[0]],[b[1],t[1]],[b[2],t[2]],
                        color=color, lw=0.8, alpha=0.50)
            if len(bot)>=3:
                for face,a in [(bot,0.35),(top,0.40)]:
                    pf=Poly3DCollection([face], alpha=a)
                    pf.set_facecolor(color); pf.set_edgecolor("none")
                    ax.add_collection3d(pf)
                ss=max(1, len(bot)//20)
                for i in range(0,len(bot),ss):
                    j=(i+ss)%len(bot)
                    ps=Poly3DCollection([[bot[i],bot[j],top[j],top[i]]], alpha=0.22)
                    ps.set_facecolor(color); ps.set_edgecolor("none")
                    ax.add_collection3d(ps)
    return all_pts


def _equal_axes(ax):
    """3축의 범위를 같은 길이로 맞추고, box_aspect를 1:1:1로 강제한다.
    box_aspect 없이는 matplotlib 3D가 figure aspect에 맞춰 축을 stretching해서
    '사각형이 직각이 아니게' 보이고 top view도 왜곡됨."""
    lims = np.array([ax.get_xlim3d(), ax.get_ylim3d(), ax.get_zlim3d()])
    c = lims.mean(axis=1)
    r = max((lims[:, 1] - lims[:, 0]).max() / 2, 0.3)
    ax.set_xlim3d(c[0] - r, c[0] + r)
    ax.set_ylim3d(c[1] - r, c[1] + r)
    ax.set_zlim3d(c[2] - r, c[2] + r)
    # ★ 핵심: box_aspect 1:1:1로 고정. 안 하면 축이 늘어나서 bird view에서 왜곡.
    try:
        ax.set_box_aspect((1.0, 1.0, 1.0))
    except Exception:
        pass   # 아주 오래된 matplotlib에선 없음


def _style(ax, title):
    """그림 2/4/8/9 panel 스타일 — 논문 친화적.
    그림 뒷배경 (pane / grid / axis line / tick / label) 전부 제거.
    geometry body 와 title 만 표시."""
    ax.set_facecolor("white")
    # 3축 pane 투명화
    for pane in (ax.xaxis.pane, ax.yaxis.pane, ax.zaxis.pane):
        pane.fill = False
        pane.set_edgecolor((1, 1, 1, 0))
    # 그리드 제거
    ax.grid(False)
    # ★ 축 라인 투명화
    for axis in (ax.xaxis, ax.yaxis, ax.zaxis):
        axis.line.set_color((1, 1, 1, 0))
    # ★ 틱 제거 (tick mark + tick label 둘 다)
    ax.set_xticks([]); ax.set_yticks([]); ax.set_zticks([])
    # ★ 축 이름 제거
    ax.set_xlabel(""); ax.set_ylabel(""); ax.set_zlabel("")
    # title만 남김
    ax.set_title(title, color="#222", fontsize=9.5, fontweight="normal", pad=8)


def _set_axes_and_render(ax, sketches, use_real):
    pts=render_3d_real(ax, sketches) if use_real else render_3d_normalized(ax, sketches)
    if pts:
        arr=np.array(pts)
        pad=max((arr.max(axis=0)-arr.min(axis=0)).max()*0.08, 0.1)
        ax.set_xlim(arr[:,0].min()-pad, arr[:,0].max()+pad)
        ax.set_ylim(arr[:,1].min()-pad, arr[:,1].max()+pad)
        ax.set_zlim(arr[:,2].min()-pad, arr[:,2].max()+pad)
        _equal_axes(ax)
    else:
        ax.text2D(0.5,0.5,"기하 없음", color="#888", ha="center", va="center",
                  fontsize=12, transform=ax.transAxes)
    return pts


def show_comparison(orig_tok, recon_tok, fname, save_path,
                    json_data=None):
    """3×2: (3D View / Top View / Frame only) × (Original, Recon).
    plt.show() 호출하지 않음.
    Frame = 가장 큰 sketch (bbox 부피 기준)."""
    orig_tok=trim_after_eos(orig_tok)
    recon_tok=trim_after_eos(recon_tok)
    use_real=json_data is not None

    if use_real:
        orig_sk=json_to_real_sketches(json_data)
        dq_meta=extract_dequant_meta(json_data)
        recon_sk=tokens_to_real_sketches(recon_tok, dq_meta)
    else:
        orig_sk=tokens_to_sketches_normalized(orig_tok)
        recon_sk=tokens_to_sketches_normalized(recon_tok)

    # ── frame 식별: bbox 부피 (real coord) 또는 면적(normalized) 가장 큰 것 ──
    def _frame_only(sks):
        if not sks: return []
        loop_key = "loops_3d" if use_real else "loops_2d"
        best_idx = 0; best_score = -1.0
        for i, s in enumerate(sks):
            pts = []
            for lp in s.get(loop_key, []): pts.extend(lp)
            if not pts: continue
            arr = np.array(pts) if use_real else np.array([(p[0],p[1],0) for p in pts])
            d = arr.max(axis=0) - arr.min(axis=0)
            # extent도 가중 (real에서만 의미 있음)
            ext = s.get("extent", 1.0) if use_real else max(s.get("e1", 0.1), 0.05)
            score = float(d[0] * d[1] * max(ext, 0.05))
            if score > best_score:
                best_score = score; best_idx = i
        return [sks[best_idx]]

    orig_frame = _frame_only(orig_sk)
    recon_frame = _frame_only(recon_sk)

    if use_real:
        nl_o=sum(len(s["loops_3d"]) for s in orig_sk)
        nl_r=sum(len(s["loops_3d"]) for s in recon_sk)
    else:
        nl_o=sum(len(s["loops_2d"]) for s in orig_sk)
        nl_r=sum(len(s["loops_2d"]) for s in recon_sk)
    ne_o=len(orig_sk); ne_r=len(recon_sk)

    # ★ 3행 × 2열 레이아웃
    fig=plt.figure(figsize=(13, 18), facecolor="white")
    coord_label="real coord (mm)" if use_real else "normalized"
    fig.suptitle(f"Geometry Comparison [{coord_label}]\n{fname}",
                 fontsize=11, fontweight="normal", color="#222", y=0.985)

    views=[
        # row, col, label,                          sk source,    elev, azim
        (0, 0, "Original — 3D View",                orig_sk,     28, -55),
        (0, 1, "Reconstruction — 3D View",          recon_sk,    28, -55),
        (1, 0, "Original — Top View",               orig_sk,     89.9, -90.0),
        (1, 1, "Reconstruction — Top View",         recon_sk,    89.9, -90.0),
        (2, 0, "Original — Frame only (3D)",        orig_frame,  28, -55),
        (2, 1, "Reconstruction — Frame only (3D)",  recon_frame, 28, -55),
    ]
    for row, col, label, sk, elev, azim in views:
        ax=fig.add_subplot(3, 2, row*2+col+1, projection="3d")
        if not sk:
            ax.text2D(0.5, 0.5, "(empty)", color="#888", ha="center", va="center",
                      fontsize=11, transform=ax.transAxes)
            _style(ax, label)
            ax.view_init(elev=elev, azim=azim)
            continue
        _set_axes_and_render(ax, sk, use_real)
        # 메타 정보 라벨
        if "Frame only" in label:
            # frame의 extent / footprint 정보 표시
            if use_real:
                f = sk[0]
                pts = []
                for lp in f.get("loops_3d", []): pts.extend(lp)
                if pts:
                    arr = np.array(pts)
                    d = arr.max(0) - arr.min(0)
                    sub = f"footprint {d[0]:.1f}×{d[1]:.1f}  ·  height {f.get('extent',0):.2f} mm"
                else: sub = ""
            else:
                f = sk[0]
                sub = f"scale {f.get('scale',0):.2f}  ·  e1 {f.get('e1',0):.2f}"
            _style(ax, f"{label}\n{sub}")
        else:
            ne = ne_o if "Original" in label else ne_r
            nl = nl_o if "Original" in label else nl_r
            tok = orig_tok if "Original" in label else recon_tok
            _style(ax, f"{label}\n{ne} extrude · {nl} loop · {tok.shape[0]} token")
        ax.view_init(elev=elev, azim=azim)

    n_leg=max(ne_o, ne_r)
    if n_leg:
        fig.legend(handles=[mpatches.Patch(color=PAL[i%len(PAL)], label=f"Sketch {i+1}")
                            for i in range(n_leg)],
                   loc="lower center", ncol=min(n_leg,6),
                   facecolor="white", edgecolor="#ddd", labelcolor="#444",
                   fontsize=9, framealpha=0.95)

    plt.tight_layout(rect=[0, 0.04, 1, 0.97])
    print(f"  ✓ 비교 figure 생성: {fname}")


