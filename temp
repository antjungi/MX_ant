def _cmd_name_safe(c):
    return CMD_NAME.get(int(c), f"PAD({int(c)})" if int(c)<0 else f"?({int(c)})")


def diagnose_data(npy_files, dataset, sparam_all, sparam_names, cfg):
    section("[DIAG] Data Statistics")
    N=len(dataset.raw)
    print(f"  Samples: {N}  |  S-param shape: {sparam_all.shape}  |  max_len={dataset.max_len}")
    print(f"  S-param columns ({len(sparam_names)}): {sparam_names[:4]}{' ...' if len(sparam_names)>4 else ''}")

    # type 분포
    if hasattr(dataset, "type_ids") and len(dataset.type_names)>1:
        print(f"\n  Type distribution:")
        for ti,tn in enumerate(dataset.type_names):
            cnt=int((dataset.type_ids==ti).sum())
            print(f"    {tn:12s}: {cnt}")

    # 토큰 길이 분포
    lengths=[]
    for t in dataset.raw:
        eos=np.where(t[:,0]==EOS)[0]
        lengths.append(int(eos[0]+1) if len(eos)>0 else t.shape[0])
    lengths=np.array(lengths)
    print(f"\n  Token seq length:  min={lengths.min()}  max={lengths.max()}  "
          f"mean={lengths.mean():.1f}  median={int(np.median(lengths))}")

    # 구조 개수
    n_structs=np.array([int((t[:,0]==SOL).sum()) for t in dataset.raw])
    uniq,cnt=np.unique(n_structs, return_counts=True)
    print(f"  Structures/sample: min={n_structs.min()}  max={n_structs.max()}  mean={n_structs.mean():.2f}")
    print(f"    distribution: " + ", ".join([f"{u}개:{c}샘플" for u,c in zip(uniq,cnt)]))

    # cmd 빈도
    cnts={c:0 for c in range(N_CMD)}
    for t in dataset.raw:
        for c,k in zip(*np.unique(t[:,0][t[:,0]>=0], return_counts=True)):
            if 0<=int(c)<N_CMD: cnts[int(c)]+=int(k)
    tot=sum(cnts.values()) or 1
    print(f"\n  Cmd frequency:")
    for c in range(N_CMD):
        print(f"    {_cmd_name_safe(c):6s} {cnts[c]:8d}  ({100*cnts[c]/tot:5.1f}%)")

    # param slot 사용률
    print(f"\n  Param slot usage (cmd 별 valid ratio):")
    for c in range(N_CMD):
        slot_valid=np.zeros(N_ARGS); slot_count=0
        for t in dataset.raw:
            mask=(t[:,0]==c)
            if not mask.any(): continue
            slot_valid+=(t[mask,1:]>=0).sum(axis=0)
            slot_count+=int(mask.sum())
        if slot_count==0: continue
        ratio=slot_valid/max(slot_count,1)
        used=[i for i,r in enumerate(ratio) if r>0.01]
        if used:
            print(f"    {_cmd_name_safe(c):6s} slots used: {used}  (VALID_PAR says first {VALID_PAR.get(c,0)})")

    # S-param 통계
    print(f"\n  S-param stats (raw re/im):  "
          f"mean={sparam_all.mean():.4f}  std={sparam_all.std():.4f}  "
          f"min={sparam_all.min():.4f}  max={sparam_all.max():.4f}")


def diagnose_model(ae, mlp, cfg):
    section("[DIAG] Model Structure")
    # PMA pooling 모듈 (n_pool>=2일 때만 존재)
    pool_params = []
    if getattr(ae, "pool_queries", None) is not None:
        pool_params.append(ae.pool_queries)
    if getattr(ae, "pool_attn", None) is not None:
        pool_params += list(ae.pool_attn.parameters())
    if getattr(ae, "pool_norm", None) is not None:
        pool_params += list(ae.pool_norm.parameters())

    groups = {
        "cmd_emb":        list(ae.cmd_emb.parameters()),
        "param_embs (16)":[p for emb in ae.param_embs for p in emb.parameters()],
        "param_proj":     list(ae.param_proj.parameters()),
        "emb_norm":       list(ae.emb_norm.parameters()),
        "pos_enc":        list(ae.pos_enc.parameters()),
        "encoder (TE)":   list(ae.encoder.parameters()),
        "pool (PMA)":     pool_params,
        "to_z":           list(ae.to_z.parameters()),
        "from_z":         list(ae.from_z.parameters()),
        "decoder (TD)":   list(ae.decoder.parameters()),
        "bos":            [ae.bos],
        "cmd_head":       list(ae.cmd_head.parameters()),
        "param_head":     list(ae.param_head.parameters()),
        "param_encoder":  (list(ae.param_encoder.parameters())
                            if getattr(ae, "param_encoder", None) is not None else []),
        "combine_proj":   (list(ae.combine_proj.parameters())
                            if getattr(ae, "combine_proj", None) is not None else []),
    }
    # ★ v10a: Fourier 설정 정보 출력
    _nfb = getattr(ae, "n_freq_bands", 0)
    if _nfb > 0:
        _ppin = getattr(ae, "_param_proj_in", None)
        print(f"\n  ★ Fourier embedding: L={_nfb} bands   "
              f"per-slot extra dim = 2·L = {2*_nfb}   "
              f"total extra = 16·2L = {16*2*_nfb}")
        print(f"    param_proj input dim: {_ppin} "
              f"(= 16·d_param({ae.d_param}) + 16·2L({16*2*_nfb}))\n")
    else:
        print(f"\n  Fourier embedding: disabled (n_freq_bands=0)\n")

    print(f"  {'module':25s}  {'params':>12s}  {'trainable':>12s}  {'mean|w|':>10s}  {'std w':>10s}")
    print("  "+"-"*74)
    ae_total = 0
    for name, ps in groups.items():
        pc = sum(p.numel() for p in ps)
        tc = sum(p.numel() for p in ps if p.requires_grad)
        ae_total += pc
        if pc == 0: continue
        flat = torch.cat([p.detach().flatten().float() for p in ps])
        m = flat.abs().mean().item(); s = flat.std().item()
        print(f"  {name:25s}  {pc:12,d}  {tc:12,d}  {m:10.5f}  {s:10.5f}")
    mlp_total = sum(p.numel() for p in mlp.parameters()) if mlp is not None else 0
    print("  "+"-"*74)
    print(f"  {'AE total':25s}  {ae_total:12,d}")
    if mlp is not None:
        print(f"  {'MLP (S-param)':25s}  {mlp_total:12,d}")
        print(f"  {'GRAND TOTAL':25s}  {ae_total+mlp_total:12,d}")


@torch.no_grad()
def diagnose_reconstruction(ae, dataset, indices, device, max_samples=8):
    section("[DIAG] Reconstruction Quality")
    ae.eval()
    sel=indices[:max_samples]
    cmd_correct=cmd_total=0; nstruct_match=nstruct_tot=0
    per_sample=[]; param_abs_err=[]

    for si in sel:
        x=torch.tensor(dataset.padded[si],dtype=torch.float32).unsqueeze(0).to(device)
        # ★ v11l: combine_param 활성 시 vars 같이 사용
        v = None; tid = None
        if getattr(dataset, "vars", None) is not None and getattr(ae, "combine_param", False):
            v   = torch.tensor(dataset.vars[si], dtype=torch.float32).unsqueeze(0).to(device)
            tid = torch.tensor(int(dataset.type_ids[si]), dtype=torch.long).unsqueeze(0).to(device)
        z = ae.encode_combined(x, vars_padded=v, type_ids=tid)
        gen=ae.generate(z, max_gen_len=dataset.max_len)
        recon=trim_after_eos(gen[0].cpu().numpy().astype(np.int32))
        orig =trim_after_eos(dataset.raw[si])

        L=min(len(orig), len(recon))
        hits=0
        if L>0:
            hits=int((orig[:L,0]==recon[:L,0]).sum())
            cmd_correct+=hits; cmd_total+=L
        no=int((orig[:,0]==SOL).sum()); nr=int((recon[:,0]==SOL).sum())
        nstruct_tot+=1
        if no==nr: nstruct_match+=1

        for i in range(L):
            if orig[i,0]==recon[i,0] and orig[i,0]>=0:
                for k in range(1,17):
                    if orig[i,k]>=0 and recon[i,k]>=0:
                        param_abs_err.append(abs(int(orig[i,k])-int(recon[i,k])))
        per_sample.append((si, len(orig), len(recon), no, nr, hits, L))

    cmd_acc=cmd_correct/max(cmd_total,1)
    pa_mean=(sum(param_abs_err)/len(param_abs_err)) if param_abs_err else 0.
    print(f"  Samples evaluated:          {len(sel)}")
    print(f"  Cmd accuracy (aligned):     {cmd_correct}/{cmd_total} = {cmd_acc*100:.2f}%")
    print(f"  Struct count match:         {nstruct_match}/{nstruct_tot} = {100*nstruct_match/max(nstruct_tot,1):.1f}%")
    print(f"  Param MAE (quant 0..{QMAX}):  {pa_mean:.2f}  →  normalized {pa_mean/QMAX:.4f}")
    print(f"\n  Per-sample (idx, len_o, len_r, n_struct_o, n_struct_r, cmd_hits, L_aligned):")
    for row in per_sample:
        print(f"    {row}")


@torch.no_grad()
def diagnose_latent(z_all, sparam_all, sparam_names, ae):
    section("[DIAG] Latent Statistics")
    N,D=z_all.shape
    print(f"  Shape: ({N}, {D})")
    print(f"  Norm (per-sample ||z||):  mean={np.linalg.norm(z_all,axis=1).mean():.3f}  "
          f"std={np.linalg.norm(z_all,axis=1).std():.3f}")
    print(f"  Value range:              min={z_all.min():.3f}  max={z_all.max():.3f}  "
          f"mean={z_all.mean():.4f}  std={z_all.std():.3f}")

    # (Perceiver slot 분석 — baseline에는 없음, 생략)

    std_per_dim=z_all.std(axis=0)
    dead=int((std_per_dim<1e-3).sum())
    print(f"\n  Dead dims (std<1e-3):     {dead}/{D} ({100*dead/D:.1f}%)")

    try:
        from sklearn.decomposition import PCA
        pca=PCA(n_components=min(N-1,D)); pca.fit(z_all)
        cum=np.cumsum(pca.explained_variance_ratio_)
        for thr in [0.5,0.9,0.95,0.99]:
            if (cum>=thr).any():
                d=int(np.argmax(cum>=thr))+1
                print(f"  Intrinsic dim @ {int(thr*100)}%:   {d}")
    except Exception as e:
        print(f"  (PCA 생략: {e})")

    vals,label=_compute_s11_min_db(sparam_all, sparam_names)
    if vals is not None and N>=5:
        zm=z_all-z_all.mean(axis=0,keepdims=True); vm=vals-vals.mean()
        denom=(np.linalg.norm(zm,axis=0)*(np.linalg.norm(vm)+1e-9)+1e-9)
        corr=(zm.T@vm)/denom
        top=np.argsort(-np.abs(corr))[:10]
        print(f"\n  Top-10 latent dims correlated with {label}:")
        for i,d in enumerate(top):
            print(f"    rank{i+1:2d}  dim {int(d):4d}  r = {corr[d]:+.3f}")
        print(f"  Max |r| = {np.abs(corr).max():.3f}")


