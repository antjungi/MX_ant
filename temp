@dataclass
class CFG:
    # ── Preset ──
    preset:str="custom"             # "tiny"/"small"/"full"/"custom"

    # ── Random / training ──
    seed:int=7

    # ── Multi-type 데이터 ──
    npy_dirs:tuple=("hfss_results/step_test",)
    sparam_globs:tuple=("hfss_results/sparam/[12].*",)   # S-param CSV (학습엔 안 쓰지만 dataset 로드용)
    type_names:tuple=("typeA",)
    n_samples_per_type:tuple=(0,)   # 0 = 전체

    sample_mode:str="random"        # "random"(seed) / "sequential"(앞에서 N개)

    # ── Optimization ──
    epochs:int=200
    lr_ae:float=3e-4
    lr_mlp:float=1e-3               # (남겨둠 — preset 호환용, 실제 미사용)
    warmup:int=15
    batch_size:int=4
    weight_decay:float=1e-4; grad_clip:float=1.0; val_ratio:float=0.15

    # ── Model (baseline DeepCAD) ──
    d_model:int=256
    d_param:int=64
    nhead:int=8
    n_enc:int=4; n_dec:int=4
    d_ff:int=1024
    latent:int=256
    mem_tokens:int=16
    dropout:float=0.1
    max_len_cap:int=256

    # PMA pooling slots (>=2 → PMA, else mean pool)
    n_pool:int=12

    # Fourier feature embedding (param 토큰의 [0,1] 정규화 후 sin/cos 펼침)
    n_freq_bands:int=6

    # ── Loss weights ──
    w_cmd:float=1.0
    w_prm:float=1.0
    w_sparam:float=1.0              # S-param surrogate 학습 비중 (0이면 sparam 비활성)

    # ── ★ v11l: Param encoder branch (token z + param z → combined z) ──
    # AE token branch 는 그대로 (Transformer encoder → z_token).
    # 추가로 raw design vars 를 별도 small MLP로 → z_param.
    # 둘을 concat 후 Linear projection → z_combined (latent 차원).
    # decoder, sparam MLP 모두 z_combined 사용.
    #
    # type 별 design vars 개수가 다를 수 있어서 type별 별도 ParamEncoder 사용.
    #
    #   combine_param        : True 이면 param branch 활성. False 면 z_token 만 (= baseline).
    #   design_vars_csvs     : type 별 csv path. 형식: filename, var1, var2, ...
    #                          tuple 길이가 type 개수와 같아야 함.
    #   z_param_dim          : param branch 출력 차원 (작게 — 32~64).
    #   param_encoder_hidden : param MLP hidden 차원.
    combine_param:bool=True
    design_vars_csvs:tuple=("design_vars_type1.csv", "design_vars_type2.csv")
    z_param_dim:int=64
    param_encoder_hidden:int=128

    # ── VICReg-style latent regularization ──
    # variance penalty : 각 latent dim의 batch std 가 target 이상이도록 강제
    #                    (dead dim 살리는 효과)
    # covariance penalty: dim 간 off-diagonal cov 가 0 에 가깝도록 강제
    #                    (redundant dim 줄여 effective rank 증가)
    # 둘 다 0이면 baseline 과 동일.
    w_var:float=1.0
    w_cov:float=0.04
    vicreg_var_target:float=1.0

    # S-param MLP
    mlp_hidden_mult:float=2.0       # ★ v11h: 1→2 권장값 변경 (sparam 개선 sweet spot 확인됨)
    mlp_dropout:float=0.3

    # ── Type-aware sparam prediction ──
    # type_emb_dim > 0 이면 SparamMLP가 (z, type_id) → sparam 매핑.
    #   type_emb_dim = 0  → baseline (type 정보 무시, z만 사용) ← v11i 기본값
    #   type_emb_dim = 8  → 작은 type embedding 추가 (concat). inverse 시 자유도 제약
    # 추후 type 수 늘어나거나 unseen type 대응 필요시 TypeEncoder 클래스만 swap.
    type_emb_dim:int=0

    # ── Misc ──
    n_freq:int=401; freq_start:float=1.0; freq_end:float=5.0
    n_preview:int=2
    log_verbosity:str="simple"
    save_checkpoints:bool=False
    save_latent_npy:bool=False


