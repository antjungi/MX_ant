@torch.no_grad()
def _collect_z_and_sp(ae, dataset, indices, device, batch_size=16):
    ae.eval()

    z_list = []
    sp_list = []
    tid_list = []

    for i in range(0, len(indices), batch_size):
        bi = indices[i:i + batch_size]

        toks = torch.stack([
            torch.tensor(dataset.padded[k], dtype=torch.float32)
            for k in bi
        ]).to(device)

        sps = torch.stack([
            torch.tensor(dataset.sparam[k], dtype=torch.float32)
            for k in bi
        ]).to(device)

        tids = torch.tensor([
            int(dataset.type_ids[k])
            for k in bi
        ], dtype=torch.long).to(device)

        z_list.append(ae.encode(toks))
        sp_list.append(sps)
        tid_list.append(tids)

    return torch.cat(z_list, 0), torch.cat(sp_list, 0), torch.cat(tid_list, 0)


def diagnose_latent_health(
    ae,
    mlp,
    dataset,
    indices,
    device,
    std_dead_thr=1e-2,
    saliency_low_quantile=0.10,
):
    section("[DIAG] Latent Health")

    if mlp is None:
        print("  mlp=None → skip")
        return None

    if not indices:
        print("  indices empty → skip")
        return None

    z_t, sp_t, tid_t = _collect_z_and_sp(ae, dataset, indices, device)

    N, D = z_t.shape

    print(f"  Samples: N={N}, latent dim={D}")

    std = z_t.std(0)

    z_g = z_t.detach().clone().requires_grad_(True)

    mlp.eval()

    with torch.enable_grad():
        pred = mlp(z_g, tid_t)
        loss = F.mse_loss(pred, sp_t)
        grad = torch.autograd.grad(loss, z_g)[0]

    saliency = grad.abs().mean(0)

    s_np = std.detach().cpu().numpy()
    sal_np = saliency.detach().cpu().numpy()

    sal_thr = float(np.quantile(sal_np, saliency_low_quantile))

    dead_mask = s_np < std_dead_thr
    low_sal_mask = sal_np <= sal_thr

    sleeper_mask = dead_mask & (~low_sal_mask)
    pure_dead = dead_mask & low_sal_mask
    unused_mask = (~dead_mask) & low_sal_mask
    used_mask = (~dead_mask) & (~low_sal_mask)

    n_pd = int(pure_dead.sum())
    n_sl = int(sleeper_mask.sum())
    n_un = int(unused_mask.sum())
    n_us = int(used_mask.sum())

    print("\n  Per-dim stats:")
    print(f"    std      mean={s_np.mean():.4f}, median={np.median(s_np):.4f}, min={s_np.min():.4f}, max={s_np.max():.4f}")
    print(f"    saliency mean={sal_np.mean():.2e}, median={np.median(sal_np):.2e}, min={sal_np.min():.2e}, max={sal_np.max():.2e}")

    print(f"\n  Classification ({D} dims):")
    print(f"    pure dead : {n_pd:4d} ({100 * n_pd / D:5.1f}%)")
    print(f"    sleeper   : {n_sl:4d} ({100 * n_sl / D:5.1f}%)")
    print(f"    unused    : {n_un:4d} ({100 * n_un / D:5.1f}%)")
    print(f"    used      : {n_us:4d} ({100 * n_us / D:5.1f}%)")

    fig, ax = plt.subplots(figsize=(7, 5), facecolor="white")

    ax.scatter(s_np[used_mask], sal_np[used_mask], s=20, alpha=0.85, label=f"used ({n_us})")
    ax.scatter(s_np[unused_mask], sal_np[unused_mask], s=20, alpha=0.85, label=f"unused ({n_un})")
    ax.scatter(s_np[sleeper_mask], sal_np[sleeper_mask], s=24, alpha=0.85, marker="s", label=f"sleeper ({n_sl})")
    ax.scatter(s_np[pure_dead], sal_np[pure_dead], s=28, alpha=0.85, marker="x", label=f"pure dead ({n_pd})")

    ax.axvline(std_dead_thr, ls="--", lw=1, alpha=0.5)
    ax.axhline(sal_thr, ls="--", lw=1, alpha=0.5)

    ax.set_xscale("log")
    ax.set_yscale("log")
    ax.set_xlabel("std(z_d)")
    ax.set_ylabel("|∂L_return3 / ∂z_d|")
    ax.set_title("Latent dim health: std vs Return-3 S-param saliency")
    ax.grid(True, which="both", alpha=0.2)
    ax.legend(fontsize=9)

    plt.tight_layout()

    return {
        "std": s_np,
        "saliency": sal_np,
        "pure_dead": pure_dead,
        "sleeper": sleeper_mask,
        "unused": unused_mask,
        "used": used_mask,
    }


