def _detect_sparam_cols(header):
    ci, cn = [], []
    for i, h in enumerate(header):
        hl = str(h).strip().lower()
        if hl.startswith("re(") or hl.startswith("im("):
            ci.append(i)
            cn.append(str(h).strip())
    return ci, cn


def load_sparam_data(sparam_files, n_freq, expected_cols=None, verbose=True):
    if not sparam_files:
        raise FileNotFoundError(f"S-param 파일 비어있음: {sparam_files}")

    if pd is None:
        raise ImportError("pandas 필요. pip install pandas openpyxl")

    sparam_files = sorted(sparam_files)

    if verbose:
        print(f"  S-param 파일 {len(sparam_files)}개")

    all_s = []
    cn = expected_cols

    for fi, fp in enumerate(sparam_files):
        if verbose:
            print(f"    [{fi + 1}/{len(sparam_files)}] {os.path.basename(fp)}")

        el = os.path.splitext(fp)[1].lower()

        if el == ".csv":
            d = pd.read_csv(fp, header=0)
        elif el in (".xlsx", ".xls"):
            d = pd.read_excel(fp, header=0, engine="openpyxl")
        else:
            if verbose:
                print(f"      ⚠ 지원하지 않는 확장자라 스킵: {el}")
            continue

        h = [str(c) for c in d.columns]
        data = d.values

        ci, cnames = _detect_sparam_cols(h)

        if not ci:
            if verbose:
                print("      ⚠ S-param 열 못 찾음, 스킵")
            continue

        if cn is None:
            cn = cnames
            if verbose:
                print(f"    S-param 열({len(cn)}개) 자동 결정")
        elif cnames != cn:
            missing = set(cn) - set(cnames)
            extra = set(cnames) - set(cn)
            raise ValueError(
                f"S-param 컬럼 불일치: {os.path.basename(fp)}\n"
                f"  expected: {cn}\n"
                f"  found:    {cnames}\n"
                f"  missing={missing}, extra={extra}"
            )

        sd = data[:, ci].astype(np.float64)
        en = len(cn)

        ns = sd.shape[0] // n_freq

        if verbose:
            print(f"    구조 수: {ns}")

        for si in range(ns):
            chunk = sd[si * n_freq:(si + 1) * n_freq]
            if chunk.shape == (n_freq, en):
                all_s.append(chunk)

    if not all_s:
        raise ValueError("유효한 S-param 데이터 없음")

    arr = np.stack(all_s, 0)

    if verbose:
        print(f"  ✓ shape: {arr.shape}")

    return arr, cn


