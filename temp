# Dataset
# ══════════════════════════════════════════════════════════════
class JointDataset(Dataset):
    def __init__(self, npy_files, max_len, sparam_array, sparam_mean, sparam_std,
                 type_ids=None, type_names=None):
        """
        type_ids   : 각 sample의 type 인덱스 (없으면 모두 0)
        type_names : type 표시명 리스트
        """
        self.max_len=max_len
        self.raw=[]; self.padded=[]; self.json_files=[]
        for f in npy_files:
            jf=f.replace("_tokens.npy","_deepcad.json")
            self.json_files.append(jf if os.path.exists(jf) else None)
        for f in npy_files:
            t=np.load(f).astype(np.int32)
            t=ensure_eos_when_truncated(t, max_len)
            self.raw.append(t); self.padded.append(self._pad(t))
        self.sparam=(sparam_array-sparam_mean)/(sparam_std+1e-8)

        # ★ N_BIT 일치 검증 (fail-fast)
        #   추출 코드의 N_BIT > 학습 코드의 N_BIT 이면 토큰값 ≥ N_QUANT 가 들어와
        #   embedding/CE에서 device-side assert 발생. 미리 잡아준다.
        max_cmd  = -1
        max_prm  = -1
        for t in self.raw:
            if t.size == 0: continue
            cmd_col = t[:, 0]
            prm_col = t[:, 1:]
            cmd_valid = cmd_col[cmd_col >= 0]
            prm_valid = prm_col[prm_col >= 0]
            if cmd_valid.size: max_cmd = max(max_cmd, int(cmd_valid.max()))
            if prm_valid.size: max_prm = max(max_prm, int(prm_valid.max()))
        if max_cmd >= N_CMD:
            raise ValueError(
                f"\n  [데이터 검증 실패] cmd 토큰값 max={max_cmd} ≥ N_CMD({N_CMD})\n"
                f"  → 토큰 파일이 손상되었거나, 추출 코드의 cmd 정의와 다릅니다.")
        if max_prm >= N_QUANT:
            raise ValueError(
                f"\n  [데이터 검증 실패] param 토큰값 max={max_prm} ≥ N_QUANT({N_QUANT})\n"
                f"  → 추출 코드의 N_BIT 와 학습 코드의 N_BIT 이 불일치합니다!\n"
                f"     - 학습 코드 N_BIT={N_BIT}  →  허용 범위 [0..{N_QUANT-1}]\n"
                f"     - 토큰 파일 max 값  ={max_prm}  (이 값이 들어가려면 N_BIT ≥ {int(np.ceil(np.log2(max_prm+1)))})\n"
                f"  해결법:\n"
                f"     (A) 학습 코드 상단의 N_BIT 를 추출 코드와 같게 늘리고 다시 실행\n"
                f"     (B) 추출 코드를 학습 코드 N_BIT 으로 다시 돌려서 *_tokens.npy 재생성")

        N=len(self.raw)
        if type_ids is None:
            self.type_ids=np.zeros(N,dtype=np.int64)
        else:
            self.type_ids=np.asarray(type_ids,dtype=np.int64)
            assert len(self.type_ids)==N
        self.type_names=list(type_names) if type_names else ["typeA"]
        dist=", ".join(f"{n}:{int((self.type_ids==i).sum())}"
                       for i,n in enumerate(self.type_names))
        print(f"  ✓ {N}개 시퀀스 + S-param 로드  (type 분포: {dist})")
        print(f"    토큰 범위: cmd∈[0..{max_cmd}]  param∈[0..{max_prm}]  "
              f"(허용 N_QUANT={N_QUANT}, N_BIT={N_BIT})")

    def _pad(self, t):
        L=t.shape[0]
        if L>=self.max_len: return t[:self.max_len].astype(np.float32)
        return np.concatenate(
            [t, np.full((self.max_len-L,17), PAD_V, dtype=np.float32)], 0
        ).astype(np.float32)

    def load_json(self, idx):
        jf=self.json_files[idx]
        if jf is None: return None
        try:
            with open(jf,"r",encoding="utf-8") as f: return json.load(f)
        except Exception:
            return None

    def __len__(self): return len(self.padded)

    def set_vars(self, vars_padded):
        """★ v11l: design vars 주입 (B, max_n_dv) float32. 호출 시점은 dataset 생성 후."""
        if vars_padded is None:
            self.vars = None
            return
        N = len(self.padded)
        v = np.asarray(vars_padded, dtype=np.float32)
        assert v.shape[0] == N, f"vars rows ({v.shape[0]}) != dataset N ({N})"
        self.vars = v

    def __getitem__(self, idx):
        item = (torch.tensor(self.padded[idx],dtype=torch.float32),
                torch.tensor(self.sparam[idx], dtype=torch.float32),
                torch.tensor(int(self.type_ids[idx]), dtype=torch.long))
        if getattr(self, "vars", None) is not None:
            item = item + (torch.tensor(self.vars[idx], dtype=torch.float32),)
        return item

    @staticmethod
    def shuffle_structures_padded(padded):
        """구조(SOL→...→EXT) 단위로 분해 → 랜덤 순서 → 재조립.
           - EOS/PAD는 맨 끝 유지
           - 구조 내부 순서 보존"""
        L=padded.shape[0]
        structures=[]; current=[]; trailing=[]
        i=0; seen_eos=False
        while i<L:
            c=int(padded[i,0])
            if seen_eos or c<0:
                trailing.append(padded[i]); i+=1; continue
            if c==EOS:
                if current:
                    structures.append(np.stack(current,0)); current=[]
                trailing.append(padded[i]); seen_eos=True; i+=1; continue
            if c==SOL and current:
                structures.append(np.stack(current,0)); current=[padded[i]]
            else:
                current.append(padded[i])
            i+=1
        if current: structures.append(np.stack(current,0))

        if len(structures)>=2:
            np.random.shuffle(structures)

        parts=structures[:]
        if trailing: parts.append(np.stack(trailing,0))
        result=np.concatenate(parts,axis=0) if parts else padded
        if result.shape[0]!=L:
            if result.shape[0]<L:
                pad=np.full((L-result.shape[0],17), PAD_V, dtype=np.float32)
                result=np.concatenate([result,pad], axis=0)
            else:
                result=result[:L]
        return result.astype(np.float32)


class AugmentedSubset(Dataset):
    """train/val을 동일 underlying dataset에서 분기. train만 augmentation."""
    def __init__(self, dataset, indices, augment=False):
        self.dataset=dataset; self.indices=list(indices); self.augment=augment

    def __len__(self): return len(self.indices)

    def __getitem__(self, i):
        idx=self.indices[i]
        padded=self.dataset.padded[idx]
        if self.augment:
            padded=self.dataset.shuffle_structures_padded(padded.copy())
        item = (torch.tensor(padded,dtype=torch.float32),
                torch.tensor(self.dataset.sparam[idx], dtype=torch.float32),
                torch.tensor(int(self.dataset.type_ids[idx]), dtype=torch.long))
        if getattr(self.dataset, "vars", None) is not None:
            item = item + (torch.tensor(self.dataset.vars[idx], dtype=torch.float32),)
        return item


