# Baseline DeepCAD AE
#   - per-slot param embedding: nn.Embedding(N_QUANT+1, d_param) × N_ARGS
#   - cmd embedding + sum(param embeddings) → projection to d_model
#   - Standard sinusoidal absolute positional encoding
#   - Standard Transformer encoder/decoder
#   - Mean-pool encoder output → Linear → latent z
#   - ★ v11l: optional hybrid z = combine(z_token, z_param) where
#             z_param 은 type-specific ParamEncoderMulti 가 raw design vars 에서 생성.
# ══════════════════════════════════════════════════════════════
class DeepCADBaselineAE(nn.Module):
    def __init__(self, max_len=128, d_model=256, d_param=64,
                 nhead=8, n_enc=4, n_dec=4, d_ff=1024,
                 latent=256, mem_tokens=16, dropout=0.1,
                 n_pool=4, n_freq_bands=0,
                 combine_param=False,
                 n_dv_per_type=None,
                 z_param_dim=64,
                 param_encoder_hidden=128):
        super().__init__()
        assert d_model % nhead == 0, f"d_model({d_model}) must be divisible by nhead({nhead})"
        self.max_len=max_len
        self.d_model=d_model
        self.d_param=d_param
        self.latent=latent
        self.mem_tokens=mem_tokens
        self.n_pool=int(n_pool)
        self.n_freq_bands = int(n_freq_bands)   # ★ v10a: Fourier L; 0이면 비활성

        # ── ★ v11l: param branch flag ──
        self.combine_param = bool(combine_param)
        self.z_param_dim   = int(z_param_dim) if self.combine_param else 0

        # ── Token embeddings ──
        # cmd: N_CMD + 1 (PAD) → d_model
        self.cmd_emb = nn.Embedding(N_CMD+1, d_model, padding_idx=PAD_CMD_INDEX)
        # param: per-slot embedding. N_QUANT+1 = quantized values + PAD index
        # 16개 slot 각각 (N_QUANT+1, d_param) 테이블
        self.param_embs = nn.ModuleList([
            nn.Embedding(N_QUANT+1, d_param, padding_idx=PAD_PARAM_INDEX)
            for _ in range(N_ARGS)
        ])

        # ★ v10a: Fourier feature encoding 추가
        # 각 slot의 양자화 인덱스 → [0,1] float 정규화 → γ(p)로 펼침
        #   γ(p) = [sin(2^0 π p), cos(2^0 π p), ..., sin(2^(L-1) π p), cos(2^(L-1) π p)]
        # shape: (B, L, 16) → (B, L, 16 × 2L)
        # frequency bands는 buffer로 저장 (학습 X, device 따라감)
        if self.n_freq_bands > 0:
            # 주파수 밴드: 2^0, 2^1, ..., 2^(L-1)  ×π
            freq_bands = (2.0 ** torch.arange(self.n_freq_bands, dtype=torch.float32)) * math.pi
            self.register_buffer("fourier_freqs", freq_bands)   # (L,)
            fourier_dim_per_slot = 2 * self.n_freq_bands          # sin+cos
            fourier_total = N_ARGS * fourier_dim_per_slot         # 16 × 2L
            param_proj_in = N_ARGS * d_param + fourier_total
        else:
            self.fourier_freqs = None
            param_proj_in = N_ARGS * d_param

        # Concatenated [per-slot emb, Fourier] → d_model
        self.param_proj = nn.Linear(param_proj_in, d_model)
        self.emb_norm   = nn.LayerNorm(d_model)
        # 기록용 (diagnose_model)
        self._param_proj_in = param_proj_in

        # ── Positional encoding (absolute sinusoidal, both encoder & decoder) ──
        self.pos_enc = SinPosEnc(d_model, max_len=max_len+16, dropout=dropout)

        # ── Encoder ──
        enc_layer = nn.TransformerEncoderLayer(
            d_model=d_model, nhead=nhead, dim_feedforward=d_ff,
            dropout=dropout, batch_first=True, norm_first=True)
        self.encoder = nn.TransformerEncoder(
            enc_layer, num_layers=n_enc, norm=nn.LayerNorm(d_model))

        # ── Pooling → latent ──
        # n_pool >= 2 : PMA (learnable query × n_pool, cross-attn on encoder out)
        # 그 외      : mean-pool (baseline) + Linear
        if self.n_pool >= 2:
            # learnable query bank (n_pool, d_model)
            self.pool_queries = nn.Parameter(torch.randn(self.n_pool, d_model) * 0.02)
            self.pool_attn = nn.MultiheadAttention(
                embed_dim=d_model, num_heads=nhead,
                dropout=dropout, batch_first=True)
            self.pool_norm = nn.LayerNorm(d_model)
            # ★ v10i: LayerNorm 제거 — z의 magnitude 정보가 latent에 인코딩되도록
            #   (이전 버전의 ||z|| std=0.06이라는 평탄화 현상 해소 목적)
            self.to_z = nn.Linear(self.n_pool * d_model, latent)
        else:
            self.pool_queries = None
            self.pool_attn    = None
            self.pool_norm    = None
            # ★ v10i: mean-pool 분기도 LayerNorm 제거
            self.to_z = nn.Linear(d_model, latent)
        # alias for backward compat with diagnose_latent
        self.latent_coarse = latent

        # ── Decoder: z → mem_tokens → autoregressive ──
        self.from_z = nn.Linear(latent, mem_tokens * d_model)
        dec_layer = nn.TransformerDecoderLayer(
            d_model=d_model, nhead=nhead, dim_feedforward=d_ff,
            dropout=dropout, batch_first=True, norm_first=True)
        self.decoder = nn.TransformerDecoder(
            dec_layer, num_layers=n_dec, norm=nn.LayerNorm(d_model))
        self.bos = nn.Parameter(torch.randn(1,1,d_model) * 0.02)

        # ── Output heads ──
        self.cmd_head   = nn.Linear(d_model, N_CMD)
        self.param_head = nn.Linear(d_model, N_ARGS * N_QUANT)

        # ── ★ v11l: ParamEncoder branch (raw design vars → z_param) ──
        if self.combine_param:
            assert n_dv_per_type is not None, \
                "combine_param=True 일 때 n_dv_per_type (type별 vars 개수 dict/list) 필요"
            self.param_encoder = ParamEncoderMulti(
                n_dv_per_type=n_dv_per_type,
                z_param_dim=self.z_param_dim,
                hidden=param_encoder_hidden,
                dropout=dropout,
            )
            # to_z 의 출력 = z_token (latent) 이고, z_combined = combine(z_token, z_param)
            # combine: concat([z_token (latent), z_param (z_param_dim)]) → Linear → latent
            self.combine_proj = nn.Sequential(
                nn.Linear(latent + self.z_param_dim, latent),
                nn.LayerNorm(latent),
            )
        else:
            self.param_encoder = None
            self.combine_proj  = None

        self._init_weights()

    def _init_weights(self):
        for p in self.parameters():
            if p.dim() > 1:
                nn.init.xavier_uniform_(p)

    def _content_embed(self, x):
        """
        x: (B, L, 17) — col 0: cmd, col 1..16: param (long; -1 for PAD)
        Returns:
          emb: (B, L, d_model) with PAD positions zeroed
          pad_mask: (B, L) True at PAD positions
        """
        cmd = x[:,:,0].long()                                 # (B, L)
        params = x[:,:,1:].long()                             # (B, L, 16)
        pad_mask = (cmd < 0)                                  # (B, L)

        # cmd index handling (PAD → PAD_CMD_INDEX)
        cmd_idx = cmd.clone()
        cmd_idx[pad_mask] = PAD_CMD_INDEX
        cmd_idx = cmd_idx.clamp(0, PAD_CMD_INDEX)
        cmd_e = self.cmd_emb(cmd_idx)                         # (B, L, d_model)

        # param: -1 (invalid) → PAD_PARAM_INDEX = N_QUANT
        param_idx = params.clone()
        param_idx[param_idx < 0] = PAD_PARAM_INDEX
        param_idx = param_idx.clamp(0, PAD_PARAM_INDEX)

        # Per-slot embedding (논문 방식)
        slot_embs = []
        for s in range(N_ARGS):
            slot_embs.append(self.param_embs[s](param_idx[:,:,s]))   # (B,L,d_param)
        param_concat = torch.cat(slot_embs, dim=-1)            # (B, L, 16*d_param)

        # ★ v10a: Fourier feature 추가
        # param_idx를 [0,1] float으로 정규화 후 γ(p) 계산
        # PAD 위치는 0.0으로 고정 (어차피 emb 끝에서 zero-out됨)
        if self.n_freq_bands > 0 and self.fourier_freqs is not None:
            # param_idx: (B, L, 16), PAD=N_QUANT 인덱스 → 0으로 치환
            p_int = param_idx.clone()
            pad_p = (params < 0)                                     # (B, L, 16)
            p_int[pad_p] = 0                                          # PAD는 일단 0
            # [0, N_QUANT-1] → [0, 1]
            p_f = p_int.float() / float(QMAX)                         # (B, L, 16)
            # γ(p) = [sin(2^k π p), cos(2^k π p)]_{k=0..L-1}
            # freqs: (L,)   p_f: (B, L, 16)  →  ang: (B, L, 16, L_bands)
            ang = p_f.unsqueeze(-1) * self.fourier_freqs.view(1, 1, 1, -1)
            sin_p = torch.sin(ang)                                    # (B, L, 16, Lb)
            cos_p = torch.cos(ang)                                    # (B, L, 16, Lb)
            # PAD 위치는 명시적으로 0으로 mask
            pad_p_exp = pad_p.unsqueeze(-1).float()                   # (B, L, 16, 1)
            sin_p = sin_p * (1.0 - pad_p_exp)
            cos_p = cos_p * (1.0 - pad_p_exp)
            # flatten: (B, L, 16 × 2Lb)
            B_, L_, _ = params.shape
            fourier_feat = torch.cat([sin_p, cos_p], dim=-1)          # (B, L, 16, 2Lb)
            fourier_feat = fourier_feat.reshape(B_, L_, N_ARGS * 2 * self.n_freq_bands)
            # concat with per-slot embedding
            param_concat = torch.cat([param_concat, fourier_feat], dim=-1)

        param_e = self.param_proj(param_concat)                # (B, L, d_model)

        emb = self.emb_norm(cmd_e + param_e)
        emb = emb * (~pad_mask).unsqueeze(-1)
        return emb, pad_mask

    def encode(self, x):
        """
        x: (B, L, 17)
        Returns:
          z: (B, latent)   ← token-only z (★ v11l: z_token. combine 안 한 형태)

        Pooling:
          · PMA (n_pool >= 2): learnable queries가 encoder output에
            cross-attention하여 n_pool개의 set-valued 요약 → flatten → Linear
          · baseline (n_pool <= 1): valid 토큰 mean-pool → Linear
        """
        emb, pad_mask = self._content_embed(x)
        emb = self.pos_enc(emb)
        h = self.encoder(emb, src_key_padding_mask=pad_mask)   # (B, L, d_model)

        if self.n_pool >= 2 and self.pool_attn is not None:
            # ── PMA pooling ──
            B = h.size(0)
            Q = self.pool_queries.unsqueeze(0).expand(B, -1, -1)    # (B, n_pool, d_model)
            # key_padding_mask: PAD=True → attention에서 제외
            pooled, _ = self.pool_attn(Q, h, h,
                                        key_padding_mask=pad_mask,
                                        need_weights=False)         # (B, n_pool, d_model)
            pooled = self.pool_norm(pooled)
            pooled_flat = pooled.reshape(B, self.n_pool * self.d_model)
            z = self.to_z(pooled_flat)                              # (B, latent)
        else:
            # ── mean-pool (PAD 제외) ──
            valid = (~pad_mask).float().unsqueeze(-1)              # (B, L, 1)
            pooled = (h * valid).sum(dim=1) / valid.sum(dim=1).clamp(min=1.0)
            z = self.to_z(pooled)                                  # (B, latent)
        return z

    def encode_combined(self, x, vars_padded=None, type_ids=None):
        """
        ★ v11l: token z 와 param z 를 합쳐 z_combined 반환.
        combine_param=False 거나 vars/type_ids 없으면 z_token 만 반환 (= encode 와 동일).
        """
        z_tok = self.encode(x)                                     # (B, latent)
        if (not self.combine_param) or (vars_padded is None) or (type_ids is None):
            return z_tok
        z_par = self.param_encoder(vars_padded, type_ids)          # (B, z_param_dim)
        z_cat = torch.cat([z_tok, z_par], dim=-1)                  # (B, latent + z_param_dim)
        z_comb = self.combine_proj(z_cat)                          # (B, latent)
        return z_comb

    def _memory_from_z(self, z):
        return self.from_z(z).view(z.size(0), self.mem_tokens, self.d_model)

    def decode_teacher(self, z, teacher):
        """Teacher-forcing. teacher: (B, L, 17). Returns (cmd_logits, prm_logits)."""
        B, L, _ = teacher.shape
        memory = self._memory_from_z(z)
        bos = self.bos.expand(B, 1, self.d_model)
        prev_emb, prev_pad = self._content_embed(teacher[:, :-1, :])
        tgt = self.pos_enc(torch.cat([bos, prev_emb], dim=1))
        tgt_pad = torch.cat([
            torch.zeros((B,1), dtype=torch.bool, device=teacher.device),
            prev_pad
        ], dim=1)
        tgt_mask = causal_mask(L, teacher.device)
        out = self.decoder(tgt=tgt, memory=memory,
                           tgt_mask=tgt_mask,
                           tgt_key_padding_mask=tgt_pad)
        cmd_logits = self.cmd_head(out)                         # (B, L, N_CMD)
        prm_logits = self.param_head(out).view(B, L, N_ARGS, N_QUANT)
        return cmd_logits, prm_logits

    @torch.no_grad()
    def generate(self, z, max_gen_len=None):
        if max_gen_len is None: max_gen_len = self.max_len
        B = z.size(0); device = z.device
        memory = self._memory_from_z(z)
        bos = self.bos.expand(B, 1, self.d_model)
        steps = []
        finished = torch.zeros(B, dtype=torch.bool, device=device)

        for _ in range(max_gen_len):
            if not steps:
                tc = bos
                tp = torch.zeros((B,1), dtype=torch.bool, device=device)
            else:
                prev = torch.stack(steps, dim=1).float()
                pe, pp = self._content_embed(prev)
                tc = torch.cat([bos, pe], dim=1)
                tp = torch.cat([torch.zeros((B,1), dtype=torch.bool, device=device), pp], dim=1)

            ti = self.pos_enc(tc); Lc = ti.size(1)
            tm = causal_mask(Lc, device)
            out = self.decoder(tgt=ti, memory=memory,
                               tgt_mask=tm, tgt_key_padding_mask=tp)
            last = out[:, -1, :]
            cl = self.cmd_head(last)
            pl = self.param_head(last).view(B, N_ARGS, N_QUANT)

            nc = torch.argmax(cl, dim=-1)
            np_ = torch.argmax(pl, dim=-1)
            nt = torch.full((B, 17), PAD_V, dtype=torch.long, device=device)
            nt[:, 0] = nc
            for cid in range(N_CMD):
                nv = VALID_PAR.get(cid, 0)
                if nv <= 0: continue
                m = (nc == cid)
                if m.any():
                    nt[m, 1:1+nv] = np_[m, :nv]
            if finished.any():
                nt[finished] = PAD_V
                nt[finished, 0] = EOS
            steps.append(nt)
            finished = finished | (nc == EOS)
            if bool(finished.all()): break

        if not steps:
            return torch.zeros((B, 0, 17), dtype=torch.long, device=device)
        rt = torch.stack(steps, dim=1)
        rn = rt.detach().cpu().numpy().astype(np.int32)
        cl_ = []
        for i in range(rn.shape[0]):
            s = trim_after_eos(rn[i])
            pad_len = rn.shape[1] - s.shape[0]
            if pad_len > 0:
                s = np.concatenate([s, np.full((pad_len, 17), PAD_V, dtype=np.int32)], axis=0)
            cl_.append(s)
        return torch.tensor(np.stack(cl_, axis=0), device=device, dtype=torch.long)

    def forward(self, x, vars_padded=None, type_ids=None):
        """
        x          : (B, L, 17) tokens
        vars_padded: (B, max_n_dv) or None  — combine_param=True 시 필요
        type_ids   : (B,)       or None
        Returns: (cmd_logits, prm_logits, z_combined)
        """
        z = self.encode_combined(x, vars_padded=vars_padded, type_ids=type_ids)
        cl, pl = self.decode_teacher(z, teacher=x)
        return cl, pl, z


# ══════════════════════════════════════════════════════════════
# S-param surrogate (latent z → 12-channel × n_freq sparam)
#   ★ v11h: type-aware. SparamMLP(z, type_id) → sparam.
# ══════════════════════════════════════════════════════════════
class TypeEncoder(nn.Module):
    """type_id (B,) → type_vector (B, emb_dim).

    추후 type 수가 많아지거나 unseen type 대응 필요시 이 클래스만 swap:
      - 단순 embedding (현재) : 수십~수백 type, 타입당 충분 데이터
      - hierarchical          : 수백~수천 type, cluster + residual
      - feature regression    : 수천+ type, geometry attribute → vector

    emb_dim=0 또는 n_types<=1 이면 빈 벡터(B,0) 반환 = type 비활성.
    """
    def __init__(self, n_types: int, emb_dim: int = 8):
        super().__init__()
        self.n_types = int(n_types)
        self.emb_dim = int(emb_dim)
        self.active = (self.emb_dim > 0 and self.n_types > 1)
        if self.active:
            self.emb = nn.Embedding(self.n_types, self.emb_dim)
            nn.init.normal_(self.emb.weight, std=0.02)
        else:
            self.emb = None

    def forward(self, type_ids):
        """type_ids: (B,) long → (B, emb_dim) float.  active=False 면 (B,0)."""
        B = type_ids.size(0)
        if not self.active:
            return type_ids.new_zeros((B, 0), dtype=torch.float32)
        ids = type_ids.clamp(0, self.n_types - 1)
        return self.emb(ids)


class SparamMLP(nn.Module):
    """latent z (+ optional type embedding) → 정규화된 S-param.

    type_emb_dim > 0 이면 input = concat([z, type_vec]).
    """
    def __init__(self, latent_dim=128, n_freq=401, n_sparam=12,
                 hidden_mult=1.0, dropout=0.3,
                 n_types=1, type_emb_dim=0):
        super().__init__()
        self.n_freq = n_freq
        self.n_sparam = n_sparam

        self.type_encoder = TypeEncoder(n_types=n_types, emb_dim=type_emb_dim)
        in_dim = latent_dim + (type_emb_dim if self.type_encoder.active else 0)
        out_dim = n_freq * n_sparam

        h1 = in_dim
        h2 = max(int(in_dim * hidden_mult), 64)
        self.net = nn.Sequential(
            nn.Linear(in_dim, h1), nn.LayerNorm(h1), nn.GELU(), nn.Dropout(dropout),
            nn.Linear(h1, h2),     nn.LayerNorm(h2), nn.GELU(), nn.Dropout(dropout),
            nn.Linear(h2, out_dim),
        )

    def forward(self, z, type_ids=None):
        if self.type_encoder.active and type_ids is not None:
            t_vec = self.type_encoder(type_ids)
            x = torch.cat([z, t_vec], dim=-1)
        else:
            x = z
        return self.net(x).view(-1, self.n_freq, self.n_sparam)


# ══════════════════════════════════════════════════════════════
# ★ v11l: ParamEncoderMulti
# ──────────────────────────────────────────────────────────────
# Type 별로 design vars 개수가 다를 수 있어 type-specific encoder 들을 ModuleList 로
# 보유. forward 시 batch 의 각 sample 의 type_id 따라 해당 encoder 사용.
#
# 입력:
#   vars_padded  : (B, max_n_dv) — 각 sample 의 raw vars (padded with 0)
#   type_ids     : (B,) — 각 sample 의 type id
#   n_dv_per_type: dict {type_id (int): 실제 vars 개수}
#
# 출력: z_param (B, z_param_dim)
# ══════════════════════════════════════════════════════════════
class ParamEncoderMulti(nn.Module):
    def __init__(self, n_dv_per_type, z_param_dim=64, hidden=128, dropout=0.1):
        super().__init__()
        # n_dv_per_type 는 dict 또는 list-like. 정렬된 type 순서로 ModuleList 구성.
        if isinstance(n_dv_per_type, dict):
            self.type_keys = sorted(n_dv_per_type.keys())
            n_dv_list = [n_dv_per_type[k] for k in self.type_keys]
        else:
            self.type_keys = list(range(len(n_dv_per_type)))
            n_dv_list = list(n_dv_per_type)

        self.n_dv_list   = n_dv_list
        self.z_param_dim = z_param_dim
        self.encoders = nn.ModuleList([
            nn.Sequential(
                nn.Linear(max(n_dv, 1), hidden),
                nn.LayerNorm(hidden), nn.GELU(), nn.Dropout(dropout),
                nn.Linear(hidden, hidden),
                nn.LayerNorm(hidden), nn.GELU(), nn.Dropout(dropout),
                nn.Linear(hidden, z_param_dim),
            )
            for n_dv in n_dv_list
        ])

    def forward(self, vars_padded, type_ids):
        """
        vars_padded : (B, max_n_dv)  float32, normalized, zero-padded for unused slots
        type_ids    : (B,)            int64
        Returns: z_param (B, z_param_dim)
        """
        B = vars_padded.size(0)
        device = vars_padded.device
        z = torch.zeros(B, self.z_param_dim, device=device, dtype=vars_padded.dtype)
        for i, t in enumerate(self.type_keys):
            mask = (type_ids == t)
            if not mask.any(): continue
            n_dv = self.n_dv_list[i]
            sub = vars_padded[mask, :n_dv]                  # (B_t, n_dv_t)
            z[mask] = self.encoders[i](sub)
        return z


# ══════════════════════════════════════════════════════════════
# Loss + geo features
# ══════════════════════════════════════════════════════════════
def vicreg_z_loss(z, var_target=1.0, eps=1e-4):
    """
    VICReg-style latent regularization.

    Args:
        z         : (B, D) — encoder output latent
        var_target: 각 dim batch std 의 lower bound (보통 1.0)
        eps       : numerical stability for sqrt

    Returns:
        var_loss : F.relu(var_target − std(z_d)).mean()
                   → dead dim (std≈0) 에 push, encoder가 모든 dim 활성화하도록 강제
        cov_loss : Σ_{i≠j} cov(z_i, z_j)² / D
                   → dim 간 decorrelation, redundancy 제거

    Both losses are 0 when z is fully utilized (std=target, off-diag cov=0).
    """
    if z.dim() != 2:
        raise ValueError(f"vicreg_z_loss expects (B,D), got {tuple(z.shape)}")
    N, D = z.shape
    if N <= 1:
        zero = z.new_zeros(())
        return zero, zero

    z_c = z - z.mean(dim=0, keepdim=True)
    var = z_c.var(dim=0, unbiased=False)                      # (D,)
    std = torch.sqrt(var + eps)
    var_loss = F.relu(var_target - std).mean()

    cov = (z_c.T @ z_c) / max(N - 1, 1)                       # (D, D)
    off = cov - torch.diag(torch.diag(cov))                   # off-diag only
    cov_loss = (off ** 2).sum() / D
    return var_loss, cov_loss


def ae_loss_fn(cmd_logits, prm_logits, tgt,
               w_cmd=1.0, w_prm=1.0, return_components=False):
    """
    Baseline DeepCAD loss: cmd cross-entropy + per-slot param cross-entropy.

    ★ device-side assert 방지를 위해 라벨을 양쪽 clamp:
       cmd label  : [0, N_CMD-1]
       prm label  : [0, N_QUANT-1]
       (vp/vr mask로 PAD 위치는 어차피 무시되므로 안전)
    """
    B, L, _ = tgt.shape
    ct = tgt[:,:,0].long(); vr = ct >= 0
    ce = F.cross_entropy(cmd_logits.reshape(B*L, N_CMD),
                         ct.clamp(0, N_CMD-1).reshape(B*L),
                         reduction="none").reshape(B, L)
    cmd_loss = (ce * vr.float()).sum() / (vr.float().sum() + 1e-8)

    pt = tgt[:,:,1:].long(); vp = pt >= 0
    pce = F.cross_entropy(prm_logits.reshape(B*L*N_ARGS, N_QUANT),
                          pt.clamp(0, N_QUANT-1).reshape(B*L*N_ARGS),
                          reduction="none").reshape(B, L, N_ARGS)
    prm_loss = (pce * vp.float()).sum() / (vp.float().sum() + 1e-8)

    total = w_cmd * cmd_loss + w_prm * prm_loss
    if return_components:
        return total, {"cmd": cmd_loss.item(), "prm": prm_loss.item(),
                       "total": total.item()}
    return total


# ══════════════════════════════════════════════════════════════
# Training loops
# ══════════════════════════════════════════════════════════════
def run_joint_epoch(ae, mlp, loader, optimizer, device, cfg, train_mode=True):
    """
    Joint 학습:  loss = w_cmd*cmd_CE + w_prm*param_CE + w_sparam*MSE(sp_pred, sp_true)

    mlp = None 이면 baseline AE-only 학습 (기존 run_ae_epoch와 동일).
    """
    if train_mode:
        ae.train()
        if mlp is not None: mlp.train()
    else:
        ae.eval()
        if mlp is not None: mlp.eval()
    acc = {"total":0., "ae":0., "sp":0., "cmd":0., "prm":0.,
           "var":0., "cov":0., "z_std":0., "z_norm":0., "grad_norm":0.}
    n = 0
    for batch in loader:
        # batch = (tok, sparam, type_id [, vars])  ← v11l: vars 4번째 (선택)
        batch_vars = None
        if len(batch) == 4:
            batch_tok, batch_sp, batch_tid, batch_vars = batch
            batch_tid  = batch_tid.to(device)
            batch_vars = batch_vars.to(device)
        elif len(batch) == 3:
            batch_tok, batch_sp, batch_tid = batch
            batch_tid = batch_tid.to(device)
        else:                                   # 호환성: 옛 (tok, sparam)
            batch_tok, batch_sp = batch
            batch_tid = None
        batch_tok = batch_tok.to(device)
        batch_sp  = batch_sp.to(device)

        if train_mode: optimizer.zero_grad(set_to_none=True)
        with torch.set_grad_enabled(train_mode):
            cl, pl, z = ae(batch_tok, vars_padded=batch_vars, type_ids=batch_tid)
            ae_loss, comp = ae_loss_fn(cl, pl, batch_tok,
                                       w_cmd=cfg.w_cmd, w_prm=cfg.w_prm,
                                       return_components=True)
            if mlp is not None:
                sp_pred = mlp(z, batch_tid)               # ★ type-aware
                sp_loss = F.mse_loss(sp_pred, batch_sp)
                total = ae_loss + cfg.w_sparam * sp_loss
            else:
                sp_loss = torch.zeros((), device=device)
                total = ae_loss

            # ── VICReg latent regularization ──
            w_var = float(getattr(cfg, "w_var", 0.0))
            w_cov = float(getattr(cfg, "w_cov", 0.0))
            if (w_var > 0 or w_cov > 0) and z.size(0) > 1:
                v_loss, c_loss = vicreg_z_loss(
                    z, var_target=float(getattr(cfg, "vicreg_var_target", 1.0)))
                total = total + w_var*v_loss + w_cov*c_loss
            else:
                v_loss = torch.zeros((), device=device)
                c_loss = torch.zeros((), device=device)

            if train_mode:
                total.backward()
                params = list(ae.parameters())
                if mlp is not None: params += list(mlp.parameters())
                gn = nn.utils.clip_grad_norm_(params, cfg.grad_clip)
                optimizer.step()
                acc["grad_norm"] += float(gn)

        acc["total"] += total.item()
        acc["ae"]    += ae_loss.item()
        acc["sp"]    += sp_loss.item()
        acc["cmd"]   += comp["cmd"]
        acc["prm"]   += comp["prm"]
        acc["var"]   += float(v_loss.item())
        acc["cov"]   += float(c_loss.item())
        with torch.no_grad():
            acc["z_std"]  += float(z.std(dim=0).mean().item()) if z.size(0)>1 else 0.0
            acc["z_norm"] += float(z.norm(dim=1).mean().item())
        n += 1
    if n == 0: return {**{k:0. for k in acc}, "n_batches":0}
    out = {k: v/n for k, v in acc.items()}; out["n_batches"] = n
    return out


# ══════════════════════════════════════════════════════════════
# Real-coord rendering (JSON 메타데이터 활용)
# ══════════════════════════════════════════════════════════════
def _v3(d):
    return np.array([d["x"], d["y"], d["z"]], dtype=float)


def extract_dequant_meta(json_data: dict) -> dict:
    seq=json_data["sequence"]
    meta=json_data.get("metadata", {})

    pts=[]
    for op in seq:
        if op["type"]=="Sketch":
            pts.append(_v3(op["plane"]["origin"]).tolist())
    for g in meta.get("solids", []):
        pts.append(g.get("aabb_min",[0,0,0]))
        pts.append(g.get("aabb_max",[0,0,0]))
    arr=np.array(pts) if pts else np.array([[0,0,0],[1,1,1]])
    g_min3,g_max3=arr.min(axis=0), arr.max(axis=0)
    g_max_dim=float((g_max3-g_min3).max())
    if g_max_dim<1e-8: g_max_dim=1.0

    sketch_metas=[]; all_extents=[]
    for op in seq:
        if op["type"]=="Sketch":
            profile=op.get("profile", {})
            xs,ys=[],[]
            for loop in profile.get("children", []):
                for e in loop.get("children", []):
                    for key in ("start_point","end_point","mid_point","center_point"):
                        if key in e:
                            xs.append(e[key]["x"]); ys.append(e[key]["y"])
            if xs:
                xy_min=np.array([min(xs),min(ys)])
                xy_max=np.array([max(xs),max(ys)])
            else:
                xy_min=np.array([0.0,0.0]); xy_max=np.array([1.0,1.0])
            sk_scale=max(float((xy_max-xy_min).max()), 1e-8)

            plane=op["plane"]
            sketch_metas.append({
                "xy_min":xy_min, "xy_max":xy_max, "sk_scale":sk_scale,
                "origin":_v3(plane["origin"]),
                "x_axis":_v3(plane["x_axis"]),
                "y_axis":_v3(plane["y_axis"]),
                "z_axis":_v3(plane["z_axis"]),
            })
        elif op["type"]=="Extrude":
            all_extents.append(op["extent_one"]["distance"])
            all_extents.append(op["extent_two"]["distance"])

    max_ext=max(all_extents) if all_extents else 1.0
    if max_ext<1e-8: max_ext=1.0
    return {"g_min3":g_min3, "g_max3":g_max3, "g_max_dim":g_max_dim,
            "max_ext":max_ext, "sketches":sketch_metas}


def _arc_pts(sx,sy, mx,my, ex,ey, n=32):
    D=2*(sx*(my-ey) + mx*(ey-sy) + ex*(sy-my))
    if abs(D)<1e-9:
        t=np.linspace(0,1,n)
        return list(zip(sx+(ex-sx)*t, sy+(ey-sy)*t))
    ux=((sx**2+sy**2)*(my-ey) + (mx**2+my**2)*(ey-sy) + (ex**2+ey**2)*(sy-my))/D
    uy=((sx**2+sy**2)*(ex-mx) + (mx**2+my**2)*(sx-ex) + (ex**2+ey**2)*(mx-sx))/D
    r=math.sqrt((sx-ux)**2 + (sy-uy)**2)
    a1=math.atan2(sy-uy, sx-ux)
    am=math.atan2(my-uy, mx-ux)
    a2=math.atan2(ey-uy, ex-ux)
    def fix(a, ref):
        while a-ref >  math.pi: a -= 2*math.pi
        while a-ref < -math.pi: a += 2*math.pi
        return a
    am=fix(am, a1); a2=fix(a2, a1)
    if not (min(a1,a2) <= am <= max(a1,a2)):
        a2 = a2 - 2*math.pi if a2>a1 else a2 + 2*math.pi
    return [(ux+r*math.cos(a), uy+r*math.sin(a)) for a in np.linspace(a1, a2, n)]


def _circle_pts(cx, cy, r, n=48):
    a=np.linspace(0, 2*math.pi, n, endpoint=False)
    return [(cx+r*math.cos(t), cy+r*math.sin(t)) for t in a]


def json_to_real_sketches(json_data: dict) -> list:
    seq=json_data["sequence"]; sketches=[]; i=0
    while i<len(seq):
        if seq[i]["type"]=="Sketch" and i+1<len(seq) and seq[i+1]["type"]=="Extrude":
            sk=seq[i]; ex=seq[i+1]
            plane=sk["plane"]
            origin=_v3(plane["origin"]); xa=_v3(plane["x_axis"])
            ya=_v3(plane["y_axis"]);     za=_v3(plane["z_axis"])
            extent=ex["extent_one"]["distance"]
            normal=za/(np.linalg.norm(za)+1e-12)

            loops_3d=[]
            for loop in sk.get("profile",{}).get("children", []):
                pts=[]
                for ei,e in enumerate(loop.get("children", [])):
                    et=e["type"]
                    if et=="Line":
                        sp=e["start_point"]; ep=e["end_point"]
                        if ei==0: pts.append(origin + sp["x"]*xa + sp["y"]*ya)
                        pts.append(origin + ep["x"]*xa + ep["y"]*ya)
                    elif et=="Arc":
                        sp=e["start_point"]; mp=e["mid_point"]; ep=e["end_point"]
                        a2d=_arc_pts(sp["x"],sp["y"], mp["x"],mp["y"], ep["x"],ep["y"])
                        si=0 if ei==0 else 1
                        for ax2,ay2 in a2d[si:]:
                            pts.append(origin + ax2*xa + ay2*ya)
                    elif et=="Circle":
                        cp=e["center_point"]; r=e["radius"]
                        c2d=_circle_pts(cp["x"], cp["y"], r)
                        for cx2,cy2 in c2d:
                            pts.append(origin + cx2*xa + cy2*ya)
                if len(pts)>=2: loops_3d.append(pts)
            if loops_3d:
                sketches.append({"loops_3d":loops_3d, "normal":normal, "extent":extent})
            i+=2
        else:
            i+=1
    return sketches


def _dequant(q, lo, hi):
    if q<0: return (lo+hi)/2.0
    return lo + (q/QMAX)*(hi-lo)


def tokens_to_real_sketches(tokens: np.ndarray, dq_meta: dict) -> list:
    sk_metas=dq_meta["sketches"]; max_ext=dq_meta["max_ext"]
    sketches=[]; cur_loops=[]; cur_pts=[]; sketch_idx=0; cur_2d=(0.0,0.0)

    for row in tokens:
        cmd=int(row[0]); p=row[1:]
        if cmd==SOL:
            if cur_pts: cur_loops.append(cur_pts)
            cur_pts=[]; cur_2d=(0.0,0.0)
        elif cmd==LINE:
            if p[0]<0 or p[1]<0: continue
            if sketch_idx<len(sk_metas):
                sm=sk_metas[sketch_idx]
                ex=_dequant(p[0], sm["xy_min"][0], sm["xy_max"][0])
                ey=_dequant(p[1], sm["xy_min"][1], sm["xy_max"][1])
                cur_pts.append(sm["origin"] + ex*sm["x_axis"] + ey*sm["y_axis"])
                cur_2d=(ex,ey)
        elif cmd==ARC:
            if any(p[i]<0 for i in range(4)): continue
            if sketch_idx<len(sk_metas):
                sm=sk_metas[sketch_idx]
                mx=_dequant(p[0], sm["xy_min"][0], sm["xy_max"][0])
                my=_dequant(p[1], sm["xy_min"][1], sm["xy_max"][1])
                ex=_dequant(p[2], sm["xy_min"][0], sm["xy_max"][0])
                ey=_dequant(p[3], sm["xy_min"][1], sm["xy_max"][1])
                sx,sy=cur_2d
                a2d=_arc_pts(sx,sy, mx,my, ex,ey)
                for ax2,ay2 in a2d[1:]:
                    cur_pts.append(sm["origin"] + ax2*sm["x_axis"] + ay2*sm["y_axis"])
                cur_2d=(ex,ey)
        elif cmd==CIRCLE:
            if any(p[i]<0 for i in range(3)): continue
            if sketch_idx<len(sk_metas):
                sm=sk_metas[sketch_idx]
                cx=_dequant(p[0], sm["xy_min"][0], sm["xy_max"][0])
                cy=_dequant(p[1], sm["xy_min"][1], sm["xy_max"][1])
                r=(p[2]/QMAX)*sm["sk_scale"]
                for x2,y2 in _circle_pts(cx,cy,r):
                    cur_pts.append(sm["origin"] + x2*sm["x_axis"] + y2*sm["y_axis"])
        elif cmd==EXT:
            if cur_pts: cur_loops.append(cur_pts)
            cur_pts=[]
            if cur_loops and sketch_idx<len(sk_metas):
                sm=sk_metas[sketch_idx]
                e1_val=_dequant(p[P_E1], 0, max_ext)
                normal=sm["z_axis"]/(np.linalg.norm(sm["z_axis"])+1e-12)
                vl=[lp for lp in cur_loops if len(lp)>=2]
                if vl:
                    sketches.append({"loops_3d":vl, "normal":normal, "extent":e1_val})
            cur_loops=[]; sketch_idx+=1
        elif cmd==EOS: break
    return sketches
# ══════════════════════════════════════════════════════════════
# ★ Edge-descriptor extractor (fig 9 전용)
#   polyline으로 세분화하기 전, 토큰 원본 그대로 edge 단위 정보 추출.
#   각 edge를 "Line / Arc / Circle" 타입 + 실측값(mm) 으로 반환.
# ══════════════════════════════════════════════════════════════
def tokens_to_edge_descriptors(tokens: np.ndarray, dq_meta: dict):
    """
    Returns: list of sketches, each:
      {
        "sketch_idx": int,
        "sk_meta":    {...},                  # dequant meta
        "normal":     np.array(3),            # plane normal
        "extent":     float (mm),             # extrude height
        "loops": [                            # 각 loop = 여러 edge
          [
            {"type":"Line",   "p1":(x1,y1,z1), "p2":(x2,y2,z2),  "length": mm},
            {"type":"Arc",    "p1":(x1,y1,z1), "mid":(...), "p2":(...),
                              "arc_length": mm, "radius": mm},
            {"type":"Circle", "center":(x,y,z), "radius": mm, "circumference": mm},
          ],
          [...],
        ]
      }
    """
    if dq_meta is None:
        return []
    sk_metas = dq_meta["sketches"]
    max_ext  = dq_meta["max_ext"]

    sketches = []
    sketch_idx = 0
    cur_loops = []                 # [ [edge, edge, ...], ... ]
    cur_edges = []                 # current loop's edges
    cur_2d    = None               # 현재 pen position (2D local)
    loop_start_2d = None           # SOL 이후 첫 점

    def _to_3d(sm, x2d, y2d):
        return tuple(sm["origin"] + x2d*sm["x_axis"] + y2d*sm["y_axis"])

    for row in tokens:
        cmd = int(row[0]); p = row[1:]

        if cmd == SOL:
            if cur_edges:
                cur_loops.append(cur_edges)
            cur_edges = []
            cur_2d = None
            loop_start_2d = None

        elif cmd == LINE and sketch_idx < len(sk_metas):
            if p[0] < 0 or p[1] < 0: continue
            sm = sk_metas[sketch_idx]
            ex = _dequant(p[0], sm["xy_min"][0], sm["xy_max"][0])
            ey = _dequant(p[1], sm["xy_min"][1], sm["xy_max"][1])
            if cur_2d is None:
                # 첫 LINE — 시작점 없음 (원본 DeepCAD에서는 SOL 뒤 첫 edge가 시작점 역할)
                cur_2d = (ex, ey)
                loop_start_2d = (ex, ey)
                continue
            sx, sy = cur_2d
            p1_3d = _to_3d(sm, sx, sy)
            p2_3d = _to_3d(sm, ex, ey)
            length = float(np.linalg.norm(np.array(p2_3d) - np.array(p1_3d)))
            cur_edges.append({
                "type": "Line", "p1": p1_3d, "p2": p2_3d, "length": length,
            })
            cur_2d = (ex, ey)

        elif cmd == ARC and sketch_idx < len(sk_metas):
            if any(p[i] < 0 for i in range(4)): continue
            sm = sk_metas[sketch_idx]
            mx = _dequant(p[0], sm["xy_min"][0], sm["xy_max"][0])
            my = _dequant(p[1], sm["xy_min"][1], sm["xy_max"][1])
            ex = _dequant(p[2], sm["xy_min"][0], sm["xy_max"][0])
            ey = _dequant(p[3], sm["xy_min"][1], sm["xy_max"][1])
            if cur_2d is None:
                # Arc가 첫 edge (비정상이지만 방어): 시작점만 설정하고 skip
                cur_2d = (mx, my); loop_start_2d = (mx, my)
                continue
            sx, sy = cur_2d
            # 3-point arc → center/radius/arc length 계산
            # 평면 2D에서 시작/중간/끝 3점으로 외접원 center 구하기
            try:
                A = np.array([[2*(mx-sx), 2*(my-sy)],
                              [2*(ex-mx), 2*(ey-my)]], dtype=float)
                b = np.array([mx*mx + my*my - sx*sx - sy*sy,
                              ex*ex + ey*ey - mx*mx - my*my], dtype=float)
                if abs(np.linalg.det(A)) < 1e-10:
                    # 거의 직선 → Line으로 처리
                    p1_3d = _to_3d(sm, sx, sy)
                    p2_3d = _to_3d(sm, ex, ey)
                    length = float(np.linalg.norm(np.array(p2_3d) - np.array(p1_3d)))
                    cur_edges.append({
                        "type": "Line", "p1": p1_3d, "p2": p2_3d, "length": length,
                    })
                else:
                    c_xy = np.linalg.solve(A, b)
                    cx2d, cy2d = c_xy[0], c_xy[1]
                    r_2d = float(np.sqrt((sx-cx2d)**2 + (sy-cy2d)**2))
                    # arc angle: start→end를 mid 방향으로
                    a_s = math.atan2(sy-cy2d, sx-cx2d)
                    a_m = math.atan2(my-cy2d, mx-cx2d)
                    a_e = math.atan2(ey-cy2d, ex-cx2d)
                    # 회전 방향 판정 (CCW/CW)
                    def _wrap(a):
                        while a >  math.pi: a -= 2*math.pi
                        while a <= -math.pi: a += 2*math.pi
                        return a
                    sweep_ccw = _wrap(a_e - a_s)
                    if sweep_ccw == 0: sweep_ccw = 2*math.pi
                    # mid가 CCW 방향에 있는지 확인
                    mid_ccw = _wrap(a_m - a_s)
                    if (sweep_ccw > 0 and not (0 < mid_ccw < sweep_ccw)) or \
                       (sweep_ccw < 0 and not (sweep_ccw < mid_ccw < 0)):
                        # reverse direction
                        sweep = sweep_ccw - (2*math.pi if sweep_ccw > 0 else -2*math.pi)
                    else:
                        sweep = sweep_ccw
                    arc_len = abs(sweep) * r_2d

                    # scale을 x_axis/y_axis로 3D에 반영 (x_axis, y_axis가 unit이면 그대로)
                    # 일반적으로 sketch plane axes는 unit vector라 r_2d ≈ r_3d
                    p1_3d  = _to_3d(sm, sx, sy)
                    mid_3d = _to_3d(sm, mx, my)
                    p2_3d  = _to_3d(sm, ex, ey)
                    cur_edges.append({
                        "type": "Arc",
                        "p1": p1_3d, "mid": mid_3d, "p2": p2_3d,
                        "arc_length": float(arc_len),
                        "radius":     float(r_2d),
                        "sweep_deg":  float(math.degrees(abs(sweep))),
                    })
            except Exception:
                # fallback to line
                p1_3d = _to_3d(sm, sx, sy)
                p2_3d = _to_3d(sm, ex, ey)
                length = float(np.linalg.norm(np.array(p2_3d) - np.array(p1_3d)))
                cur_edges.append({
                    "type": "Line", "p1": p1_3d, "p2": p2_3d, "length": length,
                })
            cur_2d = (ex, ey)

        elif cmd == CIRCLE and sketch_idx < len(sk_metas):
            if any(p[i] < 0 for i in range(3)): continue
            sm = sk_metas[sketch_idx]
            cx = _dequant(p[0], sm["xy_min"][0], sm["xy_max"][0])
            cy = _dequant(p[1], sm["xy_min"][1], sm["xy_max"][1])
            r  = (p[2]/QMAX) * sm["sk_scale"]
            c_3d = _to_3d(sm, cx, cy)
            cur_edges.append({
                "type": "Circle", "center": c_3d,
                "radius": float(r), "circumference": float(2*math.pi*r),
            })
            cur_2d = None   # 원 하나로 loop 끝; 다음 SOL 전까지 reset

        elif cmd == EXT:
            if cur_edges:
                cur_loops.append(cur_edges)
                cur_edges = []
            if cur_loops and sketch_idx < len(sk_metas):
                sm = sk_metas[sketch_idx]
                e1_val = _dequant(p[P_E1], 0, max_ext)
                normal = sm["z_axis"] / (np.linalg.norm(sm["z_axis"]) + 1e-12)
                sketches.append({
                    "sketch_idx": sketch_idx,
                    "sk_meta":    sm,
                    "normal":     normal,
                    "extent":     float(e1_val),
                    "loops":      [lp for lp in cur_loops if len(lp) >= 1],
                })
            cur_loops = []
            sketch_idx += 1

        elif cmd == EOS:
            break

    return sketches


