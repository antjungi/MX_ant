def causal_mask(sz, device):
    return torch.triu(
        torch.full((sz, sz), float("-inf"), device=device),
        diagonal=1,
    )


def trim_after_eos(tokens):
    if tokens.ndim != 2 or tokens.shape[1] != 17:
        return tokens

    v = []
    for i in range(tokens.shape[0]):
        c = int(tokens[i, 0])
        if c < 0:
            break
        v.append(tokens[i])
        if c == EOS:
            break

    return np.stack(v, 0).astype(np.int32) if v else np.zeros((0, 17), dtype=np.int32)


def ensure_eos_when_truncated(t, ml):
    if t.shape[0] <= ml:
        return t.astype(np.int32)

    out = t[:ml].copy().astype(np.int32)
    r = np.full((17,), PAD_V, dtype=np.int32)
    r[0] = EOS
    out[-1] = r
    return out


class _Tee:
    def __init__(self, *streams):
        self.streams = streams

    def write(self, s):
        for st in self.streams:
            try:
                st.write(s)
                st.flush()
            except Exception:
                pass

    def flush(self):
        for st in self.streams:
            try:
                st.flush()
            except Exception:
                pass

    def isatty(self):
        return False


