class JointDataset(Dataset):
    def __init__(
        self,
        npy_files,
        max_len,
        sparam_array,
        sparam_mean,
        sparam_std,
        type_ids=None,
        type_names=None,
    ):
        self.max_len = max_len
        self.npy_files = list(npy_files)
        self.raw = []
        self.padded = []
        self.json_files = []

        for f in self.npy_files:
            jf = f.replace("_tokens.npy", "_deepcad.json")
            self.json_files.append(jf if os.path.exists(jf) else None)

        for f in self.npy_files:
            t = np.load(f).astype(np.int32)
            t = ensure_eos_when_truncated(t, max_len)
            self.raw.append(t)
            self.padded.append(self._pad(t))

        self.sparam = ((sparam_array - sparam_mean) / (sparam_std + 1e-8)).astype(np.float32)
        self.sparam_raw = sparam_array.astype(np.float32)

        max_cmd = -1
        max_prm = -1

        for t in self.raw:
            if t.size == 0:
                continue

            cmd_col = t[:, 0]
            prm_col = t[:, 1:]

            cmd_valid = cmd_col[cmd_col >= 0]
            prm_valid = prm_col[prm_col >= 0]

            if cmd_valid.size:
                max_cmd = max(max_cmd, int(cmd_valid.max()))
            if prm_valid.size:
                max_prm = max(max_prm, int(prm_valid.max()))

        if max_cmd >= N_CMD:
            raise ValueError(
                f"\n  [데이터 검증 실패] cmd 토큰값 max={max_cmd} ≥ N_CMD({N_CMD})"
            )

        if max_prm >= N_QUANT:
            raise ValueError(
                f"\n  [데이터 검증 실패] param 토큰값 max={max_prm} ≥ N_QUANT({N_QUANT})\n"
                f"  학습 코드 N_BIT={N_BIT}, 허용 범위=[0..{N_QUANT - 1}]\n"
                f"  추출 코드의 N_BIT와 학습 코드의 N_BIT가 다릅니다."
            )

        N = len(self.raw)

        if type_ids is None:
            self.type_ids = np.zeros(N, dtype=np.int64)
        else:
            self.type_ids = np.asarray(type_ids, dtype=np.int64)
            assert len(self.type_ids) == N

        self.type_names = list(type_names) if type_names else ["typeA"]

        dist = ", ".join(
            f"{n}:{int((self.type_ids == i).sum())}"
            for i, n in enumerate(self.type_names)
        )

        print(f"  ✓ {N}개 시퀀스 + Return-3 S-param 로드  (type 분포: {dist})")
        print(
            f"    토큰 범위: cmd∈[0..{max_cmd}]  param∈[0..{max_prm}]  "
            f"(허용 N_QUANT={N_QUANT}, N_BIT={N_BIT})"
        )
        print(f"    S-param target shape: {self.sparam.shape}")

    def _pad(self, t):
        L = t.shape[0]
        if L >= self.max_len:
            return t[:self.max_len].astype(np.float32)

        return np.concatenate(
            [t, np.full((self.max_len - L, 17), PAD_V, dtype=np.float32)],
            axis=0,
        ).astype(np.float32)

    def load_json(self, idx):
        jf = self.json_files[idx]
        if jf is None:
            return None
        try:
            with open(jf, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return None

    def __len__(self):
        return len(self.padded)

    def __getitem__(self, idx):
        return (
            torch.tensor(self.padded[idx], dtype=torch.float32),
            torch.tensor(self.sparam[idx], dtype=torch.float32),
            torch.tensor(int(self.type_ids[idx]), dtype=torch.long),
        )

    @staticmethod
    def shuffle_structures_padded(padded):
        L = padded.shape[0]
        structures = []
        current = []
        trailing = []

        seen_eos = False

        for i in range(L):
            c = int(padded[i, 0])

            if seen_eos or c < 0:
                trailing.append(padded[i])
                continue

            if c == EOS:
                if current:
                    structures.append(np.stack(current, 0))
                    current = []
                trailing.append(padded[i])
                seen_eos = True
                continue

            if c == SOL and current:
                structures.append(np.stack(current, 0))
                current = [padded[i]]
            else:
                current.append(padded[i])

        if current:
            structures.append(np.stack(current, 0))

        if len(structures) >= 2:
            np.random.shuffle(structures)

        parts = structures[:]
        if trailing:
            parts.append(np.stack(trailing, 0))

        result = np.concatenate(parts, axis=0) if parts else padded

        if result.shape[0] != L:
            if result.shape[0] < L:
                pad = np.full((L - result.shape[0], 17), PAD_V, dtype=np.float32)
                result = np.concatenate([result, pad], axis=0)
            else:
                result = result[:L]

        return result.astype(np.float32)


class AugmentedSubset(Dataset):
    def __init__(self, dataset, indices, augment=False):
        self.dataset = dataset
        self.indices = list(indices)
        self.augment = augment

    def __len__(self):
        return len(self.indices)

    def __getitem__(self, i):
        idx = self.indices[i]
        padded = self.dataset.padded[idx]

        if self.augment:
            padded = self.dataset.shuffle_structures_padded(padded.copy())

        return (
            torch.tensor(padded, dtype=torch.float32),
            torch.tensor(self.dataset.sparam[idx], dtype=torch.float32),
            torch.tensor(int(self.dataset.type_ids[idx]), dtype=torch.long),
        )


