@torch.no_grad()
def diagnose_reconstruction(ae, dataset, indices, device, max_samples=8):
    section("[DIAG] Reconstruction Quality")

    ae.eval()

    sel = indices[:max_samples]

    cmd_correct = 0
    cmd_total = 0
    nstruct_match = 0
    nstruct_tot = 0
    param_abs_err = []

    for si in sel:
        x = torch.tensor(dataset.padded[si], dtype=torch.float32).unsqueeze(0).to(device)

        z = ae.encode(x)
        gen = ae.generate(z, max_gen_len=dataset.max_len)

        recon = trim_after_eos(gen[0].cpu().numpy().astype(np.int32))
        orig = trim_after_eos(dataset.raw[si])

        L = min(len(orig), len(recon))

        if L > 0:
            cmd_correct += int((orig[:L, 0] == recon[:L, 0]).sum())
            cmd_total += L

        no = int((orig[:, 0] == SOL).sum()) if len(orig) > 0 else 0
        nr = int((recon[:, 0] == SOL).sum()) if len(recon) > 0 else 0

        nstruct_tot += 1
        if no == nr:
            nstruct_match += 1

        for i in range(L):
            if orig[i, 0] == recon[i, 0] and orig[i, 0] >= 0:
                for k in range(1, 17):
                    if orig[i, k] >= 0 and recon[i, k] >= 0:
                        param_abs_err.append(abs(int(orig[i, k]) - int(recon[i, k])))

    cmd_acc = cmd_correct / max(cmd_total, 1)
    pa_mean = sum(param_abs_err) / len(param_abs_err) if param_abs_err else 0.0

    print(f"  Samples evaluated          : {len(sel)}")
    print(f"  Cmd accuracy aligned       : {cmd_correct}/{cmd_total} = {cmd_acc * 100:.2f}%")
    print(f"  Struct count match         : {nstruct_match}/{nstruct_tot}")
    print(f"  Param MAE quant 0..{QMAX}  : {pa_mean:.2f}")
    print(f"  Param MAE normalized       : {pa_mean / QMAX:.4f}")


