#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Single inverse-design demo.

Goal:
  Generate one antenna candidate that covers the requested frequencies.
  Each target band may choose its best return channel, but the final design should
  prefer using distinct return channels across the requested bands.

Modified:
  Stronger inverse optimization settings for more reliable target search.
  Prints elapsed time before showing result figures.
"""

import contextlib
import io
import os
import signal
import time
import warnings
from datetime import datetime

import numpy as np
import torch
from mpl_toolkits.mplot3d.art3d import Poly3DCollection

import AE_main as stp
import AE_main_test_utils as tools
import AE_main_test_v2 as inverse


# =============================================================================
# Demo Target Settings
# =============================================================================

TARGET_FREQUENCIES_GHZ = (2.0, 3.0, 4.0)
TARGET_BANDWIDTH_MHZ = 200.0
TARGET_RETURN_LOSS_DB = -15.0

# surrogate에서 더 안전하게 찾고 싶으면 1~3 dB 정도 margin을 줄 수 있음.
# 예:
#   TARGET_RETURN_LOSS_DB = -15.0
#   SURROGATE_SAFETY_MARGIN_DB = 2.0
# 이면 실제 optimizer는 -17 dB를 목표로 찾음.
#
# 지금은 spec 그대로 -15 dB를 목표로 둠.
SURROGATE_SAFETY_MARGIN_DB = 0.0


# =============================================================================
# Strong Optimization Settings
# =============================================================================
# 기존 demo/check용보다 훨씬 강하게 탐색하도록 설정.
#
# GPU 메모리 부족 시 가장 먼저 줄일 것:
#   STRONG_N_STARTS = 64
#
# 시간이 너무 오래 걸리면 줄일 것:
#   STRONG_N_ITERS = 4000
#   STRONG_MAX_TARGET_RETRIES = 3

STRONG_MAX_TARGET_RETRIES = 6

STRONG_N_STARTS = 128
STRONG_N_ITERS = 6000
STRONG_LR = 3e-2

STRONG_IN_BAND_WEIGHT = 40.0
STRONG_OUT_BAND_WEIGHT = 0.03

STRONG_Z_PRIOR_WEIGHT = 3e-4
STRONG_Z_PRIOR_WEIGHT_END = 1e-6

STRONG_COSINE_LR = True
STRONG_LR_MIN_RATIO = 0.02

STRONG_EARLY_STOP_PATIENCE = 1000

STRONG_RESTART_PATIENCE = 250
STRONG_RESTART_FRAC = 0.35
STRONG_RESTART_NOISE = 0.25
STRONG_MAX_RESTARTS = 20

# 서로 다른 target band가 같은 S-port 하나에 몰리는 것을 줄이기 위한 weight.
# 너무 강하게 강제하지 않고, 기존 batch 설정의 3배 정도만 사용.
PORT_DIVERSITY_MULTIPLIER = 3.0


# =============================================================================
# Demo Runner Settings
# =============================================================================

RESULT_ROOT = "AE_inverse_design_demo_outputs"
SHOW_RESULT_WINDOWS = True
SHOW_STEP_PREVIEW = True


# =============================================================================
# Helper
# =============================================================================

def _safe_setattr(obj, name, value):
    """argparse.Namespace, SimpleNamespace, dataclass-style args 모두 최대한 안전하게 설정."""
    try:
        setattr(obj, name, value)
    except Exception:
        pass


def format_elapsed(seconds):
    """초 단위 경과 시간을 h/m/s 문자열로 변환."""
    seconds = float(seconds)
    h = int(seconds // 3600)
    m = int((seconds % 3600) // 60)
    s = seconds % 60.0
    return f"{h}h {m}m {s:.1f}s"


def build_demo_args():
    args = inverse.make_batch_args()

    # -------------------------------------------------------------------------
    # Basic target setting
    # -------------------------------------------------------------------------
    args.n_targets = 1
    args.coverage_freqs_ghz = tuple(float(x) for x in TARGET_FREQUENCIES_GHZ)
    args.bandwidth_ghz = float(TARGET_BANDWIDTH_MHZ) / 1000.0

    # 실제 optimizer가 보는 목표 dB.
    # safety margin을 주면 -15 dB spec을 위해 -17 dB 같은 더 빡센 목표로 탐색 가능.
    args.deep_db = float(TARGET_RETURN_LOSS_DB - SURROGATE_SAFETY_MARGIN_DB)

    # target band 개수만큼 distinct port 사용을 유도.
    # 1개 band면 1개 port, 2개 band면 2개 port, 3개 이상이면 최대 3개 port.
    args.coverage_required_ports = min(3, len(args.coverage_freqs_ghz))

    # port diversity 강화.
    # 단, 마지막에 넣었던 복잡한 외부 retry/강제 분배 로직은 제거.
    args.coverage_port_diversity_weight = float(
        inverse.BATCH_PORT_DIVERSITY_WEIGHT * PORT_DIVERSITY_MULTIPLIER
    )

    args.preferred_type_cycle = False

    # -------------------------------------------------------------------------
    # Strong inverse optimization setting
    # -------------------------------------------------------------------------
    # 실패 시 같은 target을 여러 번 다시 시도.
    args.max_target_retries = int(STRONG_MAX_TARGET_RETRIES)

    # 동시에 최적화할 latent 후보 수.
    args.n_starts = int(STRONG_N_STARTS)

    # optimization iteration 수.
    args.n_iters = int(STRONG_N_ITERS)

    # latent optimization learning rate.
    args.lr = float(STRONG_LR)

    # target band 안에서 return loss spec을 만족하도록 강제하는 weight.
    args.in_band_weight = float(STRONG_IN_BAND_WEIGHT)

    # target band 밖 curve가 너무 비정상적으로 변하는 것을 약하게 억제.
    args.out_band_weight = float(STRONG_OUT_BAND_WEIGHT)

    # latent prior.
    # 너무 크면 정상 geometry는 잘 나오지만 target 탐색이 어려워짐.
    # 너무 작으면 target은 잘 찾지만 이상한 geometry가 나올 수 있음.
    args.z_prior_weight = float(STRONG_Z_PRIOR_WEIGHT)
    args.z_prior_weight_end = float(STRONG_Z_PRIOR_WEIGHT_END)

    # cosine learning-rate schedule.
    args.cosine_lr = bool(STRONG_COSINE_LR)
    args.lr_min_ratio = float(STRONG_LR_MIN_RATIO)

    # best 개선이 없더라도 너무 빨리 멈추지 않도록 patience 증가.
    args.early_stop_patience = int(STRONG_EARLY_STOP_PATIENCE)

    # stagnation 시 나쁜 latent 후보들을 restart.
    args.restart_patience = int(STRONG_RESTART_PATIENCE)
    args.restart_frac = float(STRONG_RESTART_FRAC)
    args.restart_noise = float(STRONG_RESTART_NOISE)
    args.max_restarts = int(STRONG_MAX_RESTARTS)

    # -------------------------------------------------------------------------
    # Compatibility aliases
    # -------------------------------------------------------------------------
    # AE_main_test_v2 내부에서 변수명이 다를 가능성에 대비해서 alias도 같이 설정.
    # 이미 같은 이름을 쓰고 있으면 그대로 유효하고, 안 쓰는 이름이면 harmless.
    _safe_setattr(args, "inv_n_starts", int(STRONG_N_STARTS))
    _safe_setattr(args, "inv_n_iters", int(STRONG_N_ITERS))
    _safe_setattr(args, "inv_lr", float(STRONG_LR))
    _safe_setattr(args, "inv_in_band_weight", float(STRONG_IN_BAND_WEIGHT))
    _safe_setattr(args, "inv_out_band_weight", float(STRONG_OUT_BAND_WEIGHT))
    _safe_setattr(args, "inv_z_prior_weight", float(STRONG_Z_PRIOR_WEIGHT))
    _safe_setattr(args, "inv_z_prior_weight_end", float(STRONG_Z_PRIOR_WEIGHT_END))
    _safe_setattr(args, "inv_cosine_lr", bool(STRONG_COSINE_LR))
    _safe_setattr(args, "inv_lr_min_ratio", float(STRONG_LR_MIN_RATIO))
    _safe_setattr(args, "inv_early_stop_patience", int(STRONG_EARLY_STOP_PATIENCE))
    _safe_setattr(args, "inv_restart_patience", int(STRONG_RESTART_PATIENCE))
    _safe_setattr(args, "inv_restart_frac", float(STRONG_RESTART_FRAC))
    _safe_setattr(args, "inv_restart_noise", float(STRONG_RESTART_NOISE))
    _safe_setattr(args, "inv_max_restarts", int(STRONG_MAX_RESTARTS))

    # -------------------------------------------------------------------------
    # Output / visualization
    # -------------------------------------------------------------------------
    args.save_figures = True
    args.clean_dir_name = "clean_topviews"
    args.show_latent_trajectory = True

    return args


def configure_plot_backend():
    if not SHOW_RESULT_WINDOWS:
        try:
            stp.plt.switch_backend("Agg")
        except Exception:
            pass
        return

    if "agg" not in stp.plt.get_backend().lower():
        return

    for backend in ("TkAgg", "Qt5Agg", "Qt6Agg", "wxAgg"):
        try:
            stp.plt.switch_backend(backend)
            return
        except Exception:
            continue


def print_target(args):
    half_bw_mhz = args.bandwidth_ghz * 500.0
    bands = [
        f"{f:.2f} GHz +/- {half_bw_mhz:.0f} MHz"
        for f in args.coverage_freqs_ghz
    ]

    print("\n[Target]")
    print(f"  requested spec : best channel <= {TARGET_RETURN_LOSS_DB:.1f} dB")
    print(f"  optimizer spec : best channel <= {args.deep_db:.1f} dB")
    print(f"  bands          : {', '.join(bands)}")
    print(f"  required ports : {args.coverage_required_ports} distinct S-port(s)")

    if SURROGATE_SAFETY_MARGIN_DB > 0:
        print(f"  safety margin  : {SURROGATE_SAFETY_MARGIN_DB:.1f} dB")


