def _parse_sparam_pair_general(name: str):
    """
    다양한 S-param 컬럼명에서 port pair 추출.

    지원 예:
      re(St(port1,port1)) []
      im(St(port2,port2)) []
      re(S(1,1))
      im(S11)
      re(S33)
    """
    s = str(name).lower().replace(" ", "")

    m = re.search(r"port(\d+),port(\d+)", s)
    if m:
        return int(m.group(1)), int(m.group(2))

    m = re.search(r"port(\d+)port(\d+)", s)
    if m:
        return int(m.group(1)), int(m.group(2))

    m = re.search(r"s\((\d+),(\d+)\)", s)
    if m:
        return int(m.group(1)), int(m.group(2))

    m = re.search(r"s(\d)(\d)", s)
    if m:
        return int(m.group(1)), int(m.group(2))

    return None


def _is_re_col(name: str):
    return str(name).strip().lower().startswith("re(")


def _is_im_col(name: str):
    return str(name).strip().lower().startswith("im(")


def filter_return3_sparams(
    sparam_all,
    sparam_names,
    return_pairs=RETURN_PORT_PAIRS,
    verbose=True,
):
    """
    전체 S-param 중 return 3개만 남김:
      S11, S22, S33

    입력:
      sparam_all   : (N, n_freq, n_cols)
      sparam_names : 전체 컬럼명 리스트

    출력:
      sparam_return : (N, n_freq, 6)
      names_return  : re/im 포함 6개 컬럼명
    """
    pair_to_cols = {}

    for i, name in enumerate(sparam_names):
        pair = _parse_sparam_pair_general(name)
        if pair is None:
            continue

        pair_to_cols.setdefault(pair, {"re": None, "im": None})

        if _is_re_col(name):
            pair_to_cols[pair]["re"] = i
        elif _is_im_col(name):
            pair_to_cols[pair]["im"] = i

    selected_cols = []
    selected_names = []

    for pair in return_pairs:
        if pair not in pair_to_cols:
            raise ValueError(
                f"S{pair[0]}{pair[1]} 컬럼을 찾지 못했습니다.\n"
                f"현재 컬럼명:\n{sparam_names}"
            )

        re_idx = pair_to_cols[pair]["re"]
        im_idx = pair_to_cols[pair]["im"]

        if re_idx is None or im_idx is None:
            raise ValueError(
                f"S{pair[0]}{pair[1]}의 re/im 컬럼이 모두 필요합니다.\n"
                f"찾은 값: re={re_idx}, im={im_idx}\n"
                f"현재 컬럼명:\n{sparam_names}"
            )

        selected_cols.extend([re_idx, im_idx])
        selected_names.extend([sparam_names[re_idx], sparam_names[im_idx]])

    out = sparam_all[:, :, selected_cols]

    if verbose:
        print("\n  ✓ Return-3 S-param filtering")
        print("    target: S11, S22, S33 only")
        print(f"    before shape: {sparam_all.shape}")
        print(f"    after  shape: {out.shape}")
        print("    selected columns:")
        for n in selected_names:
            print(f"      {n}")

    return out, selected_names


def reim_to_mag_db(reim, names):
    n_pair = len(names) // 2
    ms = []
    ns = []

    for i in range(n_pair):
        r = reim[:, 2 * i]
        im = reim[:, 2 * i + 1]

        ms.append(20 * np.log10(np.clip(np.sqrt(r ** 2 + im ** 2), 1e-12, None)))

        pair = _parse_sparam_pair_general(names[2 * i])
        if pair is not None:
            ns.append(f"S{pair[0]}{pair[1]}")
        else:
            raw = names[2 * i]
            c = raw.replace("re(", "").replace("Re(", "").replace("(", "").replace(")", "")
            c = c.replace(",", "").replace(" ", "")
            ns.append(c)

    return np.stack(ms, -1), ns


def diagonal_channel_mask(channel_names):
    mask = []
    for nm in channel_names:
        pair = _parse_sparam_pair_general(nm)
        if pair is not None:
            mask.append(pair[0] == pair[1])
            continue

        m = re.search(r"s(\d)(\d)", str(nm).lower())
        if m:
            mask.append(m.group(1) == m.group(2))
        else:
            mask.append(True)  # return3 filter 이후에는 보통 전부 diagonal
    return np.array(mask, dtype=bool)


def _compute_s11_min_db(sparam_all, sparam_names):
    ref_idx = None

    for i in range(0, len(sparam_names), 2):
        pair = _parse_sparam_pair_general(sparam_names[i])
        if pair == (1, 1):
            ref_idx = i
            break

    if ref_idx is None:
        return None, None

    re_col = sparam_all[:, :, ref_idx]
    im_col = sparam_all[:, :, ref_idx + 1]
    mag = 20 * np.log10(np.clip(np.sqrt(re_col ** 2 + im_col ** 2), 1e-12, None))
    return mag.min(axis=1), "|S11|_min (dB)"


