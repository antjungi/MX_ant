def load_design_vars_csv(npy_files, csv_path):
    if pd is None:
        raise ImportError("pandas 필요: pip install pandas")

    if not os.path.exists(csv_path):
        raise FileNotFoundError(
            f"\n  Design vars CSV 없음: {csv_path}\n"
            f"  포맷 예:\n"
            f"    filename,var1,var2,var3\n"
            f"    5679_tokens.npy,1.5,0.3,2.1"
        )

    df = pd.read_csv(csv_path)

    if df.shape[1] < 2:
        raise ValueError("CSV는 최소 filename + 1개 변수 컬럼이 필요합니다.")

    fname_col = df.columns[0]
    var_cols = list(df.columns[1:])

    df = df.set_index(fname_col)

    dv_list = []
    missing = []

    for f in npy_files:
        fname = os.path.basename(f)

        if fname not in df.index:
            missing.append(fname)
            continue

        dv_list.append(df.loc[fname].values.astype(np.float32))

    if missing:
        raise KeyError(
            f"\n  CSV에 없는 token 파일 {len(missing)}개:\n"
            f"    {missing[:5]}{'...' if len(missing) > 5 else ''}"
        )

    arr = np.stack(dv_list, 0)

    return arr, var_cols


class SparamMLP_Mode(nn.Module):
    def __init__(
        self,
        latent_dim,
        n_dv,
        n_freq,
        n_sparam,
        mode="z",
        hidden_mult=2.0,
        dropout=0.3,
    ):
        super().__init__()

        self.mode = mode

        if mode == "z":
            in_dim = latent_dim
        elif mode == "dv":
            in_dim = n_dv
        elif mode == "z_dv":
            in_dim = latent_dim + n_dv
        else:
            raise ValueError(f"unknown mode: {mode}")

        self.in_dim = in_dim
        self.n_freq = n_freq
        self.n_sparam = n_sparam

        out_dim = n_freq * n_sparam

        h1 = max(in_dim, 64)
        h2 = max(int(in_dim * hidden_mult), 64)

        self.net = nn.Sequential(
            nn.Linear(in_dim, h1),
            nn.LayerNorm(h1),
            nn.GELU(),
            nn.Dropout(dropout),

            nn.Linear(h1, h2),
            nn.LayerNorm(h2),
            nn.GELU(),
            nn.Dropout(dropout),

            nn.Linear(h2, out_dim),
        )

    def forward(self, z, dv):
        if self.mode == "z":
            x = z
        elif self.mode == "dv":
            x = dv
        elif self.mode == "z_dv":
            x = torch.cat([z, dv], dim=-1)
        else:
            raise ValueError(self.mode)

        return self.net(x).view(-1, self.n_freq, self.n_sparam)


def train_sparam_mlp_standalone(
    model,
    train_data,
    val_data,
    device,
    epochs=300,
    lr=1e-3,
    weight_decay=1e-3,
    batch_size=64,
    log_every=None,
    verbose=True,
):
    opt = torch.optim.AdamW(
        model.parameters(),
        lr=lr,
        weight_decay=weight_decay,
        betas=(0.9, 0.98),
    )

    z_tr, dv_tr, sp_tr = train_data["z"], train_data["dv"], train_data["sp"]
    z_va, dv_va, sp_va = val_data["z"], val_data["dv"], val_data["sp"]

    N_tr = z_tr.size(0)

    if log_every is None:
        log_every = max(1, epochs // 8)

    best = float("inf")
    best_state = None

    tr_hist = []
    va_hist = []

    for ep in range(1, epochs + 1):
        model.train()

        perm = torch.randperm(N_tr, device=device)

        tr_loss = 0.0
        n_b = 0

        for i in range(0, N_tr, batch_size):
            idx = perm[i:i + batch_size]

            opt.zero_grad(set_to_none=True)

            pred = model(z_tr[idx], dv_tr[idx])
            loss = F.mse_loss(pred, sp_tr[idx])

            loss.backward()
            opt.step()

            tr_loss += loss.item()
            n_b += 1

        tr_loss /= max(n_b, 1)

        model.eval()
        with torch.no_grad():
            va_pred = model(z_va, dv_va)
            va_loss = F.mse_loss(va_pred, sp_va).item()

        tr_hist.append(tr_loss)
        va_hist.append(va_loss)

        if va_loss < best:
            best = va_loss
            best_state = {
                k: v.detach().clone()
                for k, v in model.state_dict().items()
            }

        if verbose and (ep == 1 or ep % log_every == 0 or ep == epochs):
            print(
                f"      ep{ep:4d}/{epochs} "
                f"tr_ret3_mse={tr_loss:.5f} "
                f"va_ret3_mse={va_loss:.5f} "
                f"(best {best:.5f})"
            )

    if best_state is not None:
        model.load_state_dict(best_state)

    return model, best, tr_hist, va_hist


def evaluate_sparam_mlp_modes(
    model,
    val_data,
    sparam_mean,
    sparam_std,
    sparam_names,
    type_ids_va,
    type_names,
    device,
):
    model.eval()

    z_va, dv_va, sp_va = val_data["z"], val_data["dv"], val_data["sp"]

    sparam_mean = np.asarray(sparam_mean)
    sparam_std = np.asarray(sparam_std)

    with torch.no_grad():
        pred_norm = model(z_va, dv_va).cpu().numpy()

    sp_norm = sp_va.cpu().numpy()

    pred_real = pred_norm * (sparam_std + 1e-8) + sparam_mean
    true_real = sp_norm * (sparam_std + 1e-8) + sparam_mean

    type_ids_np = (
        type_ids_va.cpu().numpy()
        if torch.is_tensor(type_ids_va)
        else np.asarray(type_ids_va)
    )

    n_pairs = len(sparam_names) // 2

    result = {
        "per_type": {},
        "overall_rmse": None,
        "ch_labels": None,
    }

    overall_sq = 0.0
    overall_n = 0

    for ti, tname in enumerate(type_names):
        m = type_ids_np == ti

        if not m.any():
            continue

        pr = pred_real[m]
        tr = true_real[m]

        ch_sq = np.zeros(n_pairs)
        ch_n = 0
        ch_lbls = None

        for i in range(pr.shape[0]):
            pm, lbls = reim_to_mag_db(pr[i], sparam_names)
            tm, _ = reim_to_mag_db(tr[i], sparam_names)

            if ch_lbls is None:
                ch_lbls = lbls

            ch_sq += ((pm - tm) ** 2).sum(axis=0)
            ch_n += pm.shape[0]

        ch_rmse = np.sqrt(ch_sq / max(ch_n, 1))
        type_rmse = float(np.sqrt(ch_sq.sum() / max(ch_n * len(ch_lbls), 1)))

        overall_sq += ch_sq.sum()
        overall_n += ch_n * len(ch_lbls)

        result["per_type"][tname] = {
            "n": int(m.sum()),
            "ch_rmse": ch_rmse,
            "rmse": type_rmse,
        }

        if result["ch_labels"] is None:
            result["ch_labels"] = ch_lbls

    if overall_n > 0:
        result["overall_rmse"] = float(np.sqrt(overall_sq / overall_n))

    return result


def _print_ablation_summary(results_by_mode, type_names):
    section("ABLATION RESULT — Return-3 RMSE")

    print(
        f"  {'mode':<25s} "
        + "  ".join(f"{h:>10s}" for h in type_names)
        + f"  {'TOTAL':>10s}"
    )
    print("  " + "-" * (25 + 13 * (len(type_names) + 1)))

    for mode in ["z", "dv", "z_dv"]:
        if mode not in results_by_mode:
            continue

        r = results_by_mode[mode]
        per_t = r["per_type"]

        cells = [
            f"{per_t.get(tn, {}).get('rmse', float('nan')):>10.3f}"
            for tn in type_names
        ]

        total = r["overall_rmse"] or float("nan")

        print(
            f"  {NAME_MODE[mode]:<25s} "
            + "  ".join(cells)
            + f"  {total:>10.3f}"
        )


def run_ablation(
    cfg,
    design_vars_csv,
    mlp_epochs=300,
    mlp_batch_size=64,
    mlp_lr=1e-3,
    dv_normalize=True,
):
    apply_preset(cfg)
    set_seed(cfg.seed)

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    script_dir = os.path.dirname(os.path.abspath(__file__))

    section("HYBRID ABLATION — z vs design_vars vs both")
    print(f"  Device     : {device}" + (f" ({torch.cuda.get_device_name(0)})" if device.type == "cuda" else ""))
    print(f"  Design CSV : {design_vars_csv}")

    section("[1/5] Token + Return-3 S-param data loading")

    (
        dataset,
        npy_files,
        type_ids_arr,
        type_names,
        sparam_all,
        sparam_names,
        sparam_mean,
        sparam_std,
        n_sparam,
        max_len,
    ) = load_multitype_return3_data(cfg, script_dir, verbose=False)

    # 여기까지 오면 run_ablation도 이미 return3만 남긴 상태
    if n_sparam != 6:
        print(f"  ⚠ n_sparam={n_sparam}, expected=6.")

    n_types = len(type_names)
    n_use = len(dataset)

    section("[2/5] Design vars loading")

    dv_all_raw, dv_names = load_design_vars_csv(npy_files, design_vars_csv)

    print(f"  shape: {dv_all_raw.shape}")
    print(f"  vars : {dv_names}")

    if dv_normalize:
        dv_mean = dv_all_raw.mean(axis=0)
        dv_std = dv_all_raw.std(axis=0) + 1e-8
        dv_all = (dv_all_raw - dv_mean) / dv_std
        print("  normalize: yes")
    else:
        dv_all = dv_all_raw
        print("  normalize: no")

    n_dv = dv_all.shape[1]

    section("[3/5] Train/Val split")

    rng = random.Random(cfg.seed)

    train_idx = []
    val_idx = []

    for ti in range(n_types):
        idx_t = [i for i in range(n_use) if int(type_ids_arr[i]) == ti]

        rng.shuffle(idx_t)

        n_val_t = max(1, int(len(idx_t) * cfg.val_ratio))

        val_idx.extend(idx_t[:n_val_t])
        train_idx.extend(idx_t[n_val_t:])

    rng.shuffle(train_idx)
    rng.shuffle(val_idx)

    print(f"  train={len(train_idx)} val={len(val_idx)}")

    section("[4/5] AE + MLP(z) joint training")

    ae = DeepCADBaselineAE(
        max_len=max_len,
        d_model=cfg.d_model,
        d_param=cfg.d_param,
        nhead=cfg.nhead,
        n_enc=cfg.n_enc,
        n_dec=cfg.n_dec,
        d_ff=cfg.d_ff,
        latent=cfg.latent,
        mem_tokens=cfg.mem_tokens,
        dropout=cfg.dropout,
        n_pool=cfg.n_pool,
        n_freq_bands=cfg.n_freq_bands,
        aux_numeric=cfg.aux_numeric,
        aux_hidden_mult=cfg.aux_hidden_mult,
    ).to(device)

    mlp_aux = SparamMLP(
        latent_dim=cfg.latent,
        n_freq=cfg.n_freq,
        n_sparam=n_sparam,
        hidden_mult=cfg.mlp_hidden_mult,
        dropout=cfg.mlp_dropout,
        n_types=n_types,
        type_emb_dim=cfg.type_emb_dim,
    ).to(device)

    train_set = AugmentedSubset(dataset, train_idx, augment=False)
    val_set = AugmentedSubset(dataset, val_idx, augment=False)

    train_loader = DataLoader(train_set, batch_size=cfg.batch_size, shuffle=True, num_workers=0)
    val_loader = DataLoader(val_set, batch_size=cfg.batch_size, shuffle=False, num_workers=0)

    opt = torch.optim.AdamW(
        [
            {"params": list(ae.parameters()), "lr": cfg.lr_ae},
            {"params": list(mlp_aux.parameters()), "lr": cfg.lr_mlp},
        ],
        weight_decay=cfg.weight_decay,
        betas=(0.9, 0.98),
    )

    def _lr_sched(ep):
        if ep < cfg.warmup:
            return (ep + 1) / max(1, cfg.warmup)
        return 0.5 * (1 + math.cos(math.pi * (ep - cfg.warmup) / max(1, cfg.epochs - cfg.warmup)))

    sch = torch.optim.lr_scheduler.LambdaLR(opt, _lr_sched)

    best_va = float("inf")
    best_ae_state = None

    log_every = max(1, cfg.epochs // 10)

    print(f"  epochs={cfg.epochs}, bs={cfg.batch_size}, lr_ae={cfg.lr_ae:.2e}")
    print(f"  target: Return-3 only, n_sparam={n_sparam}\n")

    print(f"  {'ep':>4s} | {'tr_tot':>8s} {'tr_ret3':>9s} {'tr_aux':>8s} | {'va_tot':>8s} {'va_ret3':>9s} {'va_aux':>8s}")
    print("  " + "-" * 80)

    for ep in range(1, cfg.epochs + 1):
        tr = run_joint_epoch(ae, mlp_aux, train_loader, opt, device, cfg, True)
        va = run_joint_epoch(ae, mlp_aux, val_loader, opt, device, cfg, False) if len(val_set) > 0 else tr

        sch.step()

        if va["total"] < best_va:
            best_va = va["total"]
            best_ae_state = {
                k: v.detach().clone().cpu()
                for k, v in ae.state_dict().items()
            }

        if ep == 1 or ep % log_every == 0 or ep == cfg.epochs:
            print(
                f"  {ep:4d} | "
                f"{tr['total']:8.4f} {tr['sp']:9.6f} {tr['aux']:8.5f} | "
                f"{va['total']:8.4f} {va['sp']:9.6f} {va['aux']:8.5f}"
            )

    if best_ae_state is not None:
        ae.load_state_dict({k: v.to(device) for k, v in best_ae_state.items()})

    print(f"\n  ✓ best val_total={best_va:.5f}")

    section("[5/5] Three-mode MLP training + comparison")

    print("  extract z from frozen AE")

    ae.eval()

    z_all = []

    loader_all = DataLoader(dataset, batch_size=32, shuffle=False, num_workers=0)

    with torch.no_grad():
        for batch in loader_all:
            tok_b = batch[0].to(device)
            z_all.append(ae.encode(tok_b).cpu())

    z_all = torch.cat(z_all, 0).float()

    print(f"  z_all: {tuple(z_all.shape)}")

    z_tr = z_all[train_idx].to(device)
    z_va = z_all[val_idx].to(device)

    dv_tr = torch.tensor(dv_all[train_idx], dtype=torch.float32, device=device)
    dv_va = torch.tensor(dv_all[val_idx], dtype=torch.float32, device=device)

    # sparam_all is already return3 only
    sp_norm_all = (sparam_all - sparam_mean) / (sparam_std + 1e-8)

    sp_tr = torch.tensor(sp_norm_all[train_idx], dtype=torch.float32, device=device)
    sp_va = torch.tensor(sp_norm_all[val_idx], dtype=torch.float32, device=device)

    type_va = torch.tensor(type_ids_arr[val_idx], dtype=torch.long, device=device)

    train_data = {
        "z": z_tr,
        "dv": dv_tr,
        "sp": sp_tr,
    }

    val_data = {
        "z": z_va,
        "dv": dv_va,
        "sp": sp_va,
    }

    results = {}
    histories = {}

    for mode in ["z", "dv", "z_dv"]:
        subsection(f"Mode = {mode} ({NAME_MODE[mode]})")

        torch.manual_seed(cfg.seed)
        np.random.seed(cfg.seed)
        random.seed(cfg.seed)

        model = SparamMLP_Mode(
            latent_dim=cfg.latent,
            n_dv=n_dv,
            n_freq=cfg.n_freq,
            n_sparam=n_sparam,
            mode=mode,
            hidden_mult=cfg.mlp_hidden_mult,
            dropout=cfg.mlp_dropout,
        ).to(device)

        n_params = sum(p.numel() for p in model.parameters())

        print(f"    in_dim={model.in_dim}, params={n_params:,}")

        model, best_va_mse, tr_h, va_h = train_sparam_mlp_standalone(
            model,
            train_data,
            val_data,
            device,
            epochs=mlp_epochs,
            lr=mlp_lr,
            weight_decay=cfg.weight_decay,
            batch_size=mlp_batch_size,
        )

        histories[mode] = (tr_h, va_h)

        r = evaluate_sparam_mlp_modes(
            model,
            val_data,
            sparam_mean,
            sparam_std,
            sparam_names,
            type_va,
            type_names,
            device,
        )

        results[mode] = r

        print(
            "    Return-3 RMSE: "
            + "  ".join(
                f"{tn}={r['per_type'][tn]['rmse']:.3f}"
                for tn in type_names
                if tn in r["per_type"]
            )
            + f"  TOTAL={r['overall_rmse']:.3f}"
        )

    _print_ablation_summary(results, type_names)

    fig_l, ax_l = plt.subplots(1, 2, figsize=(11, 4), facecolor="white")

    for mode in ["z", "dv", "z_dv"]:
        tr_h, va_h = histories[mode]

        ax_l[0].plot(
            range(1, len(tr_h) + 1),
            tr_h,
            lw=1.5,
            color=COLOR_MODE[mode],
            label=NAME_MODE[mode],
        )

        ax_l[1].plot(
            range(1, len(va_h) + 1),
            va_h,
            lw=1.5,
            color=COLOR_MODE[mode],
            label=NAME_MODE[mode],
        )

    for ax, title in [
        (ax_l[0], "Train Return-3 MSE"),
        (ax_l[1], "Val Return-3 MSE"),
    ]:
        ax.set_facecolor("white")
        ax.grid(True, alpha=0.2)
        ax.set_xlabel("epoch")
        ax.set_ylabel("MSE")
        ax.set_title(title)
        ax.legend(fontsize=8)
        ax.set_yscale("log")

    plt.tight_layout()

    section("DONE — Hybrid ablation complete")

    n_open = len(plt.get_fignums())
    print(f"  생성된 figure: {n_open} (backend={matplotlib.get_backend()})")

    if n_open > 0:
        try:
            plt.show()
        except Exception as e:
            print(f"  ⚠ plt.show() 실패: {e}")

    return results


