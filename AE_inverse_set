def train_bodyset_model(cfg, dataset, train_idx, val_idx, val_idx_per_type, type_names, common_curve, device):
    set_seed(cfg.seed)

    train_loader = DataLoader(
        SubsetDataset(dataset, train_idx),
        batch_size=cfg.batch_size,
        shuffle=True,
        num_workers=0,
    )
    val_loader = DataLoader(
        SubsetDataset(dataset, val_idx),
        batch_size=cfg.batch_size,
        shuffle=False,
        num_workers=0,
    )

    ae = BodySetAE(
        cfg,
        max_bodies=dataset.max_bodies,
        max_body_len=dataset.max_body_len,
    ).to(device)

    mlp = SparamCommonResidualMLP(
        latent_dim=cfg.latent,
        n_freq=cfg.n_freq,
        common_curve=common_curve,
        hidden_mult=cfg.mlp_hidden_mult,
        dropout=cfg.mlp_dropout,
        residual_scale=cfg.residual_scale,
        zero_init_residual=cfg.zero_init_residual,
    ).to(device)

    ae_params = sum(p.numel() for p in ae.parameters())
    mlp_params = sum(p.numel() for p in mlp.parameters())

    section("BUILD BODY-SET MODEL")
    print(f"  AE params       : {ae_params:,}")
    print(f"  Surrogate params: {mlp_params:,}")
    print(f"  Total params    : {ae_params + mlp_params:,}")
    print(f"  max_bodies      : {dataset.max_bodies}")
    print(f"  max_body_len    : {dataset.max_body_len}")
    print(f"  body order      : ignored via Hungarian matching")
    print(f"  VICReg          : w_var={cfg.w_var}, w_cov={cfg.w_cov}, target={cfg.vicreg_var_target}")

    opt = torch.optim.AdamW(
        [
            {"params": list(ae.parameters()), "lr": cfg.lr_ae},
            {"params": list(mlp.parameters()), "lr": cfg.lr_mlp},
        ],
        weight_decay=cfg.weight_decay,
        betas=(0.9, 0.98),
    )

    def lr_sched(ep):
        if ep < cfg.warmup:
            return (ep + 1) / max(1, cfg.warmup)
        return 0.5 * (
            1.0 + math.cos(math.pi * (ep - cfg.warmup) / max(1, cfg.epochs - cfg.warmup))
        )

    sched = torch.optim.lr_scheduler.LambdaLR(opt, lr_sched)

    interp_w = torch.tensor(dataset.interp_matrix, dtype=torch.float32, device=device)

    hist = {
        "tr_total": [], "va_total": [],
        "tr_full": [], "va_full": [],
        "tr_body": [], "tr_presence": [],
        "z_std": [],
    }

    best_val = float("inf")
    best_ae = None
    best_mlp = None

    log_every = max(1, cfg.epochs // 8)

    section("TRAIN BODY-SET AE + SURROGATE")
    print(
        f"\n  {'ep':>4s} | "
        f"{'tr_tot':>8s} {'body':>8s} {'pres':>7s} {'tr_full':>8s} "
        f"{'var':>7s} {'cov':>7s} {'zstd':>6s} | "
        f"{'va_tot':>8s} {'va_full':>8s} {'va_body':>8s} {'va_pres':>7s} | {'lr':>8s}"
    )
    print("  " + "-" * 132)

    for ep in range(1, cfg.epochs + 1):
        tr = run_epoch(ae, mlp, train_loader, opt, device, cfg, interp_w, train_mode=True)
        va = run_epoch(ae, mlp, val_loader, opt, device, cfg, interp_w, train_mode=False)

        sched.step()

        hist["tr_total"].append(tr["total"])
        hist["va_total"].append(va["total"])
        hist["tr_full"].append(tr["rmse_full"])
        hist["va_full"].append(va["rmse_full"])
        hist["tr_body"].append(tr["body"])
        hist["tr_presence"].append(tr["presence"])
        hist["z_std"].append(tr["z_std"])

        if va["rmse_full"] < best_val:
            best_val = va["rmse_full"]
            best_ae = {k: v.detach().clone().cpu() for k, v in ae.state_dict().items()}
            best_mlp = {k: v.detach().clone().cpu() for k, v in mlp.state_dict().items()}

        if ep == 1 or ep % log_every == 0 or ep == cfg.epochs:
            print(
                f"  {ep:4d} | "
                f"{tr['total']:8.4f} {tr['body']:8.3f} {tr['presence']:7.3f} {tr['rmse_full']:8.3f} "
                f"{tr['var']:7.4f} {tr['cov']:7.4f} {tr['z_std']:6.3f} | "
                f"{va['total']:8.4f} {va['rmse_full']:8.3f} {va['body']:8.3f} {va['presence']:7.3f} | "
                f"{opt.param_groups[0]['lr']:8.2e}"
            )

    print(f"\n  Best val full-grid RMSE: {best_val:.4f} dB")

    if best_ae is not None:
        ae.load_state_dict({k: v.to(device) for k, v in best_ae.items()})
    if best_mlp is not None:
        mlp.load_state_dict({k: v.to(device) for k, v in best_mlp.items()})

    section("EVALUATION")
    evaluate_body_reconstruction(ae, dataset, val_idx, device, n_eval=min(64, len(val_idx)))

    eval_metrics = evaluate_sparam(ae, mlp, dataset, val_idx_per_type, type_names, device)
    print_sparam_eval(eval_metrics, type_names)

    z_val, _ = collect_latents(ae, dataset, val_idx, device)
    z_std = z_val.std(axis=0)

    print("\n  Latent diagnostic")
    print(f"    z shape        : {z_val.shape}")
    print(f"    z_std mean     : {z_std.mean():.4f}")
    print(f"    z_std min/max  : {z_std.min():.4f} / {z_std.max():.4f}")
    print(f"    dead dims      : {(z_std < 1e-3).sum()} / {z_val.shape[1]}")

    if cfg.show_figures:
        subsection("Figures")
        plot_training_curves(hist)
        visualize_bodyset_reconstruction(ae, dataset, val_idx, device, n_preview=cfg.n_preview)

    result = {
        "best_val": best_val,
        "eval_full": eval_metrics["overall"],
    }

    return ae, mlp, result


