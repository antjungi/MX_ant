@torch.no_grad()
def collect_latents(ae, dataset, indices, device, batch_size=32):
    ae.eval()
    z_list = []
    t_list = []

    for i in range(0, len(indices), batch_size):
        bi = indices[i:i + batch_size]

        bodies = torch.stack([
            torch.tensor(dataset.body_tensors[k], dtype=torch.float32)
            for k in bi
        ]).to(device)

        masks = torch.stack([
            torch.tensor(dataset.body_masks[k], dtype=torch.bool)
            for k in bi
        ]).to(device)

        z = ae.encode(bodies, masks)
        z_list.append(z.cpu().numpy())
        t_list.extend([int(dataset.type_ids[k]) for k in bi])

    return np.concatenate(z_list, axis=0), np.asarray(t_list, dtype=np.int64)


@torch.no_grad()
def evaluate_sparam(ae, mlp, dataset, val_idx_per_type, type_names, device):
    ae.eval()
    mlp.eval()

    freqs_sel = dataset.freqs
    freqs_full = dataset.freqs_full

    total_sq = 0.0
    total_n = 0
    per_type = {}

    for ti, tname in enumerate(type_names):
        idxs = val_idx_per_type.get(ti, [])
        if not idxs:
            continue

        preds = []
        trues = []
        residual_abs = []

        for idx in idxs:
            bodies = torch.tensor(dataset.body_tensors[idx], dtype=torch.float32).unsqueeze(0).to(device)
            mask = torch.tensor(dataset.body_masks[idx], dtype=torch.bool).unsqueeze(0).to(device)

            z = ae.encode(bodies, mask)
            pred_sel, residual = mlp(z, return_parts=True)
            pred_sel = pred_sel.cpu().numpy()[0]
            pred_full = interpolate_selected_to_full_np(pred_sel, freqs_sel, freqs_full)

            preds.append(pred_full)
            trues.append(dataset.sparam_db_full[idx])
            residual_abs.append(float(residual.abs().mean().item()))

        preds = np.asarray(preds)
        trues = np.asarray(trues)

        ch = []
        for c in range(3):
            ch.append(float(np.sqrt(np.mean((preds[:, :, c] - trues[:, :, c]) ** 2))))

        avg = float(np.sqrt(np.mean((preds - trues) ** 2)))

        per_type[tname] = {
            "n": len(idxs),
            "ch": ch,
            "avg": avg,
            "res_abs": float(np.mean(residual_abs)),
        }

        total_sq += float(np.sum((preds - trues) ** 2))
        total_n += int(np.prod(trues.shape))

    overall = math.sqrt(total_sq / max(total_n, 1))
    return {"per_type": per_type, "overall": overall}


@torch.no_grad()
def evaluate_body_reconstruction(ae, dataset, indices, device, n_eval=32):
    ae.eval()

    sel = list(indices)[:min(n_eval, len(indices))]

    total_true = 0
    total_pred_present = 0
    total_matched = 0
    total_cost = 0.0

    for idx in sel:
        bodies = torch.tensor(dataset.body_tensors[idx], dtype=torch.float32).unsqueeze(0).to(device)
        mask = torch.tensor(dataset.body_masks[idx], dtype=torch.bool).unsqueeze(0).to(device)

        dec, z = ae(bodies, mask)

        cost, true_ids = _body_pair_cost_matrix(
            dec["cmd_logits"][0],
            dec["prm_logits"][0],
            bodies[0],
            mask[0],
            ae.cfg,
        )

        n_true = int(mask[0].sum().item())
        total_true += n_true

        pres_prob = torch.sigmoid(dec["presence_logits"][0]).detach().cpu().numpy()
        n_pred = int((pres_prob >= 0.5).sum())
        total_pred_present += n_pred

        if cost is not None:
            cost_np = cost.detach().cpu().numpy()
            pred_idx, true_col_idx = _hungarian_assign(cost_np)
            total_matched += len(pred_idx)
            total_cost += float(cost_np[pred_idx, true_col_idx].mean())

    n = max(len(sel), 1)

    print("\n  Body-set reconstruction diagnostic")
    print(f"    samples evaluated       : {len(sel)}")
    print(f"    avg true bodies         : {total_true / n:.2f}")
    print(f"    avg predicted present   : {total_pred_present / n:.2f}")
    print(f"    avg matched bodies      : {total_matched / n:.2f}")
    print(f"    avg matched body cost   : {total_cost / n:.4f}")


