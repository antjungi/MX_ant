def apply_preset(cfg):
    name = (cfg.preset or "custom").lower()
    if name == "custom":
        return cfg

    if name not in PRESETS:
        raise ValueError(f"preset={cfg.preset!r} 알 수 없음. tiny/small/full/custom 중 선택.")

    patch = dict(PRESETS[name])
    n_each = patch.pop("n_samples_each", None)

    if n_each is not None:
        n_types = len(cfg.npy_dirs)
        cfg.n_samples_per_type = tuple([n_each] * n_types)

    for k, v in patch.items():
        setattr(cfg, k, v)

    return cfg


