class BodySetDataset(Dataset):
    def __init__(
        self,
        npy_files,
        sparam_db,
        freqs,
        sparam_db_full,
        freqs_full,
        freq_idx,
        interp_matrix,
        type_ids,
        type_names,
        max_bodies,
        max_body_len,
    ):
        self.npy_files = list(npy_files)
        self.sparam_db = sparam_db.astype(np.float32)
        self.freqs = np.asarray(freqs, dtype=np.float32)
        self.sparam_db_full = sparam_db_full.astype(np.float32)
        self.freqs_full = np.asarray(freqs_full, dtype=np.float32)
        self.freq_idx = np.asarray(freq_idx, dtype=np.int64)
        self.interp_matrix = interp_matrix.astype(np.float32)

        self.type_ids = np.asarray(type_ids, dtype=np.int64)
        self.type_names = list(type_names)

        self.max_bodies = int(max_bodies)
        self.max_body_len = int(max_body_len)

        self.raw_bodies = []
        self.body_tensors = []
        self.body_masks = []

        n_over_body = 0
        n_over_len = 0

        for f in self.npy_files:
            seq = np.load(f).astype(np.int32)
            bodies = split_sequence_to_bodies(seq)

            if len(bodies) > self.max_bodies:
                n_over_body += 1
                bodies = bodies[:self.max_bodies]

            body_arr = np.full(
                (self.max_bodies, self.max_body_len, 17),
                PAD_V,
                dtype=np.int32,
            )
            body_mask = np.zeros((self.max_bodies,), dtype=np.bool_)

            for i, b in enumerate(bodies):
                if len(b) > self.max_body_len:
                    n_over_len += 1
                body_arr[i] = pad_body_tokens(b, self.max_body_len)
                body_mask[i] = True

            self.raw_bodies.append(bodies)
            self.body_tensors.append(body_arr)
            self.body_masks.append(body_mask)

        dist = ", ".join(
            f"{name}:{int((self.type_ids == i).sum())}"
            for i, name in enumerate(self.type_names)
        )

        print(f"  loaded {len(self.npy_files)} samples")
        print(f"    type distribution  : {dist}")
        print(f"    max_bodies         : {self.max_bodies}")
        print(f"    max_body_len       : {self.max_body_len}")
        print(f"    truncated bodies   : {n_over_body}")
        print(f"    truncated body len : {n_over_len}")
        print(f"    selected S-param   : {self.sparam_db.shape}")
        print(f"    full S-param       : {self.sparam_db_full.shape}")

    def __len__(self):
        return len(self.npy_files)

    def __getitem__(self, idx):
        return (
            torch.tensor(self.body_tensors[idx], dtype=torch.float32),
            torch.tensor(self.body_masks[idx], dtype=torch.bool),
            torch.tensor(self.sparam_db[idx], dtype=torch.float32),
            torch.tensor(self.sparam_db_full[idx], dtype=torch.float32),
            torch.tensor(int(self.type_ids[idx]), dtype=torch.long),
        )


