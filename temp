    fig2.suptitle("Overall diag RMSE (S11/S22/S33 avg) by mode",
                  fontweight="normal", fontsize=11)
    vals = [results_by_mode[m]["overall_diag_rmse"] for m in modes]
    bars = ax.bar([NAME_MODE[m] for m in modes], vals,
                  color=[COLOR_MODE[m] for m in modes], alpha=0.92)
    for b, v in zip(bars, vals):
        ax.text(b.get_x() + b.get_width()/2, v + 0.03, f"{v:.2f}",
                ha="center", va="bottom", fontsize=10)
    ax.set_ylabel("RMSE (dB)")
    ax.set_facecolor("white")
    ax.grid(True, axis="y", alpha=0.2)
    plt.xticks(rotation=10, fontsize=9)
    plt.tight_layout(rect=[0, 0, 1, 0.95])


def run_ablation(cfg, design_vars_csv, mlp_epochs=300, mlp_batch_size=64,
                 mlp_lr=1e-3, dv_normalize=True):
    """
    실행 흐름:
      1) data 로드 (token + sparam + design vars CSV)
      2) train/val split (stratified by type)
      3) AE + MLP_A joint training (= 기존 baseline)
      4) AE freeze, z 추출
      5) 세 모드 MLP 학습 (frozen z, fresh init each)
      6) 비교 출력 + figure
    """
    apply_preset(cfg)
    set_seed(cfg.seed)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    _SD = os.path.dirname(os.path.abspath(__file__))

    section("HYBRID ABLATION — z vs design_vars vs both")
    print(f"  Device      : {device}" + (f" ({torch.cuda.get_device_name(0)})"
                                          if device.type == 'cuda' else ""))
    print(f"  Preset      : {cfg.preset}")
    print(f"  Design CSV  : {design_vars_csv}")
    print(f"  MLP epochs  : {mlp_epochs}   batch_size : {mlp_batch_size}   lr : {mlp_lr}")

    # ── 1) data load ──
    section("[1/5] Token + S-param data loading")
    n_types = len(cfg.npy_dirs)
    type_names = (tuple(cfg.type_names) if len(cfg.type_names) == n_types
                  else tuple(f"type{i+1}" for i in range(n_types)))
    n_samples_per_type = (tuple(cfg.n_samples_per_type)
                          if len(cfg.n_samples_per_type) == n_types
                          else tuple([0]*n_types))
    all_npy_files = []; all_sparam = []; all_type_ids = []
    sparam_names_ref = None
    for ti in range(n_types):
        npy_dir_abs = (cfg.npy_dirs[ti] if os.path.isabs(cfg.npy_dirs[ti])
                       else os.path.join(_SD, cfg.npy_dirs[ti]))
        sp_glob_abs = (cfg.sparam_globs[ti] if os.path.isabs(cfg.sparam_globs[ti])
                       else os.path.join(_SD, cfg.sparam_globs[ti]))
        npy_list = sorted(glob.glob(os.path.join(npy_dir_abs, "*_tokens.npy")))
        if not npy_list: raise FileNotFoundError(f"npy 없음: {npy_dir_abs}")
        sp_files = sorted(glob.glob(sp_glob_abs))
        if not sp_files: raise FileNotFoundError(f"sparam 없음: {sp_glob_abs}")
        sp_arr, sp_names = load_sparam_data(sp_files, cfg.n_freq,
                                            expected_cols=sparam_names_ref, verbose=False)
        if sparam_names_ref is None: sparam_names_ref = sp_names
        n_match = min(len(npy_list), sp_arr.shape[0])
        npy_list = npy_list[:n_match]; sp_arr = sp_arr[:n_match]
        n_pick = n_samples_per_type[ti]
        if 0 < n_pick < n_match:
            mode = (cfg.sample_mode or "random").lower()
            if mode == "sequential":
                pick = list(range(n_pick))
            else:
                rng = random.Random(cfg.seed + ti)
                pick = sorted(rng.sample(range(n_match), n_pick))
            npy_list = [npy_list[i] for i in pick]; sp_arr = sp_arr[pick]
        all_npy_files.extend(npy_list); all_sparam.append(sp_arr)
        all_type_ids.extend([ti]*len(npy_list))
        print(f"  [{type_names[ti]}]  {len(npy_list)} samples")

    sparam_all   = np.concatenate(all_sparam, axis=0)
    npy_files    = all_npy_files
    type_ids_arr = np.array(all_type_ids, dtype=np.int64)
    sparam_names = sparam_names_ref
    n_use    = len(npy_files); n_sparam = sparam_all.shape[2]
    sparam_mean = sparam_all.mean(axis=(0, 1))
    sparam_std  = sparam_all.std(axis=(0, 1))
    max_len = min(max(np.load(f).shape[0] for f in npy_files) + 4, cfg.max_len_cap)
    dataset = JointDataset(npy_files, max_len, sparam_all, sparam_mean, sparam_std,
                           type_ids=type_ids_arr, type_names=type_names)

    # ── 2) design vars ──
    section("[2/5] Design vars (CSV) loading")
    dv_all_raw, dv_names = load_design_vars_csv(npy_files, design_vars_csv)
    n_dv = dv_all_raw.shape[1]
    print(f"  shape    : {dv_all_raw.shape}")
    print(f"  vars     : {dv_names}")
    if dv_normalize:
        dv_mean = dv_all_raw.mean(axis=0); dv_std = dv_all_raw.std(axis=0) + 1e-8
        dv_all = (dv_all_raw - dv_mean) / dv_std
        print(f"  normalize: mean ≈ 0, std ≈ 1")
    else:
        dv_all = dv_all_raw

    # ── 3) train/val split ──
    section("[3/5] Train/Val split (stratified)")
    rng = random.Random(cfg.seed)
    train_idx = []; val_idx = []
    for ti in range(n_types):
        idx_t = [i for i in range(n_use) if int(type_ids_arr[i]) == ti]
        rng.shuffle(idx_t)
        n_val_t = max(1, int(len(idx_t) * cfg.val_ratio))
        val_idx.extend(idx_t[:n_val_t])
        train_idx.extend(idx_t[n_val_t:])
    rng.shuffle(train_idx); rng.shuffle(val_idx)
    print(f"  train = {len(train_idx)}   val = {len(val_idx)}")

    # ── 4) AE + MLP joint training ──
    section("[4/5] AE + MLP(z) joint training  (= 기존 baseline)")
    ae = DeepCADBaselineAE(
        max_len=max_len, d_model=cfg.d_model, d_param=cfg.d_param,
        nhead=cfg.nhead, n_enc=cfg.n_enc, n_dec=cfg.n_dec, d_ff=cfg.d_ff,
        latent=cfg.latent, mem_tokens=cfg.mem_tokens, dropout=cfg.dropout,
        n_pool=getattr(cfg, "n_pool", 4),
        n_freq_bands=getattr(cfg, "n_freq_bands", 0),
    ).to(device)
    mlp_aux = SparamMLP(latent_dim=cfg.latent, n_freq=cfg.n_freq, n_sparam=n_sparam,
                        hidden_mult=cfg.mlp_hidden_mult, dropout=cfg.mlp_dropout,
                        n_types=n_types,
                        type_emb_dim=getattr(cfg, "type_emb_dim", 0)).to(device)

    train_set = AugmentedSubset(dataset, train_idx, augment=False)
    val_set   = AugmentedSubset(dataset, val_idx,   augment=False)
    train_loader = DataLoader(train_set, batch_size=cfg.batch_size, shuffle=True)
    val_loader   = DataLoader(val_set,   batch_size=cfg.batch_size, shuffle=False)

    opt = torch.optim.AdamW([
        {"params": list(ae.parameters()),       "lr": cfg.lr_ae},
        {"params": list(mlp_aux.parameters()),  "lr": cfg.lr_mlp},
    ], weight_decay=cfg.weight_decay, betas=(0.9, 0.98))
    def _lr_sched(ep):
        if ep < cfg.warmup: return (ep+1)/max(1, cfg.warmup)
        return 0.5*(1+math.cos(math.pi*(ep-cfg.warmup)/max(1, cfg.epochs-cfg.warmup)))
    sch = torch.optim.lr_scheduler.LambdaLR(opt, _lr_sched)

    best_va = float("inf"); best_ae_state = None
    log_every = max(1, cfg.epochs // 10)
    print(f"  epochs={cfg.epochs}  bs={cfg.batch_size}  lr_ae={cfg.lr_ae:.2e}\n")
    print(f"  {'ep':>4s} | {'tr_tot':>8s} {'tr_sp':>9s}  {'va_tot':>8s} {'va_sp':>9s}")
    print("  " + "-"*55)
    for ep in range(1, cfg.epochs+1):
        tr = run_joint_epoch(ae, mlp_aux, train_loader, opt, device, cfg, True)
        va = run_joint_epoch(ae, mlp_aux, val_loader,   opt, device, cfg, False) if len(val_set)>0 else tr
        sch.step()
        if va["total"] < best_va:
            best_va = va["total"]
            best_ae_state = {k: v.detach().clone().cpu() for k, v in ae.state_dict().items()}
        if ep == 1 or ep % log_every == 0 or ep == cfg.epochs:
            print(f"  {ep:4d} | {tr['total']:8.4f} {tr['sp']:9.6f}  "
                  f"{va['total']:8.4f} {va['sp']:9.6f}")
    if best_ae_state is not None:
        ae.load_state_dict({k: v.to(device) for k, v in best_ae_state.items()})
    print(f"\n  ✓ best val_total = {best_va:.5f}")

    # ── 5) z 추출 + 세 모드 학습 ──
    section("[5/5] Three-mode MLP training + comparison")
    print("  step 5a: extract z from frozen AE")
    ae.eval()
    z_all = []
    loader_all = DataLoader(dataset, batch_size=32, shuffle=False)
    with torch.no_grad():
        for batch in loader_all:
            tok_b = batch[0].to(device)
            z_all.append(ae.encode(tok_b).cpu())
    z_all = torch.cat(z_all, 0).float()
    print(f"  z_all : {tuple(z_all.shape)}")

    z_tr   = z_all[train_idx].to(device)
    z_va   = z_all[val_idx].to(device)
    dv_tr  = torch.tensor(dv_all[train_idx], dtype=torch.float32, device=device)
    dv_va  = torch.tensor(dv_all[val_idx],   dtype=torch.float32, device=device)
    sp_norm_all = (sparam_all - sparam_mean) / (sparam_std + 1e-8)
    sp_tr  = torch.tensor(sp_norm_all[train_idx], dtype=torch.float32, device=device)
    sp_va  = torch.tensor(sp_norm_all[val_idx],   dtype=torch.float32, device=device)
    type_va = torch.tensor(type_ids_arr[val_idx], dtype=torch.long, device=device)

    train_data = {"z": z_tr, "dv": dv_tr, "sp": sp_tr}
    val_data   = {"z": z_va, "dv": dv_va, "sp": sp_va}

    print("\n  step 5b: train three modes (AE frozen, fresh MLP each)")
    results = {}; histories = {}
    for mode in ["z", "dv", "z_dv"]:
        subsection(f"  Mode = {mode}  ({NAME_MODE[mode]})")
        torch.manual_seed(cfg.seed); np.random.seed(cfg.seed); random.seed(cfg.seed)
        model = SparamMLP_Mode(
            latent_dim=cfg.latent, n_dv=n_dv,
            n_freq=cfg.n_freq, n_sparam=n_sparam,
            mode=mode, hidden_mult=cfg.mlp_hidden_mult, dropout=cfg.mlp_dropout,
        ).to(device)
        n_params = sum(p.numel() for p in model.parameters())
        print(f"    in_dim={model.in_dim}   params={n_params:,}")
        model, best_va_mse, tr_h, va_h = train_sparam_mlp_standalone(
            model, train_data, val_data, device,
            epochs=mlp_epochs, lr=mlp_lr,
            weight_decay=cfg.weight_decay, batch_size=mlp_batch_size,
        )
        histories[mode] = (tr_h, va_h)
        r = evaluate_sparam_mlp_modes(model, val_data, sparam_mean, sparam_std,
                                       sparam_names, type_va, type_names, device)
        results[mode] = r
        print(f"    diag RMSE: " + "  ".join(
            f"{tn}={r['per_type'][tn]['diag_rmse']:.3f}" for tn in type_names
        ) + f"  TOTAL={r['overall_diag_rmse']:.3f}")

    # ── 6) summary + figures ──
    _print_ablation_summary(results, type_names)
    _print_ablation_per_channel(results, type_names)

    # loss curves
    fig_l, ax_l = plt.subplots(1, 2, figsize=(11, 4), facecolor="white")
    for mode in ["z", "dv", "z_dv"]:
        tr_h, va_h = histories[mode]
        ax_l[0].plot(range(1, len(tr_h)+1), tr_h, lw=1.5,
                     color=COLOR_MODE[mode], label=NAME_MODE[mode])
        ax_l[1].plot(range(1, len(va_h)+1), va_h, lw=1.5,
                     color=COLOR_MODE[mode], label=NAME_MODE[mode])
    for ax, t in [(ax_l[0], "Train MSE (normalized)"),
                  (ax_l[1], "Val MSE (normalized)")]:
        ax.set_facecolor("white"); ax.grid(True, alpha=0.2)
        ax.set_xlabel("epoch"); ax.set_ylabel("MSE")
        ax.set_title(t, fontweight="normal")
        ax.legend(fontsize=8); ax.set_yscale("log")
    plt.tight_layout()

    _plot_ablation_comparison(results, type_names)

    section("DONE — Hybrid ablation complete")
    n_open = len(plt.get_fignums())
    print(f"  생성된 figure: {n_open}  (backend={matplotlib.get_backend()})")
    if n_open > 0:
        try: plt.show()
        except Exception as _e: print(f"  ⚠ plt.show() 실패: {_e}")
    return results


