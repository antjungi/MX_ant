class SinPosEnc(nn.Module):
    def __init__(self, d_model, max_len=512, dropout=0.1):
        super().__init__()
        self.drop = nn.Dropout(dropout)

        pe = torch.zeros(max_len, d_model)
        pos = torch.arange(max_len).unsqueeze(1).float()
        div = torch.exp(
            torch.arange(0, d_model, 2).float()
            * (-math.log(10000.0) / d_model)
        )

        pe[:, 0::2] = torch.sin(pos * div)
        pe[:, 1::2] = torch.cos(pos * div)

        self.register_buffer("pe", pe.unsqueeze(0))

    def forward(self, x):
        return self.drop(x + self.pe[:, :x.size(1)])


# ══════════════════════════════════════════════════════════════
# DeepCAD AE
# ══════════════════════════════════════════════════════════════
class DeepCADBaselineAE(nn.Module):
    def __init__(
        self,
        max_len=128,
        d_model=256,
        d_param=64,
        nhead=8,
        n_enc=4,
        n_dec=4,
        d_ff=1024,
        latent=256,
        mem_tokens=16,
        dropout=0.1,
        n_pool=4,
        n_freq_bands=0,
        aux_numeric=False,
        aux_hidden_mult=2.0,
    ):
        super().__init__()

        assert d_model % nhead == 0

        self.max_len = max_len
        self.d_model = d_model
        self.d_param = d_param
        self.latent = latent
        self.mem_tokens = mem_tokens
        self.n_pool = int(n_pool)
        self.n_freq_bands = int(n_freq_bands)

        self.cmd_emb = nn.Embedding(
            N_CMD + 1,
            d_model,
            padding_idx=PAD_CMD_INDEX,
        )

        self.param_embs = nn.ModuleList([
            nn.Embedding(
                N_QUANT + 1,
                d_param,
                padding_idx=PAD_PARAM_INDEX,
            )
            for _ in range(N_ARGS)
        ])

        if self.n_freq_bands > 0:
            freq_bands = (
                2.0 ** torch.arange(self.n_freq_bands, dtype=torch.float32)
            ) * math.pi

            self.register_buffer("fourier_freqs", freq_bands)

            fourier_total = N_ARGS * 2 * self.n_freq_bands
            param_proj_in = N_ARGS * d_param + fourier_total
        else:
            self.fourier_freqs = None
            param_proj_in = N_ARGS * d_param

        self._param_proj_in = param_proj_in

        self.param_proj = nn.Linear(param_proj_in, d_model)
        self.emb_norm = nn.LayerNorm(d_model)

        self.pos_enc = SinPosEnc(
            d_model,
            max_len=max_len + 16,
            dropout=dropout,
        )

        enc_layer = nn.TransformerEncoderLayer(
            d_model=d_model,
            nhead=nhead,
            dim_feedforward=d_ff,
            dropout=dropout,
            batch_first=True,
            norm_first=True,
        )

        self.encoder = nn.TransformerEncoder(
            enc_layer,
            num_layers=n_enc,
            norm=nn.LayerNorm(d_model),
        )

        if self.n_pool >= 2:
            self.pool_queries = nn.Parameter(torch.randn(self.n_pool, d_model) * 0.02)
            self.pool_attn = nn.MultiheadAttention(
                embed_dim=d_model,
                num_heads=nhead,
                dropout=dropout,
                batch_first=True,
            )
            self.pool_norm = nn.LayerNorm(d_model)
            self.to_z = nn.Linear(self.n_pool * d_model, latent)
        else:
            self.pool_queries = None
            self.pool_attn = None
            self.pool_norm = None
            self.to_z = nn.Linear(d_model, latent)

        self.from_z = nn.Linear(latent, mem_tokens * d_model)

        dec_layer = nn.TransformerDecoderLayer(
            d_model=d_model,
            nhead=nhead,
            dim_feedforward=d_ff,
            dropout=dropout,
            batch_first=True,
            norm_first=True,
        )

        self.decoder = nn.TransformerDecoder(
            dec_layer,
            num_layers=n_dec,
            norm=nn.LayerNorm(d_model),
        )

        self.bos = nn.Parameter(torch.randn(1, 1, d_model) * 0.02)

        self.cmd_head = nn.Linear(d_model, N_CMD)
        self.param_head = nn.Linear(d_model, N_ARGS * N_QUANT)

        if aux_numeric:
            aux_h = max(int(latent * aux_hidden_mult), 64)
            aux_out = max_len * N_ARGS

            self.aux_numeric_head = nn.Sequential(
                nn.Linear(latent, aux_h),
                nn.LayerNorm(aux_h),
                nn.GELU(),
                nn.Dropout(dropout),
                nn.Linear(aux_h, aux_out),
                nn.Sigmoid(),
            )
        else:
            self.aux_numeric_head = None

        self._init_weights()

    def _init_weights(self):
        for p in self.parameters():
            if p.dim() > 1:
                nn.init.xavier_uniform_(p)

    def _content_embed(self, x):
        cmd = x[:, :, 0].long()
        params = x[:, :, 1:].long()

        pad_mask = cmd < 0

        cmd_idx = cmd.clone()
        cmd_idx[pad_mask] = PAD_CMD_INDEX
        cmd_idx = cmd_idx.clamp(0, PAD_CMD_INDEX)

        cmd_e = self.cmd_emb(cmd_idx)

        param_idx = params.clone()
        param_idx[param_idx < 0] = PAD_PARAM_INDEX
        param_idx = param_idx.clamp(0, PAD_PARAM_INDEX)

        slot_embs = []
        for s in range(N_ARGS):
            slot_embs.append(self.param_embs[s](param_idx[:, :, s]))

        param_concat = torch.cat(slot_embs, dim=-1)

        if self.n_freq_bands > 0 and self.fourier_freqs is not None:
            p_int = param_idx.clone()
            pad_p = params < 0
            p_int[pad_p] = 0

            p_f = p_int.float() / float(QMAX)

            ang = p_f.unsqueeze(-1) * self.fourier_freqs.view(1, 1, 1, -1)

            sin_p = torch.sin(ang)
            cos_p = torch.cos(ang)

            pad_p_exp = pad_p.unsqueeze(-1).float()

            sin_p = sin_p * (1.0 - pad_p_exp)
            cos_p = cos_p * (1.0 - pad_p_exp)

            B_, L_, _ = params.shape

            fourier_feat = torch.cat([sin_p, cos_p], dim=-1)
            fourier_feat = fourier_feat.reshape(
                B_,
                L_,
                N_ARGS * 2 * self.n_freq_bands,
            )

            param_concat = torch.cat([param_concat, fourier_feat], dim=-1)

        param_e = self.param_proj(param_concat)

        emb = self.emb_norm(cmd_e + param_e)
        emb = emb * (~pad_mask).unsqueeze(-1)

        return emb, pad_mask

    def encode(self, x):
        emb, pad_mask = self._content_embed(x)
        emb = self.pos_enc(emb)

        h = self.encoder(emb, src_key_padding_mask=pad_mask)

        if self.n_pool >= 2 and self.pool_attn is not None:
            B = h.size(0)
            Q = self.pool_queries.unsqueeze(0).expand(B, -1, -1)

            pooled, _ = self.pool_attn(
                Q,
                h,
                h,
                key_padding_mask=pad_mask,
                need_weights=False,
            )

            pooled = self.pool_norm(pooled)
            pooled_flat = pooled.reshape(B, self.n_pool * self.d_model)
            z = self.to_z(pooled_flat)
        else:
            valid = (~pad_mask).float().unsqueeze(-1)
            pooled = (h * valid).sum(dim=1) / valid.sum(dim=1).clamp(min=1.0)
            z = self.to_z(pooled)

        return z

    def _memory_from_z(self, z):
        return self.from_z(z).view(
            z.size(0),
            self.mem_tokens,
            self.d_model,
        )

    def decode_teacher(self, z, teacher):
        B, L, _ = teacher.shape

        memory = self._memory_from_z(z)
        bos = self.bos.expand(B, 1, self.d_model)

        prev_emb, prev_pad = self._content_embed(teacher[:, :-1, :])

        tgt = self.pos_enc(torch.cat([bos, prev_emb], dim=1))

        tgt_pad = torch.cat([
            torch.zeros((B, 1), dtype=torch.bool, device=teacher.device),
            prev_pad,
        ], dim=1)

        tgt_mask = causal_mask(L, teacher.device)

        out = self.decoder(
            tgt=tgt,
            memory=memory,
            tgt_mask=tgt_mask,
            tgt_key_padding_mask=tgt_pad,
        )

        cmd_logits = self.cmd_head(out)
        prm_logits = self.param_head(out).view(B, L, N_ARGS, N_QUANT)

        return cmd_logits, prm_logits

    def aux_numeric_predict(self, z):
        if self.aux_numeric_head is None:
            return None

        B = z.size(0)
        out = self.aux_numeric_head(z)
        return out.view(B, self.max_len, N_ARGS)

    @torch.no_grad()
    def generate(self, z, max_gen_len=None):
        if max_gen_len is None:
            max_gen_len = self.max_len

        B = z.size(0)
        device = z.device

        memory = self._memory_from_z(z)
        bos = self.bos.expand(B, 1, self.d_model)

        steps = []
        finished = torch.zeros(B, dtype=torch.bool, device=device)

        for _ in range(max_gen_len):
            if not steps:
                tc = bos
                tp = torch.zeros((B, 1), dtype=torch.bool, device=device)
            else:
                prev = torch.stack(steps, dim=1).float()
                pe, pp = self._content_embed(prev)

                tc = torch.cat([bos, pe], dim=1)
                tp = torch.cat([
                    torch.zeros((B, 1), dtype=torch.bool, device=device),
                    pp,
                ], dim=1)

            ti = self.pos_enc(tc)
            Lc = ti.size(1)
            tm = causal_mask(Lc, device)

            out = self.decoder(
                tgt=ti,
                memory=memory,
                tgt_mask=tm,
                tgt_key_padding_mask=tp,
            )

            last = out[:, -1, :]
            cl = self.cmd_head(last)
            pl = self.param_head(last).view(B, N_ARGS, N_QUANT)

            nc = torch.argmax(cl, dim=-1)
            np_ = torch.argmax(pl, dim=-1)

            nt = torch.full((B, 17), PAD_V, dtype=torch.long, device=device)
            nt[:, 0] = nc

            for cid in range(N_CMD):
                nv = VALID_PAR.get(cid, 0)
                if nv <= 0:
                    continue

                m = nc == cid
                if m.any():
                    nt[m, 1:1 + nv] = np_[m, :nv]

            if finished.any():
                nt[finished] = PAD_V
                nt[finished, 0] = EOS

            steps.append(nt)
            finished = finished | (nc == EOS)

            if bool(finished.all()):
                break

        if not steps:
            return torch.zeros((B, 0, 17), dtype=torch.long, device=device)

        rt = torch.stack(steps, dim=1)

        rn = rt.detach().cpu().numpy().astype(np.int32)
        cleaned = []

        for i in range(rn.shape[0]):
            s = trim_after_eos(rn[i])
            pad_len = rn.shape[1] - s.shape[0]

            if pad_len > 0:
                s = np.concatenate(
                    [s, np.full((pad_len, 17), PAD_V, dtype=np.int32)],
                    axis=0,
                )

            cleaned.append(s)

        return torch.tensor(
            np.stack(cleaned, axis=0),
            device=device,
            dtype=torch.long,
        )

    def forward(self, x):
        z = self.encode(x)
        cl, pl = self.decode_teacher(z, teacher=x)
        aux = self.aux_numeric_predict(z)
        return cl, pl, aux, z


# ══════════════════════════════════════════════════════════════
# S-param surrogate
# ══════════════════════════════════════════════════════════════
class TypeEncoder(nn.Module):
    def __init__(self, n_types: int, emb_dim: int = 8):
        super().__init__()

        self.n_types = int(n_types)
        self.emb_dim = int(emb_dim)
        self.active = self.emb_dim > 0 and self.n_types > 1

        if self.active:
            self.emb = nn.Embedding(self.n_types, self.emb_dim)
            nn.init.normal_(self.emb.weight, std=0.02)
        else:
            self.emb = None

    def forward(self, type_ids):
        B = type_ids.size(0)

        if not self.active:
            return torch.zeros(
                (B, 0),
                dtype=torch.float32,
                device=type_ids.device,
            )

        ids = type_ids.clamp(0, self.n_types - 1)
        return self.emb(ids)


class SparamMLP(nn.Module):
    """
    latent z (+ optional type embedding) → Return-3 S-param.

    n_sparam should be 6 after filtering:
      re(S11), im(S11),
      re(S22), im(S22),
      re(S33), im(S33)
    """
    def __init__(
        self,
        latent_dim=128,
        n_freq=401,
        n_sparam=6,
        hidden_mult=2.0,
        dropout=0.3,
        n_types=1,
        type_emb_dim=0,
    ):
        super().__init__()

        self.n_freq = n_freq
        self.n_sparam = n_sparam

        self.type_encoder = TypeEncoder(
            n_types=n_types,
            emb_dim=type_emb_dim,
        )

        in_dim = latent_dim + (type_emb_dim if self.type_encoder.active else 0)
        out_dim = n_freq * n_sparam

        h1 = max(in_dim, 64)
        h2 = max(int(in_dim * hidden_mult), 64)

        self.net = nn.Sequential(
            nn.Linear(in_dim, h1),
            nn.LayerNorm(h1),
            nn.GELU(),
            nn.Dropout(dropout),

            nn.Linear(h1, h2),
            nn.LayerNorm(h2),
            nn.GELU(),
            nn.Dropout(dropout),

            nn.Linear(h2, out_dim),
        )

    def forward(self, z, type_ids=None):
        if self.type_encoder.active and type_ids is not None:
            t_vec = self.type_encoder(type_ids)
            x = torch.cat([z, t_vec], dim=-1)
        else:
            x = z

        return self.net(x).view(-1, self.n_freq, self.n_sparam)


# ══════════════════════════════════════════════════════════════
# Loss
# ══════════════════════════════════════════════════════════════
def vicreg_z_loss(z, var_target=1.0, eps=1e-4):
    if z.dim() != 2:
        raise ValueError(f"vicreg_z_loss expects (B,D), got {tuple(z.shape)}")

    N, D = z.shape

    if N <= 1:
        zero = z.new_zeros(())
        return zero, zero

    z_c = z - z.mean(dim=0, keepdim=True)

    var = z_c.var(dim=0, unbiased=False)
    std = torch.sqrt(var + eps)

    var_loss = F.relu(var_target - std).mean()

    cov = (z_c.T @ z_c) / max(N - 1, 1)
    off = cov - torch.diag(torch.diag(cov))
    cov_loss = (off ** 2).sum() / D

    return var_loss, cov_loss


def ae_loss_fn(
    cmd_logits,
    prm_logits,
    aux_numeric,
    tgt,
    w_cmd=1.0,
    w_prm=1.0,
    w_aux=0.0,
    return_components=False,
):
    B, L, _ = tgt.shape

    ct = tgt[:, :, 0].long()
    valid_cmd = ct >= 0

    ce = F.cross_entropy(
        cmd_logits.reshape(B * L, N_CMD),
        ct.clamp(0, N_CMD - 1).reshape(B * L),
        reduction="none",
    ).reshape(B, L)

    cmd_loss = (ce * valid_cmd.float()).sum() / (valid_cmd.float().sum() + 1e-8)

    pt = tgt[:, :, 1:].long()
    valid_prm = pt >= 0

    pce = F.cross_entropy(
        prm_logits.reshape(B * L * N_ARGS, N_QUANT),
        pt.clamp(0, N_QUANT - 1).reshape(B * L * N_ARGS),
        reduction="none",
    ).reshape(B, L, N_ARGS)

    prm_loss = (pce * valid_prm.float()).sum() / (valid_prm.float().sum() + 1e-8)

    aux_loss = None

    if aux_numeric is not None and w_aux > 0:
        aux_pred = aux_numeric[:, :L, :]

        pt_f = pt.clamp(0, QMAX).float() / float(QMAX)
        sq = (aux_pred - pt_f) ** 2

        aux_loss = (sq * valid_prm.float()).sum() / (valid_prm.float().sum() + 1e-8)

    total = w_cmd * cmd_loss + w_prm * prm_loss

    if aux_loss is not None:
        total = total + w_aux * aux_loss

    if return_components:
        comp = {
            "cmd": float(cmd_loss.item()),
            "prm": float(prm_loss.item()),
            "aux": float(aux_loss.item()) if aux_loss is not None else 0.0,
            "total": float(total.item()),
        }
        return total, comp

    return total


# ══════════════════════════════════════════════════════════════
# Training loop
# ══════════════════════════════════════════════════════════════
def run_joint_epoch(ae, mlp, loader, optimizer, device, cfg, train_mode=True):
    if train_mode:
        ae.train()
        if mlp is not None:
            mlp.train()
    else:
        ae.eval()
        if mlp is not None:
            mlp.eval()

    # ★ FIX 3: aux 추가
    acc = {
        "total": 0.0,
        "ae": 0.0,
        "sp": 0.0,
        "cmd": 0.0,
        "prm": 0.0,
        "aux": 0.0,
        "var": 0.0,
        "cov": 0.0,
        "z_std": 0.0,
        "z_norm": 0.0,
        "grad_norm": 0.0,
    }

    n = 0

    for batch in loader:
        if len(batch) == 3:
            batch_tok, batch_sp, batch_tid = batch
            batch_tid = batch_tid.to(device)
        else:
            batch_tok, batch_sp = batch
            batch_tid = None

        batch_tok = batch_tok.to(device)
        batch_sp = batch_sp.to(device)

        if train_mode:
            optimizer.zero_grad(set_to_none=True)

        with torch.set_grad_enabled(train_mode):
            cl, pl, aux, z = ae(batch_tok)

            ae_loss, comp = ae_loss_fn(
                cl,
                pl,
                aux,
                batch_tok,
                w_cmd=cfg.w_cmd,
                w_prm=cfg.w_prm,
                w_aux=getattr(cfg, "w_aux_numeric", 0.0),
                return_components=True,
            )

            if mlp is not None:
                # batch_sp is already return3 only: (B, n_freq, 6)
                sp_pred = mlp(z, batch_tid)
                sp_loss = F.mse_loss(sp_pred, batch_sp)
                total = ae_loss + cfg.w_sparam * sp_loss
            else:
                sp_loss = torch.zeros((), device=device)
                total = ae_loss

            w_var = float(getattr(cfg, "w_var", 0.0))
            w_cov = float(getattr(cfg, "w_cov", 0.0))

            if (w_var > 0 or w_cov > 0) and z.size(0) > 1:
                v_loss, c_loss = vicreg_z_loss(
                    z,
                    var_target=float(getattr(cfg, "vicreg_var_target", 1.0)),
                )
                total = total + w_var * v_loss + w_cov * c_loss
            else:
                v_loss = torch.zeros((), device=device)
                c_loss = torch.zeros((), device=device)

            if train_mode:
                total.backward()

                params = list(ae.parameters())
                if mlp is not None:
                    params += list(mlp.parameters())

                gn = nn.utils.clip_grad_norm_(params, cfg.grad_clip)

                optimizer.step()

                acc["grad_norm"] += float(gn)

        acc["total"] += float(total.item())
        acc["ae"] += float(ae_loss.item())
        acc["sp"] += float(sp_loss.item())
        acc["cmd"] += comp["cmd"]
        acc["prm"] += comp["prm"]

        # ★ FIX 3: aux loss 정상 누적
        acc["aux"] += comp["aux"]

        acc["var"] += float(v_loss.item())
        acc["cov"] += float(c_loss.item())

        with torch.no_grad():
            acc["z_std"] += float(z.std(dim=0).mean().item()) if z.size(0) > 1 else 0.0
            acc["z_norm"] += float(z.norm(dim=1).mean().item())

        n += 1

    if n == 0:
        return {**{k: 0.0 for k in acc}, "n_batches": 0}

    out = {k: v / n for k, v in acc.items()}
    out["n_batches"] = n
    return out


