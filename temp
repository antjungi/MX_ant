        return 0.5 * (
            1.0
            + math.cos(
                math.pi
                * (ep - cfg.warmup)
                / max(1, cfg.epochs - cfg.warmup)
            )
        )

    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_sched)

