# S-param loading
# ══════════════════════════════════════════════════════════════
def _detect_sparam_cols(header):
    ci,cn=[],[]
    for i,h in enumerate(header):
        hl=h.strip().lower()
        if hl.startswith("re(") or hl.startswith("im("):
            ci.append(i); cn.append(h.strip())
    return ci,cn


def load_sparam_data(sparam_files, n_freq, expected_cols=None, verbose=True):
    """
    sparam_files : 명시적 파일 경로 리스트 (xlsx/xls/csv)
    expected_cols: None이면 첫 파일 헤더로 자동 결정.
                   제공되면 모든 파일이 같은 헤더여야 함.
    """
    if not sparam_files:
        raise FileNotFoundError(f"S-param 파일 비어있음: {sparam_files}")
    sparam_files=sorted(sparam_files)
    if verbose: print(f"  S-param 파일 {len(sparam_files)}개")
    all_s=[]; cn=expected_cols
    for fi,fp in enumerate(sparam_files):
        if verbose: print(f"    [{fi+1}/{len(sparam_files)}] {os.path.basename(fp)}")
        el=os.path.splitext(fp)[1].lower()
        if el==".csv" and pd is not None:
            d=pd.read_csv(fp, header=0); h=[str(c) for c in d.columns]; data=d.values
        elif pd is not None:
            d=pd.read_excel(fp, header=0, engine="openpyxl"); h=[str(c) for c in d.columns]; data=d.values
        else:
            continue
        ci,cnames=_detect_sparam_cols(h)
        if not ci:
            if verbose: print("      ⚠ S-param 열 못 찾음, 스킵")
            continue
        if cn is None:
            cn=cnames
            if verbose: print(f"    S-param 열({len(cn)}개) 자동 결정")
        elif cnames!=cn:
            missing=set(cn)-set(cnames); extra=set(cnames)-set(cn)
            raise ValueError(
                f"S-param 컬럼 불일치: {os.path.basename(fp)}\n"
                f"  expected: {cn}\n  found:    {cnames}\n"
                f"  missing={missing}, extra={extra}"
            )
        sd=data[:,ci].astype(np.float64); en=len(cn)
        ns=sd.shape[0]//n_freq
        if verbose: print(f"    구조 수: {ns}")
        for si in range(ns):
            chunk=sd[si*n_freq:(si+1)*n_freq]
            if chunk.shape==(n_freq,en): all_s.append(chunk)
    if not all_s: raise ValueError("유효한 S-param 데이터 없음")
    arr=np.stack(all_s,0)
    if verbose: print(f"  ✓ shape: {arr.shape}")
    return arr,cn


def reim_to_mag_db(reim, names):
    np_=len(names)//2; ms=[]; ns=[]
    for i in range(np_):
        r=reim[:,2*i]; im=reim[:,2*i+1]
        ms.append(20*np.log10(np.clip(np.sqrt(r**2+im**2),1e-12,None)))
        raw=names[2*i]
        c=raw.replace("re(","").replace("Re(","").replace("(","").replace(")","")
        c=c.replace(",","").replace(" ","")
        ns.append(c)
    return np.stack(ms,-1), ns


def diagonal_channel_mask(channel_names):
    """channel_names: ['Stport1port1[]', 'Stport2port1[]', ...] 같은 형식
    Returns: bool array, True인 인덱스가 S_ii (i==j) 채널.

    예: ['Stport1port1', 'Stport2port1', 'Stport3port1',
         'Stport2port2', 'Stport3port2', 'Stport3port3']
       → [True, False, False, True, False, True]   (S11, S22, S33만)
    """
    import re as _re
    mask = []
    for nm in channel_names:
        m = _re.search(r'port\s*(\d+)\s*port\s*(\d+)', nm.lower())
        if m and m.group(1) == m.group(2):
            mask.append(True)
        else:
            # fallback: S(i,j) or S_ii 형식
            m2 = _re.search(r'[sS]\s*\(?\s*(\d+)\s*[,\s]\s*(\d+)\s*\)?', nm)
            if m2 and m2.group(1) == m2.group(2):
                mask.append(True)
            else:
                mask.append(False)
    return np.array(mask, dtype=bool)


def _compute_s11_min_db(sparam_all, sparam_names):
    import re as _re
    ref_idx=None
    for i in range(0, len(sparam_names), 2):
        m=_re.search(r'[Ss]\(?(\d+)[,\s]*(\d+)\)?', sparam_names[i])
        if m and m.group(1)==m.group(2):
            ref_idx=i; break
    if ref_idx is None: return None, None
    re_col=sparam_all[:,:,ref_idx]; im_col=sparam_all[:,:,ref_idx+1]
    mag=20*np.log10(np.clip(np.sqrt(re_col**2+im_col**2),1e-12,None))
    raw=sparam_names[ref_idx]
    clean=raw.replace("re(","").replace("Re(","").replace("(","").replace(")","")
    clean=clean.replace(",","").replace(" ","")
    return mag.min(axis=1), f"|{clean}|_min (dB)"

