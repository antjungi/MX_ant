    if VERB not in ("simple","verbose"):
        print(f"  ⚠ unknown log_verbosity={cfg.log_verbosity!r} → simple")
        VERB="simple"

    section("DeepCAD v9g — Training Diagnostics")
    print(f"  Python : {_sys.version.split()[0]}")
    print(f"  Torch  : {torch.__version__}")
    print(f"  Device : {device}" + (f" ({torch.cuda.get_device_name(0)})"
                                    if device.type=='cuda' else ""))
    print(f"  Seed   : {cfg.seed}  |  Preset : {_preset_name}  |  Log : {VERB}")
    print(f"  MPL    : backend = {_MPL_BACKEND}  "
          f"(interactive={matplotlib.is_interactive()})")

    if VERB=="verbose":
        subsection("[CONFIG] CFG values")
        for f in _dc_fields(cfg):
            v=getattr(cfg, f.name)
            if isinstance(v,str) and len(v)>60: v=f"...{v[-57:]}"
            elif isinstance(v,tuple) and any(isinstance(x,str) and len(x)>60 for x in v):
                v=tuple(f"...{x[-57:]}" if isinstance(x,str) and len(x)>60 else x for x in v)
            print(f"    {f.name:22s} = {v}")
    else:
        _n_pool = getattr(cfg, "n_pool", 4)
        _pool_lbl = f"PMA(n={_n_pool})" if _n_pool >= 2 else "mean-pool"
        _nfb = getattr(cfg, "n_freq_bands", 0)
        _fou_lbl = f"Fourier(L={_nfb})" if _nfb > 0 else "no-Fourier"
        print(f"  Model  : d_model={cfg.d_model}  d_param={cfg.d_param}  latent={cfg.latent}  "
              f"d_ff={cfg.d_ff}  n_enc={cfg.n_enc}  n_dec={cfg.n_dec}  pool={_pool_lbl}  "
              f"embed={_fou_lbl}")
        print(f"  Train  : epochs={cfg.epochs}  bs={cfg.batch_size}  (joint AE+S-param)")

    # ─────────────────────────────────────────────────────────────
    # 1) Multi-type 데이터 로딩
    # ─────────────────────────────────────────────────────────────
    if VERB=="verbose":
        subsection("[LOAD] Multi-type data loading")

    n_types=len(cfg.npy_dirs)
    assert n_types==len(cfg.sparam_globs), \
        f"npy_dirs({n_types}) ≠ sparam_globs({len(cfg.sparam_globs)})"

    type_names=tuple(cfg.type_names) if len(cfg.type_names)==n_types \
               else tuple(f"type{i+1}" for i in range(n_types))
    n_samples_per_type = (tuple(cfg.n_samples_per_type)
                          if len(cfg.n_samples_per_type)==n_types
                          else tuple([0]*n_types))

    print(f"  Types ({n_types}): {list(type_names)}")
    print(f"  n_samples per type: {list(n_samples_per_type)}  (0 = all)")

    all_npy_files=[]; all_sparam_chunks=[]; all_type_ids=[]
    sparam_names_ref=None

    for ti in range(n_types):
        npy_dir=cfg.npy_dirs[ti]
        sp_glob=cfg.sparam_globs[ti]
        tname=type_names[ti]
        n_pick=n_samples_per_type[ti]

        if VERB=="verbose":
            subsection(f"  type[{ti}] = {tname}")
        else:
            print(f"  · [{tname}] dir={npy_dir}")
            print(f"    sparam_glob={sp_glob}")

        npy_dir_abs = npy_dir if os.path.isabs(npy_dir) else os.path.join(_SD, npy_dir)
        npy_list=sorted(glob.glob(os.path.join(npy_dir_abs, "*_tokens.npy")))
        if not npy_list:
            raise FileNotFoundError(f"[{tname}] npy 없음: {npy_dir_abs}")
        if VERB=="verbose":
            print(f"    npy_files in dir: {len(npy_list)}")

        sp_glob_abs = sp_glob if os.path.isabs(sp_glob) else os.path.join(_SD, sp_glob)
        sp_files=sorted(glob.glob(sp_glob_abs))
        if not sp_files:
            raise FileNotFoundError(f"[{tname}] S-param 없음: {sp_glob_abs}")
        if VERB=="verbose":
            print(f"    S-param files: {[os.path.basename(p) for p in sp_files]}")

        sp_arr, sp_names = load_sparam_data(
            sp_files, cfg.n_freq,
            expected_cols=sparam_names_ref,
            verbose=(VERB=="verbose"),
        )
        if sparam_names_ref is None:
            sparam_names_ref=sp_names

        n_match=min(len(npy_list), sp_arr.shape[0])
        npy_list=npy_list[:n_match]; sp_arr=sp_arr[:n_match]
        if VERB=="verbose":
            print(f"    matched npy↔S-param: {n_match}")

        if n_pick>0 and n_pick<n_match:
            mode=(cfg.sample_mode or "random").lower()
            if mode=="sequential":
                pick_idx=list(range(n_pick))
            else:
                rng_pick=random.Random(cfg.seed + ti)
                pick_idx=sorted(rng_pick.sample(range(n_match), n_pick))
            npy_list=[npy_list[i] for i in pick_idx]
            sp_arr=sp_arr[pick_idx]
            print(f"    [{tname}] {mode} 선택 → {n_pick}개 (전체 {n_match} 중)")
        else:
            print(f"    [{tname}] 전체 {n_match}개 사용")

        all_npy_files.extend(npy_list)
        all_sparam_chunks.append(sp_arr)
        all_type_ids.extend([ti]*len(npy_list))

    sparam_all=np.concatenate(all_sparam_chunks, axis=0)
    npy_files=all_npy_files
    type_ids_arr=np.array(all_type_ids, dtype=np.int64)
    sparam_names=sparam_names_ref

    n_use=len(npy_files); n_sparam=sparam_all.shape[2]
    print(f"  ✓ Total combined: {n_use} samples, S-param shape {sparam_all.shape}")

    sparam_mean=sparam_all.mean(axis=(0,1))
    sparam_std =sparam_all.std(axis=(0,1))

    max_len=min(max(np.load(f).shape[0] for f in npy_files)+4, cfg.max_len_cap)
    dataset=JointDataset(npy_files, max_len, sparam_all, sparam_mean, sparam_std,
                         type_ids=type_ids_arr, type_names=type_names)

    # ── ★ v11l: design vars 로딩 (combine_param=True 일 때만) ──
    n_dv_per_type = None
    if getattr(cfg, "combine_param", False):
        csv_paths = list(getattr(cfg, "design_vars_csvs", ()))
        # absolute path 화 (cwd 기준)
        csv_paths = [p if os.path.isabs(p) else os.path.join(_SD, p) for p in csv_paths]
        print(f"\n  [Design vars] loading per-type CSVs:")
        for p in csv_paths: print(f"    - {p}")
        vars_padded, n_dv_per_type, var_names_per_type, _ = load_design_vars_per_type(
            npy_files, type_ids_arr, csv_paths, normalize=True)
        dataset.set_vars(vars_padded)
        print(f"  ✓ vars_padded shape: {vars_padded.shape}")
        for t, n in n_dv_per_type.items():
            print(f"    type{t}: n_dv={n}, vars={var_names_per_type[t]}")

    if VERB=="verbose":
        diagnose_data(npy_files, dataset, sparam_all, sparam_names, cfg)

    # ─────────────────────────────────────────────────────────────
    # 2) Type별 stratified train/val split
    # ─────────────────────────────────────────────────────────────
    rng=random.Random(cfg.seed)
    train_idx=[]; val_idx=[]; val_idx_per_type={}
    for ti in range(n_types):
        idx_t=[i for i in range(n_use) if int(type_ids_arr[i])==ti]
        rng.shuffle(idx_t)
        n_val_t=max(1, int(len(idx_t)*cfg.val_ratio))
        val_idx_per_type[ti]=idx_t[:n_val_t]
        val_idx.extend(idx_t[:n_val_t])
        train_idx.extend(idx_t[n_val_t:])
    rng.shuffle(train_idx); rng.shuffle(val_idx)

    train_set=AugmentedSubset(dataset, train_idx, augment=False)
    val_set  =AugmentedSubset(dataset, val_idx,   augment=False)
    train_loader=DataLoader(train_set, batch_size=cfg.batch_size, shuffle=True)
    val_loader  =DataLoader(val_set,   batch_size=cfg.batch_size, shuffle=False)

    if VERB=="verbose":
        subsection("[SPLIT] Train / Val (stratified by type)")
        print(f"  total: train={len(train_set)} val={len(val_set)}")
        for ti in range(n_types):
            n_t=int((type_ids_arr==ti).sum())
            n_v=len(val_idx_per_type[ti])
            print(f"    [{type_names[ti]}] total={n_t}, val={n_v}, train={n_t-n_v}")
    else:
        per=", ".join(
            f"{type_names[ti]}:{int((type_ids_arr==ti).sum())-len(val_idx_per_type[ti])}/{len(val_idx_per_type[ti])}"
            for ti in range(n_types))
        print(f"  Split  : train={len(train_set)} val={len(val_set)}  "
              f"(per-type tr/va: {per})")

    # ─────────────────────────────────────────────────────────────
    # 3) Model build
    # ─────────────────────────────────────────────────────────────
    if VERB=="verbose":
        subsection("[BUILD] Model")
    ae=DeepCADBaselineAE(
        max_len=max_len, d_model=cfg.d_model, d_param=cfg.d_param,
        nhead=cfg.nhead, n_enc=cfg.n_enc, n_dec=cfg.n_dec, d_ff=cfg.d_ff,
        latent=cfg.latent, mem_tokens=cfg.mem_tokens, dropout=cfg.dropout,
        n_pool=getattr(cfg, "n_pool", 4),
        n_freq_bands=getattr(cfg, "n_freq_bands", 0),
        combine_param=getattr(cfg, "combine_param", False),
        n_dv_per_type=n_dv_per_type,
        z_param_dim=getattr(cfg, "z_param_dim", 64),
        param_encoder_hidden=getattr(cfg, "param_encoder_hidden", 128),
    ).to(device)
    mlp=SparamMLP(latent_dim=cfg.latent, n_freq=cfg.n_freq, n_sparam=n_sparam,
                  hidden_mult=cfg.mlp_hidden_mult, dropout=cfg.mlp_dropout,
                  n_types=n_types,
                  type_emb_dim=getattr(cfg, "type_emb_dim", 0)).to(device)

    if VERB=="verbose":
        diagnose_model(ae, mlp, cfg)
    else:
        ap=sum(p.numel() for p in ae.parameters())
        mp=sum(p.numel() for p in mlp.parameters())
        print(f"  Params : AE={ap/1e6:.1f}M  MLP={mp/1e6:.1f}M  total={(ap+mp)/1e6:.1f}M")

    # ─────────────────────────────────────────────────────────────
    # 4) Joint training: AE 복원 + S-param surrogate
    # ─────────────────────────────────────────────────────────────
    section("JOINT TRAINING — AE + S-param")
    print(f"  epochs={cfg.epochs}  bs={cfg.batch_size}  warmup={cfg.warmup}  wd={cfg.weight_decay}")
    print(f"  lr_ae={cfg.lr_ae:.2e}  lr_mlp={cfg.lr_mlp:.2e}")
    print(f"  loss = w_cmd*cmd_CE + w_prm*param_CE + w_sparam*MSE "
          f"+ w_var*var + w_cov*cov")
    print(f"         w_cmd={cfg.w_cmd}  w_prm={cfg.w_prm}  "
          f"w_sparam={cfg.w_sparam}  "
          f"w_var={cfg.w_var}  w_cov={cfg.w_cov}  var_target={cfg.vicreg_var_target}")
    print(f"         combine_param = {getattr(cfg, 'combine_param', False)}  "
          f"z_param_dim={getattr(cfg, 'z_param_dim', 0)}")

    opt=torch.optim.AdamW([
        {"params":list(ae.parameters()),  "lr":cfg.lr_ae},
        {"params":list(mlp.parameters()), "lr":cfg.lr_mlp},
    ], weight_decay=cfg.weight_decay, betas=(0.9, 0.98))

    def lr_sched(ep):
        if ep<cfg.warmup: return (ep+1)/max(1,cfg.warmup)
        return 0.5*(1+math.cos(math.pi*(ep-cfg.warmup)/max(1,cfg.epochs-cfg.warmup)))
    sch=torch.optim.lr_scheduler.LambdaLR(opt, lr_sched)

    tr_total=[]; va_total=[]; tr_sp=[]; va_sp=[]
    tr_var=[]; va_var=[]; tr_cov=[]; va_cov=[]; tr_zstd=[]
    best=float("inf"); best_ae_state=None; best_mlp_state=None

    print(f"\n  {'ep':>4s} | "
          f"{'tr_tot':>8s} {'tr_cmd':>6s} {'tr_prm':>6s} {'tr_sp':>8s} "
          f"{'tr_var':>7s} {'tr_cov':>7s} {'z_std':>6s}  "
          f"{'va_tot':>8s} {'va_sp':>8s} {'va_var':>7s} | {'lr_ae':>8s}")
    print("  "+"-"*120)
    log_every=max(1, cfg.epochs//10) if VERB=="simple" else 5

    for ep in range(1, cfg.epochs+1):
        tr=run_joint_epoch(ae, mlp, train_loader, opt, device, cfg, True)
        va=run_joint_epoch(ae, mlp, val_loader,   opt, device, cfg, False) if len(val_set)>0 else tr
        sch.step()
        tr_total.append(tr["total"]); va_total.append(va["total"])
        tr_sp.append(tr["sp"]);       va_sp.append(va["sp"])
        tr_var.append(tr["var"]);     va_var.append(va["var"])
        tr_cov.append(tr["cov"]);     va_cov.append(va["cov"])
        tr_zstd.append(tr["z_std"])

        if va["total"]<best:
            best=va["total"]
            best_ae_state ={k:v.detach().clone().cpu() for k,v in ae.state_dict().items()}
            best_mlp_state={k:v.detach().clone().cpu() for k,v in mlp.state_dict().items()}
            if cfg.save_checkpoints:
                torch.save({"ae_state":ae.state_dict(),
                            "mlp_state":mlp.state_dict(),
                            "max_len":max_len,
                            "sparam_mean":sparam_mean, "sparam_std":sparam_std,
                            "sparam_names":sparam_names,
                            "cfg":cfg.__dict__},
                           os.path.join(_SD, "deepcad_v11d_best.pth"))


        if ep==1 or ep%log_every==0 or ep==cfg.epochs:
            print(f"  {ep:4d} | "
                  f"{tr['total']:8.4f} {tr['cmd']:6.3f} {tr['prm']:6.3f} {tr['sp']:8.5f} "
                  f"{tr['var']:7.4f} {tr['cov']:7.4f} {tr['z_std']:6.3f}  "
                  f"{va['total']:8.4f} {va['sp']:8.5f} {va['var']:7.4f} | "
                  f"{opt.param_groups[0]['lr']:8.2e}")

    print(f"\n  ✓ Best val loss: {best:.5f}")

    # best state 로드
    if best_ae_state is not None:
        ae.load_state_dict({k:v.to(device) for k,v in best_ae_state.items()})
    if best_mlp_state is not None:
        mlp.load_state_dict({k:v.to(device) for k,v in best_mlp_state.items()})

    if VERB=="verbose":
        diagnose_reconstruction(ae, dataset,
            val_idx if len(val_idx)>0 else train_idx, device,
            max_samples=min(8, len(val_idx) or len(train_idx)))
    else:
        try:
            sel=(val_idx if len(val_idx)>0 else train_idx)[:min(8, len(val_idx) or len(train_idx))]
            ae.eval()
            cc=ct=ns_ok=0
            for si in sel:
                with torch.no_grad():
                    z = encode_indices(ae, dataset, si, device)
                    gen = ae.generate(z, max_gen_len=dataset.max_len)
                recon=trim_after_eos(gen[0].cpu().numpy().astype(np.int32))
                orig =trim_after_eos(dataset.raw[si])
                L=min(len(orig), len(recon))
                if L>0:
                    cc+=int((orig[:L,0]==recon[:L,0]).sum()); ct+=L
                if int((orig[:,0]==SOL).sum())==int((recon[:,0]==SOL).sum()):
                    ns_ok+=1
            print(f"  Recon  : cmd_acc={cc/max(ct,1)*100:.1f}%  struct_match={ns_ok}/{len(sel)}")
        except Exception as _e:
            print(f"  ⚠ recon quick-check failed: {_e}")

    # ─────────────────────────────────────────────────────────────
    # 6) Evaluation + 시각화
    # ─────────────────────────────────────────────────────────────
    section("EVALUATION (best joint state)")
    ae.eval(); mlp.eval()

    # Loss curves figure (total + sparam component)
    fig,(ax_t, ax_s) = plt.subplots(1, 2, figsize=(11, 4), facecolor="white")
    epochs_x = range(1, cfg.epochs+1)
    ax_t.plot(epochs_x, tr_total, lw=1.6, label="train", color="#4C9BE8")
    ax_t.plot(epochs_x, va_total, lw=1.6, label="val",   color="#E05C5C")
    ax_t.set_title("Total joint loss",  fontweight="normal")
    ax_t.set_xlabel("epoch"); ax_t.legend(); ax_t.grid(True, alpha=0.2)
    ax_s.plot(epochs_x, tr_sp, lw=1.6, label="train", color="#4C9BE8")
    ax_s.plot(epochs_x, va_sp, lw=1.6, label="val",   color="#E05C5C")
    ax_s.set_title("S-param MSE (normalized)",  fontweight="normal")
    ax_s.set_xlabel("epoch"); ax_s.legend(); ax_s.grid(True, alpha=0.2)
    plt.tight_layout()

    # ── Type별 reconstruction 정확도 (콘솔 표 1개) ──
    print(f"\n  Per-type val reconstruction accuracy:")
    print(f"  {'type':<10s}  {'n_val':>6s}  {'cmd_acc':>10s}  {'prm_MAE':>10s}  {'struct_match':>13s}")
    print("  " + "-"*54)
    with torch.no_grad():
        for ti in range(n_types):
            tname = type_names[ti]
            v_idx_t = val_idx_per_type.get(ti, [])
            if not v_idx_t:
                print(f"  {tname:<10s}  (no val samples)")
                continue
            cmd_corr = 0; cmd_total = 0
            prm_abs = 0.0; prm_count = 0
            struct_match = 0
            for vi in v_idx_t:
                orig = dataset.raw[vi]
                z = encode_indices(ae, dataset, vi, device)
                gen = ae.generate(z, max_gen_len=max_len)
                recon = trim_after_eos(gen[0].cpu().numpy().astype(np.int32))
                L = min(orig.shape[0], recon.shape[0])
                if L > 0:
                    cmd_corr += int((orig[:L,0] == recon[:L,0]).sum())
                    cmd_total += L
                    o_p = orig[:L, 1:]; r_p = recon[:L, 1:]
                    valid = (o_p >= 0) & (r_p >= 0)
                    if valid.any():
                        prm_abs += float(np.abs(
                            o_p[valid].astype(np.int64) - r_p[valid].astype(np.int64)
                        ).sum())
                        prm_count += int(valid.sum())
                n_ext_o = int((orig[:,0] == EXT).sum())
                n_ext_r = int((recon[:,0] == EXT).sum())
                if n_ext_o == n_ext_r:
                    struct_match += 1
            cmd_acc = cmd_corr / max(cmd_total, 1)
            prm_mae = prm_abs / max(prm_count, 1)
            sm_pct  = struct_match / len(v_idx_t)
            print(f"  {tname:<10s}  {len(v_idx_t):>6d}  "
                  f"{cmd_acc*100:>9.2f}%  {prm_mae:>10.3f}  {sm_pct*100:>12.1f}%")

    # ── Type별 reconstruction figure (sample 1개씩) ──
    for ti in range(n_types):
        tname=type_names[ti]
        v_idx_t=val_idx_per_type.get(ti, [])
        if not v_idx_t: continue
        pi=random.choice(v_idx_t)
        orig_tok=dataset.raw[pi]
        fname=f"[{tname}] " + (os.path.basename(npy_files[pi])
                                if pi<len(npy_files) else f"sample_{pi}")
        with torch.no_grad():
            z = encode_indices(ae, dataset, pi, device)
            gen = ae.generate(z, max_gen_len=max_len)
        recon_tok=trim_after_eos(gen[0].cpu().numpy().astype(np.int32))
        json_data=dataset.load_json(pi)
        show_comparison(orig_tok=orig_tok, recon_tok=recon_tok,
                        fname=fname, save_path="", json_data=json_data)

    # ── Type별 S-param prediction figure + 채널별 RMSE 콘솔 출력 ──
    freqs=np.linspace(cfg.freq_start, cfg.freq_end, cfg.n_freq)
    colors=["#4C9BE8","#E05C5C","#6DBF67","#F4A340","#A57CC1","#4ECBCB"]

    # 전체 평균용 누적
    overall_db_sq_sum = 0.0     # Σ (pred_dB - true_dB)² 모든 샘플·주파수·채널
    overall_count     = 0
    summary_per_type  = []      # [(tname, ch_rmse_arr, overall_rmse), ...]

    for ti in range(n_types):
        tname=type_names[ti]
        v_idx_t=val_idx_per_type.get(ti, [])
        if not v_idx_t: continue
        # val type-t 전체 inference
        all_pred=[]; all_true=[]
        with torch.no_grad():
            for vi in v_idx_t:
                item = dataset[vi]
                sp_norm = item[1]; tid = item[2]
                z = encode_indices(ae, dataset, vi, device)
                tid_b = tid.unsqueeze(0).to(device)
                pred_norm = mlp(z, tid_b).cpu().numpy()[0]        # ★ type-aware
                pred_real = pred_norm * (sparam_std+1e-8) + sparam_mean
                true_real = sp_norm.numpy() * (sparam_std+1e-8) + sparam_mean
                all_pred.append(pred_real); all_true.append(true_real)
        all_pred=np.array(all_pred); all_true=np.array(all_true)   # (n_v, n_freq, n_sparam)
        n_pairs = len(sparam_names)//2

        # ── 채널별 dB RMSE 계산 (모든 val 샘플 평균) ──
        ch_db_sq_sum = np.zeros(n_pairs)
        ch_count     = np.zeros(n_pairs)
        ch_labels    = None
        for i in range(all_pred.shape[0]):
            pm, mn = reim_to_mag_db(all_pred[i], sparam_names)   # (n_freq, n_pairs)
            tm, _  = reim_to_mag_db(all_true[i], sparam_names)
            if ch_labels is None: ch_labels = mn
            diff_sq = (pm - tm)**2
            ch_db_sq_sum += diff_sq.sum(axis=0)
            ch_count     += diff_sq.shape[0]
        ch_rmse = np.sqrt(ch_db_sq_sum / np.maximum(ch_count, 1))

        # ★ Diagonal 채널만 (S11/S22/S33) overall RMSE 계산
        diag_mask = diagonal_channel_mask(ch_labels)
        if diag_mask.any():
            type_overall_rmse = float(np.sqrt(
                ch_db_sq_sum[diag_mask].sum() / max(ch_count[diag_mask].sum(), 1)
            ))
            # 전체 평균에 누적 (diagonal만)
            overall_db_sq_sum += ch_db_sq_sum[diag_mask].sum()
            overall_count     += ch_count[diag_mask].sum()
        else:
