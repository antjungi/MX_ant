def evaluate_sparam_predictions(
    ae,
    mlp,
    dataset,
    val_idx_per_type,
    type_names,
    sparam_mean,
    sparam_std,
    sparam_names,
    cfg,
    device,
):
    section("Return-3 S-param prediction RMSE")

    ae.eval()
    mlp.eval()

    freqs = np.linspace(cfg.freq_start, cfg.freq_end, cfg.n_freq)

    overall_sq = 0.0
    overall_count = 0

    summary = []

    for ti, tname in enumerate(type_names):
        v_idx_t = val_idx_per_type.get(ti, [])
        if not v_idx_t:
            continue

        all_pred = []
        all_true = []

        with torch.no_grad():
            for vi in v_idx_t:
                tok_in, sp_norm, tid = dataset[vi]

                z = ae.encode(tok_in.unsqueeze(0).to(device))
                tid_b = tid.unsqueeze(0).to(device)

                pred_norm = mlp(z, tid_b).cpu().numpy()[0]

                pred_real = pred_norm * (sparam_std + 1e-8) + sparam_mean
                true_real = sp_norm.numpy() * (sparam_std + 1e-8) + sparam_mean

                all_pred.append(pred_real)
                all_true.append(true_real)

        all_pred = np.array(all_pred)
        all_true = np.array(all_true)

        n_pairs = len(sparam_names) // 2

        ch_sq_sum = np.zeros(n_pairs)
        ch_count = np.zeros(n_pairs)
        ch_labels = None

        for i in range(all_pred.shape[0]):
            pm, labels = reim_to_mag_db(all_pred[i], sparam_names)
            tm, _ = reim_to_mag_db(all_true[i], sparam_names)

            if ch_labels is None:
                ch_labels = labels

            diff_sq = (pm - tm) ** 2

            ch_sq_sum += diff_sq.sum(axis=0)
            ch_count += diff_sq.shape[0]

        ch_rmse = np.sqrt(ch_sq_sum / np.maximum(ch_count, 1))

        type_rmse = float(np.sqrt(ch_sq_sum.sum() / max(ch_count.sum(), 1)))

        overall_sq += ch_sq_sum.sum()
        overall_count += ch_count.sum()

        summary.append((tname, ch_labels, ch_rmse, type_rmse))

        print(f"\n  [{tname}] Return-3 S-param RMSE (val, n={len(v_idx_t)})")
        print(f"  {'channel':<10s} {'RMSE (dB)':>10s}")
        print("  " + "-" * 24)

        for lbl, rm in zip(ch_labels, ch_rmse):
            print(f"  {lbl:<10s} {rm:>10.3f}")

        print(f"  {'AVG':<10s} {type_rmse:>10.3f}")

        n_show = min(cfg.n_preview, len(v_idx_t))
        if n_show > 0:
            pick = random.sample(range(len(v_idx_t)), n_show)

            fig, axes = plt.subplots(
                n_show,
                n_pairs,
                figsize=(5 * n_pairs, 3.3 * n_show),
                squeeze=False,
                facecolor="white",
            )

            fig.suptitle(
                f"[{tname}] Return-3 S-param Prediction, avg RMSE={type_rmse:.2f} dB",
                fontsize=13,
                y=1.01,
            )

            for row, si in enumerate(pick):
                pm, labels = reim_to_mag_db(all_pred[si], sparam_names)
                tm, _ = reim_to_mag_db(all_true[si], sparam_names)

                sample_idx = v_idx_t[si]

                for col in range(n_pairs):
                    ax = axes[row, col]
                    ax.plot(freqs, tm[:, col], lw=2, label="Actual")
                    ax.plot(freqs, pm[:, col], lw=2, ls="--", label="Predicted")

                    ax.set_title(f"Sample {sample_idx} — {labels[col]}")
                    ax.set_xlabel("Freq (GHz)")
                    ax.set_ylabel("dB")
                    ax.grid(True, alpha=0.2)
                    ax.legend(fontsize=8)

            plt.tight_layout()

    if overall_count > 0:
        total_rmse = float(np.sqrt(overall_sq / overall_count))

        print("\n  ══ Overall Return-3 RMSE summary ══")
        print(f"  {'type':<10s} {'RMSE (dB)':>12s}")
        print("  " + "-" * 25)

        for tname, _, _, t_rmse in summary:
            print(f"  {tname:<10s} {t_rmse:>12.3f}")

        print("  " + "-" * 25)
        print(f"  {'TOTAL':<10s} {total_rmse:>12.3f}")


