def split_sequence_to_bodies(tokens):
    """
    SOL ... EXT 를 하나의 body로 분리.
    순서는 dataset에는 보관하지만, loss에서는 Hungarian matching으로 무시.
    """
    tokens = trim_after_eos(tokens)
    bodies = []
    cur = []
    active = False

    for row in tokens:
        cmd = int(row[0])

        if cmd == EOS:
            break

        if cmd == SOL:
            if cur:
                bodies.append(np.stack(cur, axis=0).astype(np.int32))
            cur = [row.copy()]
            active = True
            continue

        if active:
            cur.append(row.copy())
            if cmd == EXT:
                bodies.append(np.stack(cur, axis=0).astype(np.int32))
                cur = []
                active = False

    if cur:
        # EXT 없이 끝난 비정상 body도 일단 보관
        bodies.append(np.stack(cur, axis=0).astype(np.int32))

    valid = []
    for b in bodies:
        if len(b) >= 2 and int(b[0, 0]) == SOL:
            valid.append(b)

    return valid


def pad_body_tokens(body, max_body_len):
    out = np.full((max_body_len, 17), PAD_V, dtype=np.int32)
    L = min(len(body), max_body_len)
    out[:L] = body[:L]

    # 잘렸는데 EXT가 없으면 마지막을 EXT로 강제
    if L == max_body_len and EXT not in out[:, 0]:
        out[-1] = np.full((17,), PAD_V, dtype=np.int32)
        out[-1, 0] = EXT

    return out


def bodies_to_sequence(bodies, presence=None, presence_thr=0.5):
    rows = []
    for i, b in enumerate(bodies):
        if presence is not None:
            if float(presence[i]) < presence_thr:
                continue

        b = np.asarray(b, dtype=np.int32)
        for row in b:
            cmd = int(row[0])
            if cmd < 0 or cmd == PAD_CMD_CLASS:
                continue
            rows.append(row.copy())
            if cmd == EXT:
                break

    eos = np.full((17,), PAD_V, dtype=np.int32)
    eos[0] = EOS
    rows.append(eos)

    return np.stack(rows, axis=0).astype(np.int32)


