def load_design_vars_csv(npy_files, csv_path):
    """
    CSV format:
        filename, var1, var2, var3, ...
        5679_tokens.npy, 1.5, 0.3, 2.1, ...

    npy_files 의 순서대로 design vars 를 (N, n_dv) array 로 반환.
    """
    if pd is None:
        raise ImportError("pandas 필요: pip install pandas")
    if not os.path.exists(csv_path):
        raise FileNotFoundError(
            f"\n  Design vars CSV 없음: {csv_path}\n"
            f"  파일을 다음 형식으로 만들어주세요:\n"
            f"    filename,var1,var2,var3,...\n"
            f"    5679_tokens.npy,1.5,0.3,2.1,...\n"
            f"    2487_tokens.npy,1.7,0.4,2.0,..."
        )
    df = pd.read_csv(csv_path)
    if df.shape[1] < 2:
        raise ValueError(f"CSV 컬럼 부족: {df.shape}. 최소 2개 (filename + 1 var) 필요.")
    fname_col = df.columns[0]
    var_cols  = list(df.columns[1:])
    df = df.set_index(fname_col)
    dv_list  = []; missing = []
    for f in npy_files:
        fname = os.path.basename(f)
        if fname not in df.index:
            missing.append(fname); continue
        dv_list.append(df.loc[fname].values.astype(np.float32))
    if missing:
        raise KeyError(
            f"\n  CSV 에 없는 token 파일 {len(missing)}개:\n"
            f"    {missing[:5]}{'...' if len(missing)>5 else ''}\n"
            f"  CSV 첫 컬럼이 token 파일명(예: '5679_tokens.npy')과 정확히 일치해야 합니다."
        )
    arr = np.stack(dv_list, 0)
    return arr, var_cols


def load_design_vars_per_type(npy_files, type_ids_arr, csv_paths_per_type,
                               normalize=True):
    """
    ★ v11l: type 별 별도 CSV 에서 design vars 로드.

    Args:
        npy_files          : 전체 token 파일 리스트 (순서 유지)
        type_ids_arr       : 각 sample 의 type id (np.ndarray, shape (N,))
        csv_paths_per_type : type 순서대로 csv path 들 (예: (csv_t1, csv_t2))
        normalize          : True 이면 type 별로 standardize (mean=0, std=1)

    Returns:
        vars_padded        : (N, max_n_dv) — 각 sample 의 vars (used + zero-padded)
        n_dv_per_type      : {type_id: n_dv}
        var_names_per_type : {type_id: [var name list]}
        norm_stats         : {type_id: (mean, std)} or None
    """
    if pd is None:
        raise ImportError("pandas 필요: pip install pandas")

    type_ids_arr = np.asarray(type_ids_arr, dtype=np.int64)
    unique_types = sorted(set(int(t) for t in type_ids_arr.tolist()))

    if len(csv_paths_per_type) != len(unique_types):
        raise ValueError(
            f"csv_paths_per_type 길이({len(csv_paths_per_type)}) != "
            f"unique types ({len(unique_types)}: {unique_types})"
        )

    n_dv_per_type      = {}
    var_names_per_type = {}
    norm_stats         = {}
    raw_per_type       = {}

    for t, csv_path in zip(unique_types, csv_paths_per_type):
        idx_t = np.where(type_ids_arr == t)[0]
        files_t = [npy_files[i] for i in idx_t]
        arr_t, var_cols = load_design_vars_csv(files_t, csv_path)         # (N_t, n_dv_t)
        n_dv_per_type[t]      = arr_t.shape[1]
        var_names_per_type[t] = list(var_cols)

        if normalize:
            mu = arr_t.mean(axis=0)
            sd = arr_t.std(axis=0) + 1e-8
            arr_t_norm = (arr_t - mu) / sd
            norm_stats[t] = (mu, sd)
        else:
            arr_t_norm = arr_t
            norm_stats[t] = (np.zeros(arr_t.shape[1]), np.ones(arr_t.shape[1]))

        raw_per_type[t] = (idx_t, arr_t_norm)

    max_n_dv = max(n_dv_per_type.values())
    N = len(npy_files)
    vars_padded = np.zeros((N, max_n_dv), dtype=np.float32)
    for t, (idx_t, arr_t_norm) in raw_per_type.items():
        n_dv_t = n_dv_per_type[t]
        vars_padded[idx_t, :n_dv_t] = arr_t_norm

    return vars_padded, n_dv_per_type, var_names_per_type, norm_stats


class SparamMLP_Mode(nn.Module):
    """3개 모드를 하나의 클래스로:
       mode = 'z' / 'dv' / 'z_dv' 따라 input dim 결정."""
    def __init__(self, latent_dim, n_dv, n_freq, n_sparam,
                 mode="z", hidden_mult=2.0, dropout=0.3):
        super().__init__()
        self.mode = mode
        if   mode == "z":    in_dim = latent_dim
        elif mode == "dv":   in_dim = n_dv
        elif mode == "z_dv": in_dim = latent_dim + n_dv
        else: raise ValueError(f"unknown mode: {mode}")
        self.in_dim    = in_dim
        self.n_freq    = n_freq
        self.n_sparam  = n_sparam
        out_dim = n_freq * n_sparam
        h1 = max(in_dim, 64)
        h2 = max(int(in_dim * hidden_mult), 64)
        self.net = nn.Sequential(
            nn.Linear(in_dim, h1), nn.LayerNorm(h1), nn.GELU(), nn.Dropout(dropout),
            nn.Linear(h1, h2),     nn.LayerNorm(h2), nn.GELU(), nn.Dropout(dropout),
            nn.Linear(h2, out_dim),
        )

    def forward(self, z, dv):
        if   self.mode == "z":    x = z
        elif self.mode == "dv":   x = dv
        elif self.mode == "z_dv": x = torch.cat([z, dv], dim=-1)
        return self.net(x).view(-1, self.n_freq, self.n_sparam)


def train_sparam_mlp_standalone(model, train_data, val_data, device,
                                 epochs=300, lr=1e-3, weight_decay=1e-3,
                                 batch_size=64, log_every=None, verbose=True):
    """train/val_data: dict with 'z', 'dv', 'sp'. AE/encoder freeze 가정."""
    opt = torch.optim.AdamW(model.parameters(), lr=lr,
                            weight_decay=weight_decay, betas=(0.9, 0.98))
    z_tr, dv_tr, sp_tr = train_data['z'], train_data['dv'], train_data['sp']
    z_va, dv_va, sp_va = val_data['z'],   val_data['dv'],   val_data['sp']
    N_tr = z_tr.size(0)
    if log_every is None: log_every = max(1, epochs // 8)
    best = float("inf"); best_state = None
    tr_hist = []; va_hist = []
    for ep in range(1, epochs+1):
        model.train()
        perm = torch.randperm(N_tr, device=device)
        tr_loss = 0.0; n_b = 0
        for i in range(0, N_tr, batch_size):
            idx = perm[i:i+batch_size]
            opt.zero_grad(set_to_none=True)
            pred = model(z_tr[idx], dv_tr[idx])
            loss = F.mse_loss(pred, sp_tr[idx])
            loss.backward()
            opt.step()
            tr_loss += loss.item(); n_b += 1
        tr_loss /= max(n_b, 1)
        model.eval()
        with torch.no_grad():
            va_pred = model(z_va, dv_va)
            va_loss = F.mse_loss(va_pred, sp_va).item()
        tr_hist.append(tr_loss); va_hist.append(va_loss)
        if va_loss < best:
            best = va_loss
            best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}
        if verbose and (ep == 1 or ep % log_every == 0 or ep == epochs):
            print(f"      ep{ep:4d}/{epochs}  tr_mse={tr_loss:.5f}  "
                  f"va_mse={va_loss:.5f}  (best {best:.5f})")
    if best_state is not None:
        model.load_state_dict(best_state)
    return model, best, tr_hist, va_hist


def evaluate_sparam_mlp_modes(model, val_data, sparam_mean, sparam_std, sparam_names,
                               type_ids_va, type_names, device):
    """채널별/타입별 dB RMSE."""
    model.eval()
    z_va, dv_va, sp_va = val_data['z'], val_data['dv'], val_data['sp']
    sparam_mean = np.asarray(sparam_mean); sparam_std = np.asarray(sparam_std)
    with torch.no_grad():
        pred_norm = model(z_va, dv_va).cpu().numpy()
    sp_norm = sp_va.cpu().numpy()
    pred_real = pred_norm * (sparam_std + 1e-8) + sparam_mean
    true_real = sp_norm   * (sparam_std + 1e-8) + sparam_mean
    type_ids_np = (type_ids_va.cpu().numpy()
                   if torch.is_tensor(type_ids_va) else np.asarray(type_ids_va))
    n_pairs = len(sparam_names) // 2
    result = {"per_type": {}, "overall_diag_rmse": None,
              "ch_labels": None, "diag_mask": None}
    overall_diag_sq = 0.0; overall_diag_n = 0
    for ti, tname in enumerate(type_names):
        m = (type_ids_np == ti)
        if not m.any(): continue
        pr = pred_real[m]; tr = true_real[m]
        ch_sq = np.zeros(n_pairs); ch_n = 0
        ch_lbls = None
        for i in range(pr.shape[0]):
            pm, lbls = reim_to_mag_db(pr[i], sparam_names)
            tm, _    = reim_to_mag_db(tr[i], sparam_names)
            if ch_lbls is None: ch_lbls = lbls
            ch_sq += ((pm - tm) ** 2).sum(axis=0)
            ch_n  += pm.shape[0]
        ch_rmse = np.sqrt(ch_sq / max(ch_n, 1))
        diag_m = diagonal_channel_mask(ch_lbls)
        if diag_m.any():
            d_n   = ch_n * int(diag_m.sum())
            d_rmse = float(np.sqrt(ch_sq[diag_m].sum() / max(d_n, 1)))
            overall_diag_sq += ch_sq[diag_m].sum()
            overall_diag_n  += d_n
        else:
            d_rmse = float(np.sqrt(ch_sq.sum() / max(ch_n * len(ch_lbls), 1)))
        result["per_type"][tname] = {"n": int(m.sum()),
                                     "ch_rmse": ch_rmse,
                                     "diag_rmse": d_rmse}
        if result["ch_labels"] is None:
            result["ch_labels"] = ch_lbls
            result["diag_mask"] = diag_m
    if overall_diag_n > 0:
        result["overall_diag_rmse"] = float(np.sqrt(overall_diag_sq / overall_diag_n))
    return result


