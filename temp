    # ── 로그 파일 (콘솔 + 파일 동시) ──
    from datetime import datetime as _dt
    _log_tag=_dt.now().strftime("%Y%m%d_%H%M%S")
    _log_path=os.path.join(_SD, f"training_{_log_tag}.log")
    _log_file=setup_log_file(_log_path)
    print(f"[LOG] Tee active  →  file: {_log_path}")
    print(f"[LOG] 이 줄이 터미널에 보이고 파일에도 저장되면 로깅 정상.")

    _t=time.time()

    # ══════════════════════════════════════════════════════════════
    # ★★ 실행 프리셋 선택 ★★
    #   "tiny"   : 3~5분    — 알고리즘 추세 확인
    #   "small"  : 20~30분  — 본격 비교 실험
    #   "full"   : 5~7시간  — overnight, 최종 성능
    #   "custom" : 아래 CFG 값 그대로
    # ══════════════════════════════════════════════════════════════
    PRESET = "tiny"

    # ★★ 실행 모드 선택 ★★
    #   "train"     : 기존 학습 (AE + MLP joint training, 진단)
    #   "ablation"  : Hybrid ablation (z vs design_vars vs both)
    #                 → DESIGN_VARS_CSV 필요 (raw design vars)
    MODE = "train"

    # ── ablation 모드용 설정 (MODE="ablation" 일 때만 사용) ──
    DESIGN_VARS_CSV  = os.path.join(_SD, "design_vars.csv")
    #   포맷: filename, var1, var2, ...
    #         5679_tokens.npy, 1.5, 0.3, ...
    ABLATION_MLP_EPOCHS     = 300       # AE 학습 후 MLP 빠르게 (frozen z)
    ABLATION_MLP_BATCH_SIZE = 64
    ABLATION_MLP_LR         = 1e-3

    # ★★ 로그 상세도 ★★
    #   "simple"  : 짧게 (기본)
    #   "verbose" : 전체 진단표
    LOG_VERBOSITY = "simple"

    # ══════════════════════════════════════════════════════════════
    # ★★ 사용할 타입 선택 ★★
    #
    #   USE_TYPES 에 1, 2, 3 ... 숫자 또는 그 조합을 적으면 끝.
    #     USE_TYPES = [1]        ← type1만 사용
    #     USE_TYPES = [2]        ← type2만 사용
    #     USE_TYPES = [1, 2]     ← 둘 다 사용
    #     USE_TYPES = [1, 2, 3]  ← 셋 다
    #
    # ★ 각 타입 번호 ↔ 데이터 경로 매핑은 아래 _TYPE_DATA 한 곳에서만 관리.
    # ══════════════════════════════════════════════════════════════
    USE_TYPES = [1, 2]

    _TYPE_DATA = {
        # 번호:  (npy_dir,                                    sparam_glob)
        1: (os.path.join(_SD, "hfss_results", "step_test"),
            os.path.join(_SD, "hfss_results", "sparam", "[12].*")),
        2: (os.path.join(_SD, "hfss_results", "step_test1"),
            os.path.join(_SD, "hfss_results", "sparam", "3.*")),
        # 새 타입 추가시 한 줄만:
        # 3: (os.path.join(_SD, "...", "step_test2"),
        #     os.path.join(_SD, "...", "sparam", "4.*")),
    }

    # ── USE_TYPES 검증 + cfg 인자 자동 구성 ──
    if not USE_TYPES:
        raise ValueError("USE_TYPES 가 비어있음. 최소 1개 골라야 함.")
    for _ut in USE_TYPES:
        if _ut not in _TYPE_DATA:
            raise ValueError(f"USE_TYPES에 정의 안 된 타입 {_ut} (가능: {list(_TYPE_DATA.keys())})")
    _npy_dirs        = tuple(_TYPE_DATA[t][0] for t in USE_TYPES)
    _sparam_globs    = tuple(_TYPE_DATA[t][1] for t in USE_TYPES)
    _type_names      = tuple(f"type{t}" for t in USE_TYPES)
    _n_samples_tuple = tuple(0 for _ in USE_TYPES)   # 0 = 전체 (preset이 덮어씀)
    print(f"[CONFIG] 사용 타입: {list(USE_TYPES)}  →  {_type_names}")

    cfg=CFG(
        preset=PRESET,
        log_verbosity=LOG_VERBOSITY,

        # ─────────────────────────────────────────────────────────
        # ★ Multi-type 데이터 (USE_TYPES에서 자동 구성)
        # ─────────────────────────────────────────────────────────
        npy_dirs           = _npy_dirs,
        sparam_globs       = _sparam_globs,
        type_names         = _type_names,
        n_samples_per_type = _n_samples_tuple,

        sample_mode="random",
        n_freq=401, freq_start=1.0, freq_end=5.0,

        # 학습률 (★ joint training: AE 전체 + MLP 한 번에)
        lr_ae=3e-4, lr_mlp=1e-3,
        grad_clip=1.0, val_ratio=0.15,

        # Loss weights — joint loss = w_cmd*cmd_CE + w_prm*param_CE + w_sparam*MSE
        # w_sparam=0 으로 두면 baseline AE-only와 동일 (S-param surrogate 학습 비활성)
        # ★ v10g: w_sparam 1.0 → 5.0 으로 키움.
        #   v10f baseline에서 prm_mae가 type2에서 4× 큰 게 sparam 학습 자원을 빼앗음.
        #   sparam loss를 키우면 optimizer가 sparam 쪽으로 gradient 더 흘려보냄.
        w_cmd=1.0, w_prm=1.0,
        w_sparam=5.0,

        # ★ v11g: VICReg variance + covariance (둘이 페어)
        #   v11f (cov-only) 결과: z magnitude collapse (std 4.93 → 0.14, ||z||=3.0)
        #   원인: cov penalty는 z=0 으로 가는 게 가장 쉬운 해 → var penalty 가 buffer
        #   처방: 표준 VICReg 형태로 둘 다 활성화
        #     w_var=1.0, var_target=1.0 → 각 dim std 가 1.0 이상이도록 강제
        #     w_cov=0.2                  → off-diagonal cov 줄여 effective rank 증가
        #   목표 결과: std≈1.0, ||z||≈sqrt(D)≈11.3, effective rank @99% > 30
        w_var=1.0, w_cov=0.2, vicreg_var_target=1.0,

        # ★ v11l: Param encoder branch (token z + param z → combined z)
        #   raw design vars 를 별도 small MLP 로 z_param 만든 후, z_token 과 concat →
        #   Linear → z_combined. decoder + sparam MLP 둘 다 z_combined 사용.
        #   type 별 design vars 개수가 달라도 type 별 ParamEncoder 가 자동 처리.
        #
        #   - combine_param=False : 기존 baseline (z_token only)
        #   - combine_param=True  : param branch 활성. design_vars_csvs 필요.
        combine_param=True,
        design_vars_csvs=("design_vars_type1.csv", "design_vars_type2.csv"),
        z_param_dim=64,
        param_encoder_hidden=128,

        # ★ v11i: type embedding 비활성화 (inverse design 자유도 우선)
        #   typeID embedding 은 sparam 정확도엔 도움될 수 있지만, latent inverse 시
        #   type 인자가 categorical 이라 학습 set 의 type cluster 안에서만 탐색 가능 →
        #   새 구조 합성 자유도가 제한됨. 추후 encoder-side type injection 으로 z 자체에
        #   type 정보 baked-in 하는 방식 검토 (옵션 B). 지금은 type 무시하고 baseline.
        #
        #   - type_emb_dim=0  → SparamMLP 가 z 만 받음 (TypeEncoder.active=False)
        #   - mlp_hidden_mult : v11h ablation 결과 ×2 sweet spot 그대로 유지
        type_emb_dim=0,
        mlp_hidden_mult=2.0,
        mlp_dropout=0.3,

        # 시각화
        n_preview=2,

        # 디스크 저장
        save_checkpoints=False,
        save_latent_npy=False,

        # ─────────────────────────────────────────────────────────────
        # ★ Inverse Latent Optimization (학습 후 z* 찾기)
        #    각 |S| 채널마다:
        #      enabled       : True/False
        #      freq_range    : (f_lo, f_hi) GHz — 매칭 강요 범위
        #      db_threshold  : 이 dB 이하로 떨어뜨릴 것 (-10dB = -10dB 이하 통과대역)
        #    Loss = mean over f∈범위 of  relu( |S|_dB(f) − db_threshold )
        # ─────────────────────────────────────────────────────────────
    )

    try:
        if MODE == "train":
            train(cfg)
        elif MODE == "ablation":
            run_ablation(cfg, design_vars_csv=DESIGN_VARS_CSV,
                         mlp_epochs=ABLATION_MLP_EPOCHS,
                         mlp_batch_size=ABLATION_MLP_BATCH_SIZE,
                         mlp_lr=ABLATION_MLP_LR)
        else:
            raise ValueError(f"unknown MODE: {MODE!r}  (train/ablation)")
    except Exception as _e:
        import traceback as _tb
        print(f"\n[FATAL] {type(_e).__name__}: {_e}")
        _tb.print_exc()
        el=time.time()-_t; h=int(el//3600); m=int((el%3600)//60); s=el%60
        print(f"\n  경과 시간 (실패 시점): {h}h {m}m {s:.1f}s")
