def make_target_db_curve(freqs_full, target_freqs, bandwidth_ghz, deep_db=-15.0, flat_db=0.0):
    freqs_full = np.asarray(freqs_full, dtype=np.float32)
    target = np.full((len(freqs_full), 3), flat_db, dtype=np.float32)
    masks = np.zeros((len(freqs_full), 3), dtype=bool)

    half = bandwidth_ghz / 2.0
    for c, f0 in enumerate(target_freqs):
        m = np.abs(freqs_full - f0) <= half
        target[m, c] = deep_db
        masks[:, c] = m

    return target, masks


def inverse_design_optimize(ae, mlp, dataset, cfg, device):
    section("INVERSE DESIGN — body-set latent optimization")

    if cfg.inverse_target_type_id is None:
        prior_indices = list(range(len(dataset)))
        print("  prior: all types")
    else:
        prior_indices = [
            i for i in range(len(dataset))
            if int(dataset.type_ids[i]) == int(cfg.inverse_target_type_id)
        ]
        print(f"  prior: type_id={cfg.inverse_target_type_id}, n={len(prior_indices)}")

    z_prior_np, _ = collect_latents(ae, dataset, prior_indices, device)
    z_prior = torch.tensor(z_prior_np, dtype=torch.float32, device=device)

    z_mean = z_prior.mean(dim=0)
    z_std = z_prior.std(dim=0).clamp(min=1e-3)

    target_full_np, masks_np = make_target_db_curve(
        dataset.freqs_full,
        cfg.inverse_freqs,
        cfg.inverse_bw_ghz,
        deep_db=cfg.inverse_deep_db,
        flat_db=0.0,
    )

    target_full = torch.tensor(target_full_np, dtype=torch.float32, device=device)
    masks = torch.tensor(masks_np, dtype=torch.bool, device=device)
    interp_w = torch.tensor(dataset.interp_matrix, dtype=torch.float32, device=device)

    rng = np.random.default_rng(cfg.seed)
    n_starts = min(cfg.inverse_n_starts, len(prior_indices))
    pick = rng.choice(z_prior.size(0), size=n_starts, replace=False)

    z = z_prior[pick].clone().detach().requires_grad_(True)
    opt = torch.optim.Adam([z], lr=cfg.inverse_lr)

    best_loss = float("inf")
    best_z = None
    best_pred = None

    in_count = masks.float().sum(dim=0).clamp(min=1.0).unsqueeze(0)

    print(f"  targets: {cfg.inverse_freqs} GHz, bw={cfg.inverse_bw_ghz} GHz, deep={cfg.inverse_deep_db} dB")
    print(f"  starts={n_starts}, iters={cfg.inverse_n_iters}")

    for it in range(cfg.inverse_n_iters):
        progress = it / max(cfg.inverse_n_iters - 1, 1)
        prior_w = cfg.inverse_z_prior_weight + (
            cfg.inverse_z_prior_weight_end - cfg.inverse_z_prior_weight
        ) * progress

        opt.zero_grad()

        pred_sel = mlp(z)
        pred_full = interpolate_selected_to_full_torch(pred_sel, interp_w)

        diff = pred_full - target_full.unsqueeze(0)
        in_violate = F.relu(diff) ** 2
        in_band = (in_violate * masks.unsqueeze(0).float()).sum(dim=1) / in_count
        match_per = in_band.mean(dim=-1)

        z_reg = (((z - z_mean) / z_std) ** 2).mean(dim=-1)
        loss_per = match_per + prior_w * z_reg
        loss = loss_per.sum()

        loss.backward()
        opt.step()

        with torch.no_grad():
            bi = int(torch.argmin(match_per).item())
            cur = float(match_per[bi].item())
            if cur < best_loss:
                best_loss = cur
                best_z = z[bi:bi + 1].detach().clone()
                best_pred = pred_full[bi].detach().cpu().numpy()

        if it == 0 or (it + 1) % 100 == 0 or it == cfg.inverse_n_iters - 1:
            print(f"    iter {it+1:4d}/{cfg.inverse_n_iters} | best={best_loss:.4f} | prior_w={prior_w:.2e}")

    return {
        "best_z": best_z,
        "best_loss": best_loss,
        "best_pred": best_pred,
        "target_full": target_full_np,
        "masks": masks_np,
    }


