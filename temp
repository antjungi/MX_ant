# ★ Latent health 진단 (per-dim std vs S-param saliency)
#
# 목적: latent z의 각 dim을 다음 4가지로 분류
#   - dead    : std<threshold        → encoder가 활성화 못 시킴
#   - unused  : std OK, saliency 하위 → 활성이지만 sparam에 안 쓰임
#   - sleeper : std<thr, saliency↑   → 적게 변하는데 민감 (정상)
#   - used    : 그 외                 → 잘 쓰이는 dim
#
# 결과 해석:
#   dead 多   → VICReg variance penalty 효과 큼
#   unused 多 → covariance penalty 또는 to_z를 MLP화
#   둘 다 적음 → encoder 표현력/MLP capacity 의심
# ══════════════════════════════════════════════════════════════
@torch.no_grad()
def _collect_z_and_sp(ae, dataset, indices, device, batch_size=16):
    """주어진 인덱스의 (z, sp_normalized, type_ids)를 텐서로 수집."""
    ae.eval()
    z_list=[]; sp_list=[]; tid_list=[]
    has_vars = getattr(dataset, "vars", None) is not None and getattr(ae, "combine_param", False)
    for i in range(0, len(indices), batch_size):
        bi=indices[i:i+batch_size]
        toks=torch.stack([torch.tensor(dataset.padded[k], dtype=torch.float32) for k in bi]).to(device)
        sps =torch.stack([torch.tensor(dataset.sparam[k],  dtype=torch.float32) for k in bi]).to(device)
        tids=torch.tensor([int(dataset.type_ids[k]) for k in bi], dtype=torch.long).to(device)
        # ★ v11l: combine_param 활성 시 vars 같이
        if has_vars:
            vrs = torch.stack([torch.tensor(dataset.vars[k], dtype=torch.float32) for k in bi]).to(device)
            z = ae.encode_combined(toks, vars_padded=vrs, type_ids=tids)
        else:
            z = ae.encode(toks)
        z_list.append(z)
        sp_list.append(sps)
        tid_list.append(tids)
    return torch.cat(z_list,0), torch.cat(sp_list,0), torch.cat(tid_list,0)


# ★ v11l 헬퍼: dataset 의 인덱스 (또는 배치 인덱스 리스트) 의 z 를 combine 인지에 따라 자동 처리.
@torch.no_grad()
def encode_indices(ae, dataset, indices, device):
    """
    indices: int 또는 list[int]
    Returns: z (1, latent) or (B, latent) — combine_param 따라 z_token 또는 z_combined.
    """
    if isinstance(indices, int):
        idx_list = [indices]; squeeze = True
    else:
        idx_list = list(indices); squeeze = False
    has_vars = getattr(dataset, "vars", None) is not None and getattr(ae, "combine_param", False)
    toks = torch.stack([torch.tensor(dataset.padded[k], dtype=torch.float32) for k in idx_list]).to(device)
    if has_vars:
        vrs = torch.stack([torch.tensor(dataset.vars[k], dtype=torch.float32) for k in idx_list]).to(device)
        tids = torch.tensor([int(dataset.type_ids[k]) for k in idx_list], dtype=torch.long).to(device)
        z = ae.encode_combined(toks, vars_padded=vrs, type_ids=tids)
    else:
        z = ae.encode(toks)
    return z[0:1] if squeeze and z.size(0) == 1 else z


def diagnose_latent_health(ae, mlp, dataset, indices, device,
                           std_dead_thr=1e-2,
                           saliency_low_quantile=0.10,
                           type_ids=None, type_names=None,
                           save_fig=True):
    """
    각 latent dim의 std + sparam loss에 대한 saliency 측정.
    saliency = mean over batch of |∂L_sp/∂z_d|.

    indices : 분석에 쓸 sample index 리스트 (val_idx 권장)
    """
    section("[DIAG] Latent Health  (per-dim std vs S-param saliency)")
    if mlp is None:
        print("  ⚠ mlp = None → saliency 계산 불가, 스킵")
        return None
    if not indices:
        print("  ⚠ indices 비어있음")
        return None

    # 1) z, sp 수집
    z_t, sp_t, tid_t = _collect_z_and_sp(ae, dataset, indices, device)
    N, D = z_t.shape
    print(f"  Samples: N={N}   Latent dim D={D}")

    # 2) per-dim std (batch 분산)
    std = z_t.std(0)                                              # (D,)

    # 3) saliency: ∂L_sp/∂z 의 abs mean (전체 N 묶어서 한 번)
    z_g = z_t.detach().clone().requires_grad_(True)
    mlp.eval()
    with torch.enable_grad():
        pred = mlp(z_g, tid_t)                                    # ★ type-aware
        loss = F.mse_loss(pred, sp_t)
        grad = torch.autograd.grad(loss, z_g)[0]                  # (N, D)
    saliency = grad.abs().mean(0)                                 # (D,)

    s_np   = std.cpu().numpy()
    sal_np = saliency.cpu().numpy()
    sal_thr = float(np.quantile(sal_np, saliency_low_quantile))

    # 4) 분류
    dead_mask    = s_np < std_dead_thr
    low_sal_mask = sal_np <= sal_thr
    sleeper_mask = dead_mask & (~low_sal_mask)                    # std 작은데 saliency 큼
    pure_dead    = dead_mask &  low_sal_mask                       # 완전 dead
    unused_mask  = (~dead_mask) & low_sal_mask                     # 활성이지만 안 쓰임
    used_mask    = (~dead_mask) & (~low_sal_mask)

    n_pd  = int(pure_dead.sum())
    n_sl  = int(sleeper_mask.sum())
    n_un  = int(unused_mask.sum())
    n_us  = int(used_mask.sum())

    # 5) 통계 출력
    print(f"\n  Per-dim 통계:")
    print(f"    std       : mean={s_np.mean():.4f}   median={np.median(s_np):.4f}   "
          f"min={s_np.min():.4f}   max={s_np.max():.4f}")
    print(f"    saliency  : mean={sal_np.mean():.2e}   median={np.median(sal_np):.2e}   "
          f"min={sal_np.min():.2e}   max={sal_np.max():.2e}")
    print(f"    threshold : std<{std_dead_thr:.0e} → dead  |  "
          f"saliency≤{sal_thr:.2e} (q{int(saliency_low_quantile*100)}) → low")

    print(f"\n  분류 결과 ({D} dims):")
    print(f"    pure dead  (std↓ & sal↓):                {n_pd:4d}  ({100*n_pd/D:5.1f}%)")
    print(f"    sleeper    (std↓ but sal↑):              {n_sl:4d}  ({100*n_sl/D:5.1f}%)")
    print(f"    unused     (std OK but sal↓):            {n_un:4d}  ({100*n_un/D:5.1f}%)")
    print(f"    used       (std OK & sal OK):            {n_us:4d}  ({100*n_us/D:5.1f}%)")

    # 6) 권장사항
    print(f"\n  ─ 권장사항 ──────────────────────────────────────")
    if n_pd >= D*0.20:
        print(f"  · pure-dead dim 多 ({100*n_pd/D:.0f}%) → VICReg variance penalty 추천 (w_var≈1.0)")
    if n_un >= D*0.15:
        print(f"  · unused dim 多 ({100*n_un/D:.0f}%) → covariance penalty 또는 to_z를 MLP화")
    if n_pd < D*0.05 and n_un < D*0.10:
        print(f"  · latent이 비교적 잘 활용됨. encoder 표현력 / MLP capacity 쪽 의심")
    if n_sl >= D*0.15:
        print(f"  · sleeper dim 多 ({100*n_sl/D:.0f}%) — 작은 변동에 민감, BatchNorm 고려시 주의")

    # 7) Top/Bottom dim 리스트
    print(f"\n  Top-10 used dims (saliency 큰 순):")
    print(f"    {'rank':>4s}  {'dim':>4s}  {'std':>9s}  {'saliency':>11s}")
    top_idx = np.argsort(-sal_np)[:10]
    for r,d in enumerate(top_idx):
        print(f"    {r+1:>4d}  {d:>4d}  {s_np[d]:>9.4f}  {sal_np[d]:>11.3e}")

    if n_pd > 0:
        dead_dims = np.where(pure_dead)[0].tolist()
        print(f"\n  Pure-dead dims ({len(dead_dims)}개):")
        for i in range(0, len(dead_dims), 20):
            print(f"    {dead_dims[i:i+20]}")

    # 8) Type별 z 통계 (multi-type일 때)
    if type_ids is not None and type_names is not None and len(type_names)>1:
        print(f"\n  Per-type latent magnitude:")
        z_np = z_t.cpu().numpy()
        ti_arr = np.asarray([int(type_ids[k]) for k in indices], dtype=np.int64)
        for ti, tname in enumerate(type_names):
            m = (ti_arr == ti)
            if not m.any(): continue
            zk = z_np[m]
            print(f"    {tname:<10s}  n={int(m.sum()):4d}   "
                  f"||z||_mean={np.linalg.norm(zk, axis=1).mean():.3f}   "
                  f"std(z)_mean={zk.std(0).mean():.4f}")

    # 8b) ★ Effective rank + dim correlation 분석
    #     - effective rank: PCA 누적분산 X% 까지 차원 수
    #     - mean |off-diag corr|: dim 간 redundancy 정량
    print(f"\n  Effective rank (PCA cumulative variance):")
    z_np_full = z_t.cpu().numpy()
    z_centered = z_np_full - z_np_full.mean(0, keepdims=True)
    try:
        # SVD로 직접 (sklearn 의존 제거)
        _, S, _ = np.linalg.svd(z_centered, full_matrices=False)
        var_ratio = (S**2) / (S**2).sum()
        cum = np.cumsum(var_ratio)
        for thr in [0.50, 0.90, 0.95, 0.99]:
            d = int(np.argmax(cum >= thr)) + 1 if (cum >= thr).any() else len(cum)
            pct = 100.0 * d / D
            print(f"    @ {int(thr*100):3d}% variance:  rank = {d:4d}  ({pct:5.1f}% of D)")
        # participation ratio (effective rank의 다른 측정)
        pr = (S.sum())**2 / (S**2).sum() if (S**2).sum() > 0 else 0.0
        print(f"    participation ratio:  {pr:.1f}  (= (Σλ)² / Σλ²)")
    except Exception as _e:
        print(f"    (SVD 실패: {_e})")

    # 8c) Correlation matrix off-diagonal stats
    print(f"\n  Dim-dim correlation (Pearson):")
    std_v = z_np_full.std(0) + 1e-9
    z_norm_full = z_centered / std_v
    corr = (z_norm_full.T @ z_norm_full) / max(N - 1, 1)              # (D, D)
    off = corr.copy()
    np.fill_diagonal(off, 0.0)
    abs_off = np.abs(off)
    print(f"    mean |off-diag corr|:  {abs_off.sum() / (D*(D-1)):.4f}")
    print(f"    median |off-diag corr|:{np.median(abs_off[abs_off>0]):.4f}")
    print(f"    max |off-diag corr|:   {abs_off.max():.4f}")
    print(f"    fraction |corr|>0.5:   {((abs_off > 0.5).sum()) / (D*(D-1)):.4f}")
    print(f"    fraction |corr|>0.9:   {((abs_off > 0.9).sum()) / (D*(D-1)):.4f}")

    # 9) Scatter figure
    if save_fig:
        fig, ax = plt.subplots(figsize=(7, 5), facecolor="white")
        ax.scatter(s_np[used_mask],    sal_np[used_mask],
                   c="#5B8DEF", s=20, alpha=0.85, label=f"used ({n_us})")
        ax.scatter(s_np[unused_mask],  sal_np[unused_mask],
                   c="#F4A340", s=20, alpha=0.85, label=f"unused ({n_un})")
        ax.scatter(s_np[sleeper_mask], sal_np[sleeper_mask],
                   c="#6DBF67", s=24, alpha=0.85, marker="s", label=f"sleeper ({n_sl})")
        ax.scatter(s_np[pure_dead],    sal_np[pure_dead],
                   c="#E05C5C", s=28, alpha=0.85, marker="x", label=f"pure dead ({n_pd})")
        ax.axvline(std_dead_thr, color="#E05C5C", ls="--", lw=1, alpha=0.4)
        ax.axhline(sal_thr,      color="#F4A340", ls="--", lw=1, alpha=0.4)
        ax.set_xscale("log"); ax.set_yscale("log")
        ax.set_xlabel("std(z_d)  — per-dim batch std")
        ax.set_ylabel("|∂L_sp / ∂z_d|  — saliency to S-param")
        ax.set_title("Latent dim health: std vs S-param saliency",
                     fontweight="normal")
        ax.grid(True, which="both", alpha=0.2)
        ax.legend(loc="lower right", fontsize=9)
        plt.tight_layout()

    return {
        "std": s_np, "saliency": sal_np,
        "pure_dead": pure_dead, "sleeper": sleeper_mask,
        "unused": unused_mask,  "used": used_mask,
        "n_pure_dead": n_pd, "n_sleeper": n_sl,
        "n_unused": n_un,    "n_used": n_us,
    }


