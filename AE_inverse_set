class SinPosEnc(nn.Module):
    def __init__(self, d_model, max_len=512, dropout=0.1):
        super().__init__()
        self.drop = nn.Dropout(dropout)

        pe = torch.zeros(max_len, d_model)
        pos = torch.arange(max_len).unsqueeze(1).float()
        div = torch.exp(
            torch.arange(0, d_model, 2).float()
            * (-math.log(10000.0) / d_model)
        )

        pe[:, 0::2] = torch.sin(pos * div)
        pe[:, 1::2] = torch.cos(pos * div)

        self.register_buffer("pe", pe.unsqueeze(0))

    def forward(self, x):
        return self.drop(x + self.pe[:, :x.size(1)])


class BodySetAE(nn.Module):
    """
    Order-invariant body-set AE.

    Encoder:
      token body encoder 공유
      body embeddings -> set transformer without body positional encoding
      masked mean pooling -> z

    Decoder:
      z -> unordered body slots
      각 slot이 body token sequence를 직접 출력
    """

    def __init__(self, cfg, max_bodies, max_body_len):
        super().__init__()

        self.cfg = cfg
        self.max_bodies = int(max_bodies)
        self.max_body_len = int(max_body_len)
        self.d_model = int(cfg.d_model)
        self.latent = int(cfg.latent)

        self.cmd_emb = nn.Embedding(
            N_CMD_WITH_PAD,
            cfg.d_model,
            padding_idx=PAD_CMD_CLASS,
        )

        self.param_embs = nn.ModuleList([
            nn.Embedding(
                N_QUANT + 1,
                cfg.d_param,
                padding_idx=PAD_PARAM_INDEX,
            )
            for _ in range(N_ARGS)
        ])

        if cfg.n_freq_bands > 0:
            freqs = (2.0 ** torch.arange(cfg.n_freq_bands).float()) * math.pi
            self.register_buffer("fourier_freqs", freqs)
            param_in = N_ARGS * cfg.d_param + N_ARGS * 2 * cfg.n_freq_bands
        else:
            self.fourier_freqs = None
            param_in = N_ARGS * cfg.d_param

        self.param_proj = nn.Linear(param_in, cfg.d_model)
        self.emb_norm = nn.LayerNorm(cfg.d_model)
        self.body_pos_enc = SinPosEnc(cfg.d_model, max_len=max_body_len + 8, dropout=cfg.dropout)

        body_layer = nn.TransformerEncoderLayer(
            d_model=cfg.d_model,
            nhead=cfg.nhead,
            dim_feedforward=cfg.d_ff,
            dropout=cfg.dropout,
            batch_first=True,
            norm_first=True,
        )
        self.body_encoder = nn.TransformerEncoder(
            body_layer,
            num_layers=cfg.n_body_enc_layers,
            norm=nn.LayerNorm(cfg.d_model),
        )

        set_layer = nn.TransformerEncoderLayer(
            d_model=cfg.d_model,
            nhead=cfg.nhead,
            dim_feedforward=cfg.d_ff,
            dropout=cfg.dropout,
            batch_first=True,
            norm_first=True,
        )
        self.set_encoder = nn.TransformerEncoder(
            set_layer,
            num_layers=cfg.n_set_layers,
            norm=nn.LayerNorm(cfg.d_model),
        )

        self.to_z = nn.Sequential(
            nn.Linear(cfg.d_model, cfg.latent),
            nn.LayerNorm(cfg.latent),
        )

        self.z_to_mem = nn.Linear(cfg.latent, cfg.d_model)
        self.z_to_slot_bias = nn.Linear(cfg.latent, cfg.d_model)

        self.slot_queries = nn.Parameter(torch.randn(max_bodies, cfg.d_model) * 0.02)

        slot_layer = nn.TransformerDecoderLayer(
            d_model=cfg.d_model,
            nhead=cfg.nhead,
            dim_feedforward=cfg.d_ff,
            dropout=cfg.dropout,
            batch_first=True,
            norm_first=True,
        )
        self.slot_decoder = nn.TransformerDecoder(
            slot_layer,
            num_layers=cfg.n_slot_dec_layers,
            norm=nn.LayerNorm(cfg.d_model),
        )

        self.presence_head = nn.Linear(cfg.d_model, 1)

        self.body_token_pos = nn.Parameter(torch.randn(max_body_len, cfg.d_model) * 0.02)
        self.token_dec_norm = nn.LayerNorm(cfg.d_model)

        self.cmd_out = nn.Linear(cfg.d_model, N_CMD_WITH_PAD)
        self.param_out = nn.Linear(cfg.d_model, N_ARGS * N_QUANT)

        self._init_weights()

    def _init_weights(self):
        for n, p in self.named_parameters():
            if p.dim() > 1 and "body_token_pos" not in n and "slot_queries" not in n:
                nn.init.xavier_uniform_(p)

    def _embed_body_tokens(self, x):
        """
        x: [B2, L, 17]
        """
        cmd = x[:, :, 0].long()
        params = x[:, :, 1:].long()

        tok_pad = cmd < 0

        cmd_idx = cmd.clone()
        cmd_idx[tok_pad] = PAD_CMD_CLASS
        cmd_idx = cmd_idx.clamp(0, PAD_CMD_CLASS)
        cmd_e = self.cmd_emb(cmd_idx)

        prm_idx = params.clone()
        prm_idx[prm_idx < 0] = PAD_PARAM_INDEX
        prm_idx = prm_idx.clamp(0, PAD_PARAM_INDEX)

        slot_embs = [
            self.param_embs[s](prm_idx[:, :, s])
            for s in range(N_ARGS)
        ]
        prm_cat = torch.cat(slot_embs, dim=-1)

        if self.fourier_freqs is not None:
            p_int = prm_idx.clone()
            pad_p = params < 0
            p_int[pad_p] = 0
            p_f = p_int.float() / float(QMAX)

            ang = p_f.unsqueeze(-1) * self.fourier_freqs.view(1, 1, 1, -1)
            sin_p = torch.sin(ang)
            cos_p = torch.cos(ang)

            mask = 1.0 - pad_p.unsqueeze(-1).float()
            fourier = torch.cat([sin_p * mask, cos_p * mask], dim=-1)
            fourier = fourier.reshape(x.size(0), x.size(1), N_ARGS * 2 * self.cfg.n_freq_bands)

            prm_cat = torch.cat([prm_cat, fourier], dim=-1)

        prm_e = self.param_proj(prm_cat)

        emb = self.emb_norm(cmd_e + prm_e)
        emb = emb * (~tok_pad).unsqueeze(-1)

        return emb, tok_pad

    def encode(self, bodies, body_mask):
        """
        bodies: [B, M, L, 17]
        body_mask: [B, M]
        """
        B, M, L, _ = bodies.shape

        flat = bodies.reshape(B * M, L, 17)
        emb, tok_pad = self._embed_body_tokens(flat)
        emb = self.body_pos_enc(emb)

        h = self.body_encoder(
            emb,
            src_key_padding_mask=tok_pad,
        )

        valid_tok = (~tok_pad).float().unsqueeze(-1)
        body_emb = (h * valid_tok).sum(dim=1) / valid_tok.sum(dim=1).clamp(min=1.0)
        body_emb = body_emb.view(B, M, self.d_model)

        # body order를 알려주는 positional embedding을 넣지 않는다.
        set_h = self.set_encoder(
            body_emb,
            src_key_padding_mask=~body_mask,
        )

        valid_body = body_mask.float().unsqueeze(-1)
        pooled = (set_h * valid_body).sum(dim=1) / valid_body.sum(dim=1).clamp(min=1.0)

        z = self.to_z(pooled)
        return z

    def decode_from_z(self, z):
        B = z.size(0)
        M = self.max_bodies
        L = self.max_body_len

        mem = self.z_to_mem(z).unsqueeze(1)

        q = self.slot_queries.unsqueeze(0).expand(B, -1, -1)
        q = q + self.z_to_slot_bias(z).unsqueeze(1)

        slot_h = self.slot_decoder(tgt=q, memory=mem)

        presence_logits = self.presence_head(slot_h).squeeze(-1)

        tok_h = slot_h.unsqueeze(2) + self.body_token_pos.view(1, 1, L, self.d_model)
        tok_h = self.token_dec_norm(tok_h)

        cmd_logits = self.cmd_out(tok_h)
        prm_logits = self.param_out(tok_h).view(B, M, L, N_ARGS, N_QUANT)

        return {
            "cmd_logits": cmd_logits,
            "prm_logits": prm_logits,
            "presence_logits": presence_logits,
        }

    def forward(self, bodies, body_mask):
        z = self.encode(bodies, body_mask)
        dec = self.decode_from_z(z)
        return dec, z

    @torch.no_grad()
    def generate_bodies(self, z, presence_thr=0.5):
        dec = self.decode_from_z(z)
        cmd = torch.argmax(dec["cmd_logits"], dim=-1)
        prm = torch.argmax(dec["prm_logits"], dim=-1)
        pres = torch.sigmoid(dec["presence_logits"])

        B, M, L = cmd.shape
        out = []

        for b in range(B):
            bodies = []
            for m in range(M):
                rows = []
                for l in range(L):
                    c = int(cmd[b, m, l].item())
                    if c == PAD_CMD_CLASS:
                        continue

                    row = np.full((17,), PAD_V, dtype=np.int32)
                    row[0] = c

                    npar = VALID_PAR.get(c, 0)
                    if npar > 0:
                        vals = prm[b, m, l, :npar].detach().cpu().numpy().astype(np.int32)
                        row[1:1 + npar] = vals

                    rows.append(row)

                    if c == EXT:
                        break

                if rows and float(pres[b, m].item()) >= presence_thr:
                    bodies.append(np.stack(rows, axis=0).astype(np.int32))
            out.append((bodies, pres[b].detach().cpu().numpy()))
        return out


class SparamCommonResidualMLP(nn.Module):
    def __init__(
        self,
        latent_dim,
        n_freq,
        common_curve,
        hidden_mult=2.0,
        dropout=0.3,
        residual_scale=1.0,
        zero_init_residual=True,
    ):
        super().__init__()

        self.n_freq = int(n_freq)
        self.residual_scale = float(residual_scale)

        common_curve = torch.as_tensor(common_curve, dtype=torch.float32)
        if common_curve.shape != (self.n_freq, 3):
            raise ValueError(f"common_curve shape mismatch: {common_curve.shape}")

        self.register_buffer("common_curve", common_curve)

        h1 = max(int(latent_dim * hidden_mult), 128)
        h2 = max(int(latent_dim * hidden_mult), 128)

        self.net = nn.Sequential(
            nn.Linear(latent_dim, h1),
            nn.LayerNorm(h1),
            nn.GELU(),
            nn.Dropout(dropout),

            nn.Linear(h1, h2),
            nn.LayerNorm(h2),
            nn.GELU(),
            nn.Dropout(dropout),

            nn.Linear(h2, self.n_freq * 3),
        )

        if zero_init_residual:
            last = self.net[-1]
            nn.init.zeros_(last.weight)
            nn.init.zeros_(last.bias)

    def forward(self, z, return_parts=False):
        residual_raw = self.net(z).view(-1, self.n_freq, 3)
        residual = self.residual_scale * residual_raw
        pred = self.common_curve.unsqueeze(0) + residual

        if return_parts:
            return pred, residual
        return pred


# ══════════════════════════════════════════════════════════════
# Body-set matching loss
# ══════════════════════════════════════════════════════════════
def _body_pair_cost_matrix(cmd_logits_i, prm_logits_i, true_bodies_i, true_mask_i, cfg):
    """
    cmd_logits_i: [M, L, N_CMD_WITH_PAD]
    prm_logits_i: [M, L, N_ARGS, N_QUANT]
    true_bodies_i: [M, L, 17]
    true_mask_i: [M]
    """
    device = cmd_logits_i.device
    M, L, _ = cmd_logits_i.shape

    true_ids = torch.nonzero(true_mask_i, as_tuple=False).view(-1)
    Nt = int(true_ids.numel())

    if Nt == 0:
        return None, true_ids

    costs = []

    for p in range(M):
        row_costs = []
        for tj in true_ids:
            tb = true_bodies_i[tj]  # [L,17]

            cmd_t = tb[:, 0].long()
            cmd_target = cmd_t.clone()
            cmd_target[cmd_target < 0] = PAD_CMD_CLASS
            cmd_target = cmd_target.clamp(0, PAD_CMD_CLASS)

            cmd_loss = F.cross_entropy(
                cmd_logits_i[p],
                cmd_target,
                reduction="mean",
            )

            prm_t = tb[:, 1:].long()
            valid_prm = prm_t >= 0

            if bool(valid_prm.any()):
                prm_loss_all = F.cross_entropy(
                    prm_logits_i[p].reshape(L * N_ARGS, N_QUANT),
                    prm_t.clamp(0, QMAX).reshape(L * N_ARGS),
                    reduction="none",
                ).reshape(L, N_ARGS)

                prm_loss = (prm_loss_all * valid_prm.float()).sum() / valid_prm.float().sum().clamp(min=1.0)
            else:
                prm_loss = torch.zeros((), device=device)

            cost = cfg.body_cmd_weight * cmd_loss + cfg.body_param_weight * prm_loss
            row_costs.append(cost)

        costs.append(torch.stack(row_costs))

    return torch.stack(costs, dim=0), true_ids


def _hungarian_assign(cost_np):
    """
    cost shape [M, Nt]
    returns pred_indices, true_col_indices
    """
    if HAS_SCIPY:
        r, c = linear_sum_assignment(cost_np)
        return list(r), list(c)

    # fallback greedy
    M, Nt = cost_np.shape
    used_p = set()
    pairs_p = []
    pairs_t = []

    flat = []
    for i in range(M):
        for j in range(Nt):
            flat.append((float(cost_np[i, j]), i, j))
    flat.sort(key=lambda x: x[0])

    used_t = set()
    for _, i, j in flat:
        if i in used_p or j in used_t:
            continue
        used_p.add(i)
        used_t.add(j)
        pairs_p.append(i)
        pairs_t.append(j)
        if len(pairs_t) >= Nt:
            break

    return pairs_p, pairs_t


def body_set_reconstruction_loss(dec, true_bodies, true_mask, cfg):
    cmd_logits = dec["cmd_logits"]
    prm_logits = dec["prm_logits"]
    presence_logits = dec["presence_logits"]

    B, M, L, _ = cmd_logits.shape

    total_recon = cmd_logits.new_zeros(())
    total_presence = cmd_logits.new_zeros(())
    total_match_cost = 0.0
    total_true = 0

    for i in range(B):
        cost, true_ids = _body_pair_cost_matrix(
            cmd_logits[i],
            prm_logits[i],
            true_bodies[i],
            true_mask[i],
            cfg,
        )

        presence_target = torch.zeros((M,), dtype=torch.float32, device=cmd_logits.device)

        if cost is not None:
            cost_np = cost.detach().cpu().numpy()
            pred_idx, true_col_idx = _hungarian_assign(cost_np)

            matched_costs = []
            for pp, tc in zip(pred_idx, true_col_idx):
                matched_costs.append(cost[pp, tc])
                presence_target[pp] = 1.0

            if matched_costs:
                recon_i = torch.stack(matched_costs).mean()
            else:
                recon_i = cmd_logits.new_zeros(())
        else:
            recon_i = cmd_logits.new_zeros(())

        presence_i = F.binary_cross_entropy_with_logits(
            presence_logits[i],
            presence_target,
            reduction="mean",
        )

        total_recon = total_recon + recon_i
        total_presence = total_presence + presence_i

        total_match_cost += float(recon_i.detach().item())
        total_true += int(true_mask[i].sum().item())

    recon = total_recon / B
    presence = total_presence / B
    total = recon + cfg.body_presence_weight * presence

    comp = {
        "body_recon": float(recon.detach().item()),
        "presence": float(presence.detach().item()),
        "body_total": float(total.detach().item()),
        "avg_true_bodies": float(total_true / max(B, 1)),
    }

    return total, comp


def sparam_full_interp_loss(pred_sel_db, true_sel_db, true_full_db, interp_w, cfg):
    pred_full_db = interpolate_selected_to_full_torch(pred_sel_db, interp_w)

    full_loss = ((pred_full_db - true_full_db) / cfg.db_loss_scale).pow(2).mean()
    full_rmse_db = torch.sqrt(((pred_full_db - true_full_db) ** 2).mean())
    sel_rmse_db = torch.sqrt(((pred_sel_db - true_sel_db) ** 2).mean())

    comp = {
        "sp_loss": float(full_loss.detach().item()),
        "rmse_full": float(full_rmse_db.detach().item()),
        "rmse_sel": float(sel_rmse_db.detach().item()),
    }

    return full_loss, comp


def vicreg_z_loss(z, var_target=1.0, eps=1e-4):
    B, D = z.shape
    if B <= 1:
        zero = z.new_zeros(())
        return zero, zero

    zc = z - z.mean(dim=0, keepdim=True)
    std = torch.sqrt(zc.var(dim=0, unbiased=False) + eps)
    var_loss = F.relu(var_target - std).mean()

    cov = (zc.T @ zc) / max(B - 1, 1)
    off = cov - torch.diag(torch.diag(cov))
    cov_loss = (off ** 2).sum() / D

    return var_loss, cov_loss


# ══════════════════════════════════════════════════════════════
# Epoch
# ══════════════════════════════════════════════════════════════
def run_epoch(ae, mlp, loader, optimizer, device, cfg, interp_w, train_mode=True):
    if train_mode:
        ae.train()
        mlp.train()
    else:
        ae.eval()
        mlp.eval()

    acc = {
        "total": 0.0,
        "body": 0.0,
        "presence": 0.0,
        "sp": 0.0,
        "rmse_full": 0.0,
        "rmse_sel": 0.0,
        "var": 0.0,
        "cov": 0.0,
        "z_std": 0.0,
        "res_abs": 0.0,
        "avg_true_bodies": 0.0,
    }

    n = 0

    for batch in loader:
        bodies, body_mask, y_sel, y_full, _tid = batch

        bodies = bodies.to(device)
        body_mask = body_mask.to(device)
        y_sel = y_sel.to(device)
        y_full = y_full.to(device)

        if train_mode:
            optimizer.zero_grad(set_to_none=True)

        with torch.set_grad_enabled(train_mode):
            dec, z = ae(bodies, body_mask)

            body_loss, body_comp = body_set_reconstruction_loss(
                dec,
                bodies,
                body_mask,
                cfg,
            )

            pred_sel, residual = mlp(z, return_parts=True)

            sp_loss, sp_comp = sparam_full_interp_loss(
                pred_sel,
                y_sel,
                y_full,
                interp_w,
                cfg,
            )

            total = cfg.w_ae * body_loss + cfg.w_sparam * sp_loss

            if cfg.use_vicreg and z.size(0) > 1:
                var_loss, cov_loss = vicreg_z_loss(
                    z,
                    var_target=cfg.vicreg_var_target,
                )
                total = total + cfg.w_var * var_loss + cfg.w_cov * cov_loss
            else:
                var_loss = z.new_zeros(())
                cov_loss = z.new_zeros(())

            if train_mode:
                total.backward()
                nn.utils.clip_grad_norm_(
                    list(ae.parameters()) + list(mlp.parameters()),
                    cfg.grad_clip,
                )
                optimizer.step()

        with torch.no_grad():
            acc["total"] += float(total.item())
            acc["body"] += body_comp["body_recon"]
            acc["presence"] += body_comp["presence"]
            acc["avg_true_bodies"] += body_comp["avg_true_bodies"]
            acc["sp"] += sp_comp["sp_loss"]
            acc["rmse_full"] += sp_comp["rmse_full"]
            acc["rmse_sel"] += sp_comp["rmse_sel"]
            acc["var"] += float(var_loss.item())
            acc["cov"] += float(cov_loss.item())
            acc["z_std"] += float(z.std(dim=0).mean().item()) if z.size(0) > 1 else 0.0
            acc["res_abs"] += float(residual.abs().mean().item())

        n += 1

    return {k: v / max(n, 1) for k, v in acc.items()}


